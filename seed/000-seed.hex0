75 ED                       ; jne .next (rel8 = 0x3C1 - 0x3D4)
F3 A6                       ; repe cmpsb                    ; compare ecx bytes; with ecx = 0 it does nothing and the flags still say equal
75 E9                       ; jne .next (rel8 = 0x3C1 - 0x3D8)
89 1D 18 90 05 08           ; mov [LAST_FOUND], ebx         ; the header
89 FB                       ; mov ebx, edi                  ; edi has passed the name: it is the xt
;; .done:
89 D8                       ; mov eax, ebx                  ; the xt, or 0
31 D2                       ; xor edx, edx
5E                          ; pop esi
83 C6 08                    ; add esi, 8                    ; two cells in, one out
C2 04 00                    ; ret 4

