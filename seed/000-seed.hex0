83 FB 20                    ; cmp ebx, 32
77 3B                       ; ja .store (rel8 = 0x392 - 0x357) ; unsigned: a token byte
85 C9                       ; test ecx, ecx                 ; whitespace or the end: is there a token?
75 04                       ; jnz .end (rel8 = 0x35F - 0x35B) ; yes, and this byte ends it
85 DB                       ; test ebx, ebx
75 EC                       ; jnz .next (rel8 = 0x34B - 0x35F) ; leading whitespace: skip it
