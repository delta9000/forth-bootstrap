74 D7                       ; je .restart (rel8 = 0x349 - 0x372)
85 DB                       ; test ebx, ebx                 ; the end of the input
74 D3                       ; je .restart (rel8 = 0x349 - 0x376) ; key gives 0 again, so u = 0
E8 11 FE FF FF              ; call getc (rel32 = 0x18C - 0x37B)
EB F0                       ; jmp .comment (rel8 = 0x36D - 0x37D)
