;; 000-seed.hex0 -- the Forth seed: an x86-64 Linux ELF, 930 bytes.
;;
;; A hex0 file is pairs of hex digits; everything from ';' or '#' to the end
;; of a line is a comment.  stage0-posix's hex0-seed turns this file into
;; ./seed-forth (seed/build.sh).
;;
;; How to read it.  Every line with bytes holds exactly one thing: an ELF
;; field, a dictionary-header field, or one machine instruction.  The first
;; comment on the line is that field or that instruction in Intel syntax
;; (NASM spelling: "byte [", "qword ["); a second ';' starts free prose.
;; tests/seed/asm-check.py hands the first comments to GNU as and to llvm-mc
;; and requires both to write the bytes on the left, so the comments cannot
;; drift from the hex.  The notes in parentheses are checked as well:
;;   (rel8 = 0xA - 0xB)   a branch: A is the target's file offset, B the
;;                        offset just past the instruction, A - B the
;;                        displacement in its last byte (rel32: last four)
;;   (NAME header)        the operand is the address of NAME's header
;; Headings give file offsets; the load address adds 0x400000 to them.
;;
;; What it is.  A Forth with 21 words.  It reads whitespace-separated tokens
;; from standard input.  A token that names a word is executed, or, inside a
;; definition, compiled as a CALL to it.  Any other token must be an
;; unsigned decimal number, which is pushed or compiled as a literal.
;; Anything else is fatal: the token, "?" and a newline go to standard
;; output and the seed exits with status 2.  End of input exits with 0.
;; The only system calls of its own are read (0), write (1) and exit (60),
;; made with the syscall instruction.
;;
;; Memory map:
;;   0x400000 = this file: ELF headers, code, the 21 dictionary headers
;;   0x401000 = initial HERE; new definitions grow up from here
;;   0x411000 = data-stack base; grows down, first push lands at 0x410FF8
;;   0x413000 = sysvar page: four cells the library shares, then the token buffer
;;   0x414000 = free and zero up to 0x1400000; never touched by the seed
;; The return stack is the process stack the kernel hands over in rsp.
;;
;; Registers, the same in every routine:
;;   rdi      = top of the data stack (TOS)
;;   rbp      = data-stack pointer: [rbp] is the second item, [rbp+8] the third
;;   rsp      = return stack; a word is entered by call and left by ret
;;   rbx      = the sysvar page, 0x413000, set once and never changed
;; Everything else is scratch.  Across a call to key, token, find or a word
;; taken from the dictionary nothing but these four can be relied on: the
;; library later replaces key and find with code of its own.
;;
;; The sysvar page, as offsets from rbx (each of the first four is a cell):
;;   STATE +0, LATEST +8, HERE +16, LAST_FOUND +24, TIB +64
;; STATE is 0 while interpreting and 1 while compiling.  LATEST is the newest
;; dictionary header, HERE the first free dictionary byte, LAST_FOUND the
;; header find matched last.  They are read from memory every time, because
;; the library changes them.  TIB is the token buffer: 256 bytes of token and
;; 2 for the "?" and newline of the fatal message, so it ends at +322.
;;
;; A dictionary header is: link (8 bytes, the previous header, 0 at the
;; end), flags (1 byte, 1 = IMMEDIATE), nlen (1 byte), the name (nlen
;; bytes), and then at once the word's machine code.  The address of that
;; code is the word's execution token, xt = header + 10 + nlen.

;; ===== ELF header (64 bytes) =====
7F 45 4C 46                ; e_ident[0..3] = magic "\x7fELF"
02                         ; e_ident[EI_CLASS] = ELFCLASS64
01                         ; e_ident[EI_DATA] = ELFDATA2LSB (little-endian)
01                         ; e_ident[EI_VERSION] = EV_CURRENT
00                         ; e_ident[EI_OSABI] = ELFOSABI_NONE (System V)
00                         ; e_ident[EI_ABIVERSION] = 0
00 00 00 00 00 00 00       ; e_ident padding (7 zero bytes)
02 00                      ; e_type = ET_EXEC
3E 00                      ; e_machine = EM_X86_64
01 00 00 00                ; e_version = EV_CURRENT
F7 00 40 00 00 00 00 00    ; e_entry = 0x4000F7 (_start)
40 00 00 00 00 00 00 00    ; e_phoff = 64
00 00 00 00 00 00 00 00    ; e_shoff = 0 (no section headers)
00 00 00 00                ; e_flags = 0
40 00                      ; e_ehsize = 64
38 00                      ; e_phentsize = 56
01 00                      ; e_phnum = 1
00 00                      ; e_shentsize = 0
00 00                      ; e_shnum = 0
00 00                      ; e_shstrndx = 0

;; ===== Program header (56 bytes) =====
;; One segment, readable, writable and executable: the dictionary is code
;; written at run time.  It is 16 MiB long; the kernel fills everything past
;; the file with zeros, and both the seed and the library rely on that.
01 00 00 00                ; p_type = PT_LOAD
07 00 00 00                ; p_flags = R|W|X
00 00 00 00 00 00 00 00    ; p_offset = 0
00 00 40 00 00 00 00 00    ; p_vaddr = 0x400000
00 00 40 00 00 00 00 00    ; p_paddr = 0x400000 (ignored on Linux)
A2 03 00 00 00 00 00 00    ; p_filesz = 930 (the whole file)
00 00 00 01 00 00 00 00    ; p_memsz = 0x1000000 (16 MiB of address space)
00 10 00 00 00 00 00 00    ; p_align = 0x1000

;; ===== token ( -- c-addr u ) =====
;; Reads the next token into TIB and pushes TIB's address and the token's
;; length; length 0 means end of input.  Bytes 0x01 to 0x20 are whitespace
;; and separate tokens; a byte 0 is end of input (that is what key returns
;; there).  The whitespace byte that ends a token is consumed and nothing
;; after it.  A token that is the single character \ starts a comment that
;; runs to the end of the line.  A token of 256 bytes is fatal.
;;
;; While it reads, the data stack holds ( tib p ): TIB's address, and in
;; rdi the place for the next byte.  Being ordinary stack items, both
;; survive the calls to key, whatever key is by then.
;; --- token @ 0x78 --- header
00 00 00 00 00 00 00 00    ; link  = 0 (end of chain)
00                         ; flags = 0
05                         ; nlen  = 5
74 6F 6B 65 6E             ; name  = "token"
;; ----- token @ 0x87
48 8D 43 40                ; lea rax, [rbx+TIB]             ; rax = the buffer's address
E8 19 01 00 00             ; call push_rax (rel32 = 0x1A9 - 0x90) ; ( tib )
E8 11 01 00 00             ; call dup (rel32 = 0x1A6 - 0x95) ; ( tib p ), p = tib: nothing stored yet
;; .next:
E8 20 02 00 00             ; call getc (rel32 = 0x2BA - 0x9A) ; al = next input byte, 0 at end of input
3C 20                      ; cmp al, 0x20
76 09                      ; jbe .delim (rel8 = 0xA7 - 0x9E) ; whitespace or end of input (unsigned: 0x80.. are token bytes)
AA                         ; stosb                          ; [p] = al, p = p + 1
40 80 FF 40                ; cmp dil, 0x40                  ; 0x40 is the low byte of TIB + 256: is this the 256th byte?
75 F0                      ; jne .next (rel8 = 0x95 - 0xA5)
EB 32                      ; jmp fatal (rel8 = 0xD9 - 0xA7) ; yes: too long; rdi = end of the token, as fatal expects
;; .delim:
84 C0                      ; test al, al
74 06                      ; jz .end (rel8 = 0xB1 - 0xAB)   ; end of input ends the token, even an empty one
48 3B 7D 00                ; cmp rdi, [rbp]                 ; whitespace: has anything been stored?
74 E4                      ; je .next (rel8 = 0x95 - 0xB1)  ; no: it was leading whitespace, skip it
;; .end:
48 2B 7D 00                ; sub rdi, [rbp]                 ; ( tib u ), u = p - tib
83 FF 01                   ; cmp edi, 1                     ; a one-byte token ...
75 19                      ; jne .done (rel8 = 0xD3 - 0xBA)
80 7B 40 5C                ; cmp byte [rbx+TIB], 0x5C       ; ... that is a backslash?
75 13                      ; jne .done (rel8 = 0xD3 - 0xC0)
;; .comment:
;; al is the last byte read, at first the one that ended the \ token.
3C 0A                      ; cmp al, 10                     ; a newline ends the comment
74 09                      ; je .again (rel8 = 0xCD - 0xC4)
E8 F1 01 00 00             ; call getc (rel32 = 0x2BA - 0xC9)
84 C0                      ; test al, al                    ; and so does end of input
75 F3                      ; jnz .comment (rel8 = 0xC0 - 0xCD)
;; .again:
48 8B 7D 00                ; mov rdi, [rbp]                 ; ( tib p ) with p = tib again
EB C2                      ; jmp .next (rel8 = 0x95 - 0xD3) ; read the token after the comment
;; .done:
C3                         ; ret

;; ===== The fatal error, and exit =====
;; bad is where the number parser lands on a byte that is not a digit: rsi
;; is just past that byte and rcx counts it and the bytes after it, so
;; rsi + rcx - 1 is the end of the token.
;; ----- bad @ 0xD4
48 8D 7C 0E FF             ; lea rdi, [rsi+rcx-1]           ; rdi = end of the token
;; fatal: rdi = the address just past a token in TIB.  Appends "?" and a
;; newline, writes it all to standard output with one write, exits with 2.
;; ----- fatal @ 0xD9
66 C7 07 3F 0A             ; mov word [rdi], 0x0A3F         ; "?" (0x3F) then newline (0x0A), little-endian
48 8D 73 40                ; lea rsi, [rbx+TIB]             ; buffer = TIB
48 29 F7                   ; sub rdi, rsi                   ; rdi = the token's length
8D 57 02                   ; lea edx, [rdi+2]               ; count = length + 2
6A 01                      ; push 1
5F                         ; pop rdi                        ; fd = 1, standard output
89 F8                      ; mov eax, edi                   ; rax = 1 = write
0F 05                      ; syscall
6A 02                      ; push 2
5F                         ; pop rdi                        ; exit status 2
;; exit: rdi = the status.
;; ----- exit @ 0xF2
6A 3C                      ; push 60
58                         ; pop rax                        ; rax = 60 = exit
0F 05                      ; syscall                        ; does not return

;; ===== Entry, and the outer loop =====
;; ----- _start @ 0xF7
BB 00 30 41 00             ; mov ebx, 0x413000              ; rbx = the sysvar page, for good
BD 00 10 41 00             ; mov ebp, 0x411000              ; the data stack is empty
48 C7 43 08 74 03 40 00    ; mov qword [rbx+LATEST], 0x400374 (syscall6 header) ; the last header in this file
48 C7 43 10 00 10 40 00    ; mov qword [rbx+HERE], 0x401000 ; STATE and LAST_FOUND are 0 already
;; outer: one token per turn.  Nothing of the loop's stays on the data
;; stack while a word runs, and nothing is kept in a register or on the
;; return stack across the call to a word.
;; ----- outer @ 0x111
E8 71 FF FF FF             ; call token (rel32 = 0x87 - 0x116) ; ( tib u )
48 85 FF                   ; test rdi, rdi
74 D7                      ; jz exit (rel8 = 0xF2 - 0x11B)  ; u = 0 is end of input: exit, and rdi = 0 is the status
57                         ; push rdi                       ; keep u for the number parser; find consumes it
E8 C7 01 00 00             ; call find (rel32 = 0x2E8 - 0x121) ; ( xt ), or ( 0 ) if there is no such word
59                         ; pop rcx                        ; rcx = u
E8 98 01 00 00             ; call pop_rax (rel32 = 0x2BF - 0x127) ; rax = xt; the data stack is as it was before the token
48 85 C0                   ; test rax, rax
75 3B                      ; jnz .found (rel8 = 0x167 - 0x12C)
;; Not a word, so it has to be a number: u decimal digits in TIB.  rdx
;; gathers the value, wrapping past 64 bits.  rax is 0 here and lodsb
;; changes only its low byte, so rax is always the digit just read.
48 8D 73 40                ; lea rsi, [rbx+TIB]
31 D2                      ; xor edx, edx                   ; value = 0
;; .digit:
AC                         ; lodsb                          ; al = next byte of the token
2C 30                      ; sub al, 0x30                   ; "0" to "9" become 0 to 9
3C 09                      ; cmp al, 9
77 9B                      ; ja bad (rel8 = 0xD4 - 0x139)   ; anything else (unsigned compare) is fatal
48 6B D2 0A                ; imul rdx, rdx, 10
48 01 C2                   ; add rdx, rax                   ; value = value * 10 + digit
FF C9                      ; dec ecx
75 EE                      ; jnz .digit (rel8 = 0x132 - 0x144)
48 83 3B 00                ; cmp qword [rbx+STATE], 0
75 09                      ; jne .literal (rel8 = 0x153 - 0x14A)
48 92                      ; xchg rax, rdx                  ; interpreting: rax = value
E8 58 00 00 00             ; call push_rax (rel32 = 0x1A9 - 0x151) ; ( value )
EB BE                      ; jmp outer (rel8 = 0x111 - 0x153)
;; .literal:
;; Compiling: lay "call lit" and then the value itself, 13 bytes in all.
52                         ; push rdx                       ; save the value
B8 93 01 40 00             ; mov eax, 0x400193              ; rax = the address of lit
E8 1F 00 00 00             ; call compile_call (rel32 = 0x17D - 0x15E) ; lays the call; rdx = HERE
8F 02                      ; pop qword [rdx]                ; the value's 8 bytes, at HERE
48 83 43 10 08             ; add qword [rbx+HERE], 8
EB AA                      ; jmp outer (rel8 = 0x111 - 0x167)
;; .found:
;; rax = xt.  Execute the word if it is IMMEDIATE or STATE is 0; otherwise
;; compile a call to it.  The flags byte is 0 or 1 and so is STATE, hence
;; "execute" is exactly flags >= STATE.
48 8B 53 18                ; mov rdx, [rbx+LAST_FOUND]      ; the header find matched
8A 4A 08                   ; mov cl, [rdx+8]                ; its flags byte
3A 0B                      ; cmp cl, [rbx+STATE]            ; against the low byte of STATE
73 07                      ; jae .execute (rel8 = 0x179 - 0x172)
E8 06 00 00 00             ; call compile_call (rel32 = 0x17D - 0x177)
EB 98                      ; jmp outer (rel8 = 0x111 - 0x179)
;; .execute:
FF D0                      ; call rax                       ; the word's ret comes back here
EB 94                      ; jmp outer (rel8 = 0x111 - 0x17D)

;; compile_call: rax = a target address.  Lays E8 and a rel32 at HERE, a
;; near CALL to the target, and moves HERE past its 5 bytes.  Leaves the
;; new HERE in rdx.  The data stack is not touched.
;; ----- compile_call @ 0x17D
48 8B 53 10                ; mov rdx, [rbx+HERE]
C6 02 E8                   ; mov byte [rdx], 0xE8           ; the CALL opcode
48 83 C2 05                ; add rdx, 5                     ; rdx = the address just after the call
48 29 D0                   ; sub rax, rdx                   ; rel32 = target - that address
89 42 FC                   ; mov [rdx-4], eax               ; into the call's last four bytes
48 89 53 10                ; mov [rbx+HERE], rdx
C3                         ; ret

;; lit: what a compiled number calls.  The 8 bytes after the call are the
;; value, so the return address points at it: load it, step the return
;; address over it, push it.  Not a dictionary word.
;; ----- lit @ 0x193
5E                         ; pop rsi                        ; rsi = return address = the value's address
48 AD                      ; lodsq                          ; rax = the value, rsi = rsi + 8
56                         ; push rsi                       ; return to the code after the value
EB 10                      ; jmp push_rax (rel8 = 0x1A9 - 0x199) ; ( value ), and return there

;; ===== dup ( a -- a a ) =====
;; Its tail, push_rax, pushes rax on the data stack: the old TOS goes to
;; memory and rax becomes TOS.  Every routine that pushes ends there.  The
;; xchg is a two-byte "mov rdi, rax"; nobody uses what it leaves in rax.
;; --- dup @ 0x199 --- header
78 00 40 00 00 00 00 00    ; link  = 0x400078 (token)
00                         ; flags = 0
03                         ; nlen  = 3
64 75 70                   ; name  = "dup"
;; ----- dup @ 0x1A6
48 89 F8                   ; mov rax, rdi
;; ----- push_rax @ 0x1A9
48 83 ED 08                ; sub rbp, 8
48 89 7D 00                ; mov [rbp], rdi                 ; the old TOS becomes the second item
48 97                      ; xchg rax, rdi                  ; TOS = rax
C3                         ; ret

;; ===== r> ( -- n ; R: n -- ) =====
;; The cell wanted is the one under r>'s own return address.
;; --- r> @ 0x1B4 --- header
99 01 40 00 00 00 00 00    ; link  = 0x400199 (dup)
00                         ; flags = 0
02                         ; nlen  = 2
72 3E                      ; name  = "r>"
;; ----- r_from @ 0x1C0
5A                         ; pop rdx                        ; our return address
58                         ; pop rax                        ; n
52                         ; push rdx
EB E4                      ; jmp push_rax (rel8 = 0x1A9 - 0x1C5) ; ( n )

;; ===== state ( -- addr ) =====
;; The address of the STATE cell, which is the sysvar page itself.
;; --- state @ 0x1C5 --- header
B4 01 40 00 00 00 00 00    ; link  = 0x4001B4 (r>)
00                         ; flags = 0
05                         ; nlen  = 5
73 74 61 74 65             ; name  = "state"
;; ----- state @ 0x1D4
48 89 D8                   ; mov rax, rbx
EB D0                      ; jmp push_rax (rel8 = 0x1A9 - 0x1D9)

;; ===== key ( -- c ) =====
;; One byte of standard input, by one read of count 1; 0 at end of input or
;; if the read fails.  The byte is read into a cell on the return stack
;; that starts as 0, so when read stores nothing the 0 is the answer.
;; The library overwrites the first 5 bytes of this routine with a jump to
;; a buffered key of its own; token gets its input only by calling here.
;; --- key @ 0x1D9 --- header
C5 01 40 00 00 00 00 00    ; link  = 0x4001C5 (state)
00                         ; flags = 0
03                         ; nlen  = 3
6B 65 79                   ; name  = "key"
;; ----- key @ 0x1E6
57                         ; push rdi                       ; save TOS: rdi is the first syscall argument
31 C0                      ; xor eax, eax                   ; rax = 0 = read
50                         ; push rax                       ; a cell of 0 to read into
31 FF                      ; xor edi, edi                   ; fd = 0, standard input
48 89 E6                   ; mov rsi, rsp                   ; buffer = that cell
8D 50 01                   ; lea edx, [rax+1]               ; count = 1
0F 05                      ; syscall
58                         ; pop rax                        ; the byte, or 0
5F                         ; pop rdi                        ; TOS back
EB B1                      ; jmp push_rax (rel8 = 0x1A9 - 0x1F8) ; ( c )

;; ===== : ( "name" -- ) =====
;; Reads a name and builds its header at HERE: link = LATEST, flags = 0,
;; nlen, the name.  LATEST becomes the new header at once, so a word can be
;; found inside its own definition.  HERE ends up just past the name, where
;; the code will go, and STATE becomes 1.  Nothing else is laid down.
;; stosq, stosb and rep movsb write at rdi and move it on.
;; --- : @ 0x1F8 --- header
D9 01 40 00 00 00 00 00    ; link  = 0x4001D9 (key)
00                         ; flags = 0
01                         ; nlen  = 1
3A                         ; name  = ":"
;; ----- colon @ 0x203
E8 7F FE FF FF             ; call token (rel32 = 0x87 - 0x208) ; ( tib u ); u = 0 at end of input is allowed
89 F9                      ; mov ecx, edi                   ; rcx = u, at most 255
48 8B 75 00                ; mov rsi, [rbp]                 ; rsi = the name
48 8B 7B 10                ; mov rdi, [rbx+HERE]            ; rdi = the new header
48 8B 43 08                ; mov rax, [rbx+LATEST]
48 89 7B 08                ; mov [rbx+LATEST], rdi          ; LATEST = the new header
48 AB                      ; stosq                          ; link = the old LATEST
31 C0                      ; xor eax, eax
AA                         ; stosb                          ; flags = 0
88 C8                      ; mov al, cl
AA                         ; stosb                          ; nlen = u
F3 A4                      ; rep movsb                      ; the name's u bytes
48 89 7B 10                ; mov [rbx+HERE], rdi            ; HERE = header + 10 + u
6A 01                      ; push 1
8F 03                      ; pop qword [rbx+STATE]          ; STATE = 1, the whole cell
EB 23                      ; jmp drop_two (rel8 = 0x251 - 0x22E) ; ( ): token's two results go

;; ===== c! ( b addr -- ) =====
;; --- c! @ 0x22E --- header
F8 01 40 00 00 00 00 00    ; link  = 0x4001F8 (:)
00                         ; flags = 0
02                         ; nlen  = 2
63 21                      ; name  = "c!"
;; ----- cstore @ 0x23A
8A 45 00                   ; mov al, [rbp]                  ; the low byte of b
AA                         ; stosb                          ; [addr] = al, one byte; rdi is dropped next anyway
EB 11                      ; jmp drop_two (rel8 = 0x251 - 0x240)

;; ===== ! ( v addr -- ) =====
;; Its tail, drop_two, removes the two top items of the data stack.
;; --- ! @ 0x240 --- header
2E 02 40 00 00 00 00 00    ; link  = 0x40022E (c!)
00                         ; flags = 0
01                         ; nlen  = 1
21                         ; name  = "!"
;; ----- store @ 0x24B
48 8B 45 00                ; mov rax, [rbp]                 ; v
48 AB                      ; stosq                          ; [addr] = v, 8 bytes
;; ----- drop_two @ 0x251
48 83 C5 08                ; add rbp, 8                     ; forget the second item
EB 5A                      ; jmp drop (rel8 = 0x2B1 - 0x257) ; and drop the top one

;; ===== >r ( n -- ; R: -- n ) =====
;; n goes under >r's own return address, so the caller finds it on top of
;; the return stack afterwards.
;; --- >r @ 0x257 --- header
40 02 40 00 00 00 00 00    ; link  = 0x400240 (!)
00                         ; flags = 0
02                         ; nlen  = 2
3E 72                      ; name  = ">r"
;; ----- to_r @ 0x263
58                         ; pop rax                        ; our return address
57                         ; push rdi                       ; n
50                         ; push rax
EB 49                      ; jmp drop (rel8 = 0x2B1 - 0x268) ; ( ): n leaves the data stack

;; ===== + ( a b -- a+b ) =====
;; The two-operand words work on TOS with [rbp] and end in nip, which
;; forgets the second item.
;; --- + @ 0x268 --- header
57 02 40 00 00 00 00 00    ; link  = 0x400257 (>r)
00                         ; flags = 0
01                         ; nlen  = 1
2B                         ; name  = "+"
;; ----- plus @ 0x273
48 03 7D 00                ; add rdi, [rbp]
EB 3C                      ; jmp nip (rel8 = 0x2B5 - 0x279)

;; ===== * ( a b -- a*b ) =====
;; --- * @ 0x279 --- header
68 02 40 00 00 00 00 00    ; link  = 0x400268 (+)
00                         ; flags = 0
01                         ; nlen  = 1
2A                         ; name  = "*"
;; ----- star @ 0x284
48 0F AF 7D 00             ; imul rdi, [rbp]                ; the low 64 bits of the product
EB 2A                      ; jmp nip (rel8 = 0x2B5 - 0x28B)

;; ===== / ( a b -- a/b ) =====
;; Unsigned.  The library depends on that: it uses / as a logical shift
;; right and for comparisons.
;; --- / @ 0x28B --- header
79 02 40 00 00 00 00 00    ; link  = 0x400279 (*)
00                         ; flags = 0
01                         ; nlen  = 1
2F                         ; name  = "/"
;; ----- slash @ 0x296
48 8B 45 00                ; mov rax, [rbp]                 ; a
31 D2                      ; xor edx, edx                   ; the dividend is rdx:rax = 0:a
48 F7 F7                   ; div rdi                        ; rax = a / b, unsigned
48 97                      ; xchg rax, rdi                  ; TOS = the quotient
EB 12                      ; jmp nip (rel8 = 0x2B5 - 0x2A3)

;; ===== drop ( a -- ) =====
;; Its tail, nip, removes the second item and keeps TOS.
;; --- drop @ 0x2A3 --- header
8B 02 40 00 00 00 00 00    ; link  = 0x40028B (/)
00                         ; flags = 0
04                         ; nlen  = 4
64 72 6F 70                ; name  = "drop"
;; ----- drop @ 0x2B1
48 8B 7D 00                ; mov rdi, [rbp]                 ; the second item becomes TOS
;; ----- nip @ 0x2B5
48 83 C5 08                ; add rbp, 8
C3                         ; ret

;; getc: al = the next input byte, 0 at end of input; the data stack is
;; left as it was.  It calls key at its xt, so it follows whatever key has
;; been replaced with, and takes key's result off the stack again.
;; pop_rax moves TOS to rax and drops it; the outer loop uses it too.
;; ----- getc @ 0x2BA
E8 27 FF FF FF             ; call key (rel32 = 0x1E6 - 0x2BF) ; ( c )
;; ----- pop_rax @ 0x2BF
48 97                      ; xchg rax, rdi                  ; rax = TOS; drop does not touch rax
EB EE                      ; jmp drop (rel8 = 0x2B1 - 0x2C3)

;; ===== nand ( a b -- ~(a&b) ) =====
;; --- nand @ 0x2C3 --- header
A3 02 40 00 00 00 00 00    ; link  = 0x4002A3 (drop)
00                         ; flags = 0
04                         ; nlen  = 4
6E 61 6E 64                ; name  = "nand"
;; ----- nand @ 0x2D1
48 23 7D 00                ; and rdi, [rbp]
48 F7 D7                   ; not rdi
EB DB                      ; jmp nip (rel8 = 0x2B5 - 0x2DA)

;; ===== find ( c-addr u -- xt | 0 ) =====
;; Walks the headers from LATEST along their links.  The first one whose
;; name has u bytes equal to those at c-addr wins: its address goes to
;; LAST_FOUND and its xt is the result.  At the end of the chain: 0.
;; The walk starts with rdx = the address of the LATEST cell, treated as a
;; header whose link is LATEST, so the loop needs no separate first step.
;; The library overwrites the first 5 bytes of this routine with a jump to
;; a hash-table lookup; no label lies inside those 5 bytes.
;; --- find @ 0x2DA --- header
C3 02 40 00 00 00 00 00    ; link  = 0x4002C3 (nand)
00                         ; flags = 0
04                         ; nlen  = 4
66 69 6E 64                ; name  = "find"
;; ----- find @ 0x2E8
48 97                      ; xchg rax, rdi                  ; rax = u; rdi is needed for the compare
48 8D 53 08                ; lea rdx, [rbx+LATEST]
;; .next:
48 8B 12                   ; mov rdx, [rdx]                 ; rdx = the next header
31 FF                      ; xor edi, edi                   ; the result if the chain ends here
48 85 D2                   ; test rdx, rdx
74 BD                      ; jz nip (rel8 = 0x2B5 - 0x2F8)  ; link 0: not found, ( 0 )
0F B6 4A 09                ; movzx ecx, byte [rdx+9]        ; rcx = nlen
48 39 C1                   ; cmp rcx, rax                   ; the same length as u?
75 ED                      ; jne .next (rel8 = 0x2EE - 0x301)
48 8B 75 00                ; mov rsi, [rbp]                 ; rsi = c-addr
48 8D 7A 0A                ; lea rdi, [rdx+10]              ; rdi = the header's name
F3 A6                      ; repe cmpsb                     ; compare rcx bytes; with rcx = 0 the flags stay "equal"
75 E1                      ; jne .next (rel8 = 0x2EE - 0x30D)
48 89 53 18                ; mov [rbx+LAST_FOUND], rdx      ; a match: remember the header
EB A2                      ; jmp nip (rel8 = 0x2B5 - 0x313) ; rdi stopped just past the name: that is the xt

;; ===== swap ( a b -- b a ) =====
;; --- swap @ 0x313 --- header
DA 02 40 00 00 00 00 00    ; link  = 0x4002DA (find)
00                         ; flags = 0
04                         ; nlen  = 4
73 77 61 70                ; name  = "swap"
;; ----- swap @ 0x321
48 87 7D 00                ; xchg rdi, [rbp]
C3                         ; ret

;; ===== @ ( addr -- v ) =====
;; --- @ @ 0x326 --- header
13 03 40 00 00 00 00 00    ; link  = 0x400313 (swap)
00                         ; flags = 0
01                         ; nlen  = 1
40                         ; name  = "@"
;; ----- fetch @ 0x331
48 8B 3F                   ; mov rdi, [rdi]
C3                         ; ret

;; ===== c@ ( addr -- b ) =====
;; --- c@ @ 0x335 --- header
26 03 40 00 00 00 00 00    ; link  = 0x400326 (@)
00                         ; flags = 0
02                         ; nlen  = 2
63 40                      ; name  = "c@"
;; ----- cfetch @ 0x341
0F B6 3F                   ; movzx edi, byte [rdi]          ; one byte, zero-extended to the whole of rdi
C3                         ; ret

;; ===== 0= ( n -- f ) =====
;; f is -1 if n is 0, otherwise 0.
;; --- 0= @ 0x345 --- header
35 03 40 00 00 00 00 00    ; link  = 0x400335 (c@)
00                         ; flags = 0
02                         ; nlen  = 2
30 3D                      ; name  = "0="
;; ----- zero_equal @ 0x351
48 83 FF 01                ; cmp rdi, 1                     ; borrows (sets carry) only when n = 0
48 19 FF                   ; sbb rdi, rdi                   ; rdi = 0 - carry: -1 or 0
C3                         ; ret

;; ===== ; ( -- ) IMMEDIATE =====
;; Ends a definition: lays a ret (C3) at HERE, moves HERE past it, and sets
;; STATE to 0.
;; --- ; @ 0x359 --- header  IMMEDIATE
45 03 40 00 00 00 00 00    ; link  = 0x400345 (0=)
01                         ; flags = 1 (IMMEDIATE)
01                         ; nlen  = 1
3B                         ; name  = ";"
;; ----- semicolon @ 0x364
48 8B 43 10                ; mov rax, [rbx+HERE]
C6 00 C3                   ; mov byte [rax], 0xC3           ; ret
48 FF 43 10                ; inc qword [rbx+HERE]
48 83 23 00                ; and qword [rbx+STATE], 0       ; STATE = 0, the whole cell
C3                         ; ret

;; ===== syscall6 ( a b c d e f n -- rax ) =====
;; System call n with the arguments a to f in rdi, rsi, rdx, r10, r8, r9;
;; the result is whatever the kernel leaves in rax.  The six arguments lie
;; on the data stack with f nearest, so for a moment rsp points at the data
;; stack and six pops fetch them and remove them in one go.  The return
;; stack pointer waits in rcx; both stacks are back in place before the
;; syscall, which matters for fork, where two processes return from it.
;; --- syscall6 @ 0x374 --- header
59 03 40 00 00 00 00 00    ; link  = 0x400359 (;)
00                         ; flags = 0
08                         ; nlen  = 8
73 79 73 63 61 6C 6C 36    ; name  = "syscall6"
;; ----- syscall6 @ 0x386
48 97                      ; xchg rax, rdi                  ; rax = n
48 89 E1                   ; mov rcx, rsp                   ; keep the return stack pointer
48 89 EC                   ; mov rsp, rbp                   ; rsp = the data stack: [rsp] is f
41 59                      ; pop r9                         ; f
41 58                      ; pop r8                         ; e
41 5A                      ; pop r10                        ; d
5A                         ; pop rdx                        ; c
5E                         ; pop rsi                        ; b
5F                         ; pop rdi                        ; a
48 89 E5                   ; mov rbp, rsp                   ; the data stack without the six
48 89 CC                   ; mov rsp, rcx                   ; the return stack again
0F 05                      ; syscall
48 97                      ; xchg rax, rdi                  ; TOS = the result
C3                         ; ret
