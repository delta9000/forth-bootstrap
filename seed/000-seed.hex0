41                          ; inc ecx
81 F9 00 01 00 00           ; cmp ecx, 256
72 AA                       ; jb .next (rel8 = 0x34B - 0x3A1)
BF 30 90 05 08              ; mov edi, TIB                  ; 256 bytes: print them and stop
