77 04                       ; ja .subtract (rel8 = 0x2CE - 0x2CA)
39 CB                       ; cmp ebx, ecx                  ; equal: the low halves decide
72 05                       ; jb .keep (rel8 = 0x2D3 - 0x2CE)
