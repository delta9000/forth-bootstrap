E8 01 FE FF FF              ; call dpush (rel32 = 0x183 - 0x382)
B8 30 90 05 08              ; mov eax, TIB                  ; c-addr
31 D2                       ; xor edx, edx
E8 F5 FD FF FF              ; call dpush (rel32 = 0x183 - 0x38E)
