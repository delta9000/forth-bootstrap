8B 1B                       ; mov ebx, [ebx]                ; follow the link
85 DB                       ; test ebx, ebx
74 19                       ; jz .done (rel8 = 0x3E0 - 0x3C7) ; the end of the chain: the result is 0
8D 7B 0A                    ; lea edi, [ebx+10]             ; edi = the header's name
89 EE                       ; mov esi, ebp                  ; esi = c-addr
0F B6 4B 09                 ; movzx ecx, byte [ebx+9]       ; ecx = nlen
