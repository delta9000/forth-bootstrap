75 E6                       ; jnz .step (rel8 = 0x2BC - 0x2D6)
31 DB                       ; xor ebx, ebx                  ; the quotient's high half is 0
EB CE                       ; jmp .done (rel8 = 0x2A8 - 0x2DA)

