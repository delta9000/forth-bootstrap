;; rdi path, rsi argv
56                                        ; push rsi
E8 A1 FC FF FF                            ; call resolve (rel32 = 0x18D - 0x4EC)
5E                                        ; pop rsi
0F 84 13 FF FF FF                         ; jz enoent (rel32 = 0x406 - 0x4F3)
44 8B 60 08                               ; mov r12d, [rax + E_DATA]
