;; argc, argv[], NULL, NULL envp, AT_NULL, strings
31 C9                                     ; xor ecx, ecx
;; .cnt @ 0x4F9
48 83 3C CE 00                            ; cmp qword [rsi + rcx*8], 0
74 04                                     ; je .cntd (rel8 = 0x504 - 0x500)
FF C1                                     ; inc ecx
EB F5                                     ; jmp .cnt (rel8 = 0x4F9 - 0x504)
;; .cntd @ 0x504
49 89 F1                                  ; mov r9, rsi
BF 00 00 01 30                            ; mov edi, KB
48 89 0F                                  ; mov [rdi], rcx
44 8D 47 08                               ; lea r8d, [rdi + 8]
8D 7C CF 28                               ; lea edi, [rdi + rcx*8 + 40]
;; .arg @ 0x517
49 8B 31                                  ; mov rsi, [r9]
49 83 C1 08                               ; add r9, 8
48 85 F6                                  ; test rsi, rsi
74 15                                     ; jz .argd (rel8 = 0x538 - 0x523)
8D 87 00 00 FE 0F                         ; lea eax, [rdi + SP0 - KB]
49 89 00                                  ; mov [r8], rax
41 83 C0 08                               ; add r8d, 8
;; .str @ 0x530
AC                                        ; lodsb
AA                                        ; stosb
84 C0                                     ; test al, al
75 FA                                     ; jnz .str (rel8 = 0x530 - 0x536)
EB DF                                     ; jmp .arg (rel8 = 0x517 - 0x538)
;; .argd @ 0x538
57                                        ; push rdi
44 89 C7                                  ; mov edi, r8d
31 C0                                     ; xor eax, eax
6A 04                                     ; push 4
59                                        ; pop rcx
F3 48 AB                                  ; rep stosq
;; every phdr is a PT_LOAD, in address order, from offset 64
41 8D 5C 24 40                            ; lea ebx, [r12 + 64]
8B 43 10                                  ; mov eax, [rbx + 16]
89 45 38                                  ; mov [rbp + P_LO], eax
45 0F B7 6C 24 38                         ; movzx r13d, word [r12 + 56]  ; e_phnum
;; .ph @ 0x555
8B 73 08                                  ; mov esi, [rbx + 8]
44 01 E6                                  ; add esi, r12d
8B 7B 10                                  ; mov edi, [rbx + 16]
8B 4B 20                                  ; mov ecx, [rbx + 32]
F3 A4                                     ; rep movsb
8B 4B 28                                  ; mov ecx, [rbx + 40]
2B 4B 20                                  ; sub ecx, [rbx + 32]
31 C0                                     ; xor eax, eax
F3 AA                                     ; rep stosb
89 7D 40                                  ; mov [rbp + P_HI], edi
83 C3 38                                  ; add ebx, 56
41 FF CD                                  ; dec r13d
75 DD                                     ; jnz .ph (rel8 = 0x555 - 0x578)
BF 00 00 7F 3F                            ; mov edi, SP0 - 0x800000  ; the new stack's 8 MiB read as
B9 00 00 80 00                            ; mov ecx, 0x800000  ; zero, as Linux's fresh pages do:
31 C0                                     ; xor eax, eax  ; tcc -g reads its getcwd buffer
F3 AA                                     ; rep stosb  ; even when getcwd fails
59                                        ; pop rcx  ; argv block -> SP0
81 E9 00 00 01 30                         ; sub ecx, KB
BE 00 00 01 30                            ; mov esi, KB
BF 00 00 FF 3F                            ; mov edi, SP0
F3 A4                                     ; rep movsb
45 8B 64 24 18                            ; mov r12d, [r12 + 24]  ; e_entry
8D 7D B0                                  ; lea edi, [rbp + U]  ; all registers zero
31 C0                                     ; xor eax, eax
6A 10                                     ; push 16
59                                        ; pop rcx
F3 48 AB                                  ; rep stosq
44 89 65 18                               ; mov [rbp + U_RIP], r12d
C7 45 28 00 00 FF 3F                      ; mov dword [rbp + U_RSP], SP0
C3                                        ; ret

