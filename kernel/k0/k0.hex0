;; k0.hex0 — K0, the single-task bootstrap kernel that starts the K1 run
;;
;; License: MIT (see /LICENSE)
;;
;; K0 boots under QEMU as a multiboot kernel and provides 17 Linux
;; syscalls over a RAM file system: enough for seed-forth and the recipe
;; runner it builds to compile K1 (kernel/tools/k1-direct-start.fth), which K0
;; then hands the machine to.  kernel/k0/k0.asm is the same program as NASM
;; source, with the design notes.
;;
;; How to read this file: every line is one instruction or one data
;; field; the text after ';' is a comment (hex0 ignores it).  Each
;; comment starts with the file offset; the image loads at 0x100000, so
;; offset 0xNNN is address 0x100NNN.  Relative branches show their
;; arithmetic, (rel8 = target - next instruction); operands that name a
;; label or constant show its value.  The file is 1461 bytes, loaded
;; at 0x100000 to 0x1005B5.
;;
;; Build:  hex0-seed kernel/k0/k0.hex0 k0.bin  (stage0-posix's 229-byte hex0)
;; kernel/k0/k0.asm is the same program as NASM source; kernel/k0/check.sh proves
;; nasm(k0.asm) and hex0(k0.hex0) are byte-identical.
;;
;; Fixed addresses (identity-mapped):
;;   0x00100000  K0 (this file)
;;   0x00400000  user images (0x400000.. and 0x40000000..)
;;   0x30000000  PB, the canonical-path buffer; 0x30010000 KB, argv block
;;   0x3FFF0000  SP0, a new program's initial rsp; argv strings above it
;;   0x50000000  FSIMG, the boot image from mkfs.py; rbp = 0x50000080
;;   0x80000000  anonymous mmap and fork snapshots, growing up

;; K0: the single-task bootstrap kernel that starts the K1 run.
;;
;; Multiboot (a.out kludge) -> long mode, the first 4 GiB identity-mapped
;; with 1 GiB pages, everything in ring 0, interrupts off.  Programs enter
;; through SYSCALL and return through JMP, so there is no TSS, no IDT and
;; no user segment.
;;
;; K0 boots from a memory image that mkfs.py writes and QEMU's loader
;; places at FSIMG: kernel state, page tables, init's argv, and the file
;; table with every file's contents.  Names are canonical: no leading '/'.
;;
;; fork runs the child to completion: the parent's registers, process
;; state, image and stack are saved, then restored when the child exits.
;; Every fork in the chain is fork -> redirect -> execve with the parent
;; waiting at once, so nothing else is needed.
;;
;; Every address K0 handles is below 4 GiB, so it works in 32-bit
;; registers wherever a value is its own.
;;
;; Output is the serial port, and one call of K0's own (248, sys_disk)
;; writes a file to the IDE disk: the TinyCC route's hex0 hand-off
;; (tests/tinycc/hex0-handoff-check.sh) writes builder-hex0's disk with it.

;;   SP0 = 0x3FFF0000                      ; initial rsp; the argv block sits above it
;;   STOP = 0x40000000                     ; top of the region saved as "stack"
;;   PB = 0x30000000                       ; canonical path buffer
;;   KB = 0x30010000                       ; argv block under construction
;;   FSIMG = 0x50000000                    ; the boot image (see mkfs.py)
;;   BASE = FSIMG + 0x80 = 0x50000080      ; rbp: kernel state
;;   PML4 = FSIMG + 0x1000 = 0x50001000
;;   INIT = FSIMG + 0x3000 = 0x50003000    ; init's argv; the path follows it
;;   ENTS = FSIMG + 0x4000 = 0x50004000    ; file table, 24-byte entries

;; file entry, 6 dwords
;;   E_NAME = 0 = 0x0
;;   E_NLEN = 4 = 0x4
;;   E_DATA = 8 = 0x8
;;   E_SIZE = 12 = 0xC
;;   E_CAP = 16 = 0x10
;;   E_TYPE = 20 = 0x14                    ; byte: 0 deleted, 1 file, 2 directory
;;   CONSOLE = 1 = 0x1                     ; fd entry value meaning the serial port

;; rbp-relative kernel state.  [U, P_END) is what fork saves.
;;   G_FP = -128 = -0x80                   ; innermost fork snapshot, 0 at top level
;;   G_PID = -120 = -0x78
;;   G_END = -112 = -0x70                  ; end of the file table
;;   G_HEAP = -104 = -0x68
;;   G_BUMP = -96 = -0x60
;;   G_PBLEN = -88 = -0x58
;;   U = -80 = -0x50                       ; user registers, in push order
;;   U_RFL = -48 = -0x30                   ; (r11)
;;   U_RIP = 24 = 0x18                     ; (rcx)
;;   U_RAX = 32 = 0x20
;;   U_RSP = 40 = 0x28
;;   P_CWDLEN = 48 = 0x30
;;   P_LO = 56 = 0x38                      ; loaded image [lo, hi)
;;   P_HI = 64 = 0x40
;;   P_LPID = 72 = 0x48                    ; last child: pid and wait status
;;   P_LST = 80 = 0x50
;;   P_FDS = 88 = 0x58                     ; 64 x {entry, pos}
;;   P_CWD = 600 = 0x258
;;   P_END = 1112 = 0x458

;; ----- hdr @ 0x000 -----
02 B0 AD 1B                               ; 0x000  dd 0x1BADB002
00 00 01 00                               ; 0x004  dd 0x00010000
FE 4F 51 E4                               ; 0x008  dd -(0x1BADB002 + 0x00010000)
00 00 10 00                               ; 0x00C  dd hdr
00 00 10 00                               ; 0x010  dd hdr
B5 05 10 00                               ; 0x014  dd file_end
B5 05 10 00                               ; 0x018  dd file_end
20 00 10 00                               ; 0x01C  dd start32

;; ----- start32 @ 0x020 -----

B8 00 10 00 50                            ; 0x020  mov eax, PML4  (PML4 = 0x50001000)
0F 22 D8                                  ; 0x025  mov cr3, eax
B8 20 06 00 00                            ; 0x028  mov eax, 0x620  ; PAE | OSFXSR | OSXMMEXCPT
0F 22 E0                                  ; 0x02D  mov cr4, eax
B9 80 00 00 C0                            ; 0x030  mov ecx, 0xC0000080  ; EFER: LME | SCE
0F 32                                     ; 0x035  rdmsr
0D 01 01 00 00                            ; 0x037  or eax, 0x101
0F 30                                     ; 0x03C  wrmsr
0F 20 C0                                  ; 0x03E  mov eax, cr0
0D 02 00 00 80                            ; 0x041  or eax, 0x80000002  ; PG | MP
0F 22 C0                                  ; 0x046  mov cr0, eax
0F 01 15 57 00 10 00                      ; 0x049  lgdt [gdt]  (gdt = 0x100057)
EA 67 00 10 00 08 00                      ; 0x050  jmp 8:start64  (start64 = 0x100067)

;; ----- gdt @ 0x057 -----
0F 00                                     ; 0x057  dw 15  ; the null descriptor holds the GDTR
57 00 10 00                               ; 0x059  dd gdt  (gdt = 0x100057)
00 00                                     ; 0x05D  dw 0
00 00 00 00 00 9A 20 00                   ; 0x05F  dq 0x00209A0000000000  ; 64-bit code

;; ----- start64 @ 0x067 -----

BD 80 00 00 50                            ; 0x067  mov ebp, BASE  (BASE = 0x50000080)
8D 65 80                                  ; 0x06C  lea esp, [rbp + G_FP]  (G_FP = -0x80)  ; kernel stack: below the image
B9 81 00 00 C0                            ; 0x06F  mov ecx, 0xC0000081  ; STAR: syscall CS 8, SS 16
31 C0                                     ; 0x074  xor eax, eax
BA 08 00 10 00                            ; 0x076  mov edx, 0x00100008
0F 30                                     ; 0x07B  wrmsr
FF C1                                     ; 0x07D  inc ecx  ; LSTAR
B8 98 00 10 00                            ; 0x07F  mov eax, syscall_entry  (syscall_entry = 0x100098)
99                                        ; 0x084  cdq
0F 30                                     ; 0x085  wrmsr
BF 10 30 00 50                            ; 0x087  mov edi, INIT + 16  (INIT = 0x50003000)
BE 00 30 00 50                            ; 0x08C  mov esi, INIT  (INIT = 0x50003000)
E8 50 04 00 00                            ; 0x091  call sys_execve  (rel32 = 0x4E6 - 0x096; sys_execve = 0x1004E6)
EB 4E                                     ; 0x096  jmp ret_user  (rel8 = 0x0E6 - 0x098; ret_user = 0x1000E6)

;; ---- entry and exit -------------------------------------------------------

;; ----- syscall_entry @ 0x098 -----

48 89 24 25 A8 00 00 50                   ; 0x098  mov [abs BASE + U_RSP], rsp  (BASE = 0x50000080; U_RSP = 0x28)
BC A8 00 00 50                            ; 0x0A0  mov esp, BASE + U_RSP  (BASE = 0x50000080; U_RSP = 0x28)
50                                        ; 0x0A5  push rax
51                                        ; 0x0A6  push rcx
52                                        ; 0x0A7  push rdx
53                                        ; 0x0A8  push rbx
55                                        ; 0x0A9  push rbp
56                                        ; 0x0AA  push rsi
57                                        ; 0x0AB  push rdi
41 50                                     ; 0x0AC  push r8
41 51                                     ; 0x0AE  push r9
41 52                                     ; 0x0B0  push r10
41 53                                     ; 0x0B2  push r11
41 54                                     ; 0x0B4  push r12
41 55                                     ; 0x0B6  push r13
41 56                                     ; 0x0B8  push r14
41 57                                     ; 0x0BA  push r15
BD 80 00 00 50                            ; 0x0BC  mov ebp, BASE  (BASE = 0x50000080)
8D 65 80                                  ; 0x0C1  lea esp, [rbp + G_FP]  (G_FP = -0x80)
BB 0A 01 10 00                            ; 0x0C4  mov ebx, sctab  (sctab = 0x10010A)
;;   .find @ 0x0C9
38 03                                     ; 0x0C9  cmp [rbx], al
74 0D                                     ; 0x0CB  je .hit  (rel8 = 0x0DA - 0x0CD)
83 C3 03                                  ; 0x0CD  add ebx, 3
80 3B FF                                  ; 0x0D0  cmp byte [rbx], 0xFF
75 F4                                     ; 0x0D3  jne .find  (rel8 = 0x0C9 - 0x0D5)
6A DA                                     ; 0x0D5  push -38  ; ENOSYS
58                                        ; 0x0D7  pop rax
EB 0C                                     ; 0x0D8  jmp ret_user  (rel8 = 0x0E6 - 0x0DA; ret_user = 0x1000E6)
;;   .hit @ 0x0DA
0F B7 5B 01                               ; 0x0DA  movzx ebx, word [rbx + 1]
81 C3 47 01 10 00                         ; 0x0DE  add ebx, handlers  (handlers = 0x100147)
FF D3                                     ; 0x0E4  call rbx

;; ----- ret_user @ 0x0E6 -----

48 89 45 20                               ; 0x0E6  mov [rbp + U_RAX], rax  (U_RAX = 0x20)
8D 65 B0                                  ; 0x0EA  lea esp, [rbp + U]  (U = -0x50)
41 5F                                     ; 0x0ED  pop r15
41 5E                                     ; 0x0EF  pop r14
41 5D                                     ; 0x0F1  pop r13
41 5C                                     ; 0x0F3  pop r12
41 5B                                     ; 0x0F5  pop r11
41 5A                                     ; 0x0F7  pop r10
41 59                                     ; 0x0F9  pop r9
41 58                                     ; 0x0FB  pop r8
5F                                        ; 0x0FD  pop rdi
5E                                        ; 0x0FE  pop rsi
5D                                        ; 0x0FF  pop rbp
5B                                        ; 0x100  pop rbx
5A                                        ; 0x101  pop rdx
59                                        ; 0x102  pop rcx
58                                        ; 0x103  pop rax
41 53                                     ; 0x104  push r11
9D                                        ; 0x106  popfq
5C                                        ; 0x107  pop rsp
FF E1                                     ; 0x108  jmp rcx

;; ----- sctab @ 0x10A -----
00 06 01                                  ; 0x10A  syscall 0 -> sys_read (handlers + 0x106)
01 35 01                                  ; 0x10D  syscall 1 -> sys_write (handlers + 0x135)
02 A5 00                                  ; 0x110  syscall 2 -> sys_open (handlers + 0xA5)
03 F3 00                                  ; 0x113  syscall 3 -> sys_close (handlers + 0xF3)
06 C4 01                                  ; 0x116  syscall 6 -> sys_lstat (handlers + 0x1C4)
08 8F 01                                  ; 0x119  syscall 8 -> sys_lseek (handlers + 0x18F)
09 CB 02                                  ; 0x11C  syscall 9 -> sys_mmap (handlers + 0x2CB)
0C E4 02                                  ; 0x11F  syscall 12 -> sys_brk (handlers + 0x2E4)
21 AF 01                                  ; 0x122  syscall 33 -> sys_dup2 (handlers + 0x1AF)
39 FB 02                                  ; 0x125  syscall 57 -> sys_fork (handlers + 0x2FB)
3B 9F 03                                  ; 0x128  syscall 59 -> sys_execve (handlers + 0x39F)
3C 2A 03                                  ; 0x12B  syscall 60 -> sys_exit (handlers + 0x32A)
3D 96 03                                  ; 0x12E  syscall 61 -> sys_wait4 (handlers + 0x396)
4F E7 01                                  ; 0x131  syscall 79 -> sys_getcwd (handlers + 0x1E7)
50 FB 01                                  ; 0x134  syscall 80 -> sys_chdir (handlers + 0x1FB)
52 1E 02                                  ; 0x137  syscall 82 -> sys_rename (handlers + 0x21E)
53 44 02                                  ; 0x13A  syscall 83 -> sys_mkdir (handlers + 0x244)
57 AF 02                                  ; 0x13D  syscall 87 -> sys_unlink (handlers + 0x2AF)
5A BC 02                                  ; 0x140  syscall 90 -> ok (handlers + 0x2BC)
F8 54 02                                  ; 0x143  syscall 248 -> sys_disk (handlers + 0x254)
FF                                        ; 0x146  db 0xFF

;; ---- paths and the file table --------------------------------------------

;; ----- handlers @ 0x147 -----

;; rsi = path -> PB holds its canonical form, [G_PBLEN] its length.
;; The chain's paths never contain "..", an inner "//" or "/./", or a
;; trailing '/'; "./" and repeated '/' occur only as prefixes.

;; ----- canon @ 0x147 -----

BF 00 00 00 30                            ; 0x147  mov edi, PB  (PB = 0x30000000)
80 3E 2F                                  ; 0x14C  cmp byte [rsi], '/'
74 1A                                     ; 0x14F  je .abs  (rel8 = 0x16B - 0x151)
56                                        ; 0x151  push rsi
8D B5 58 02 00 00                         ; 0x152  lea esi, [rbp + P_CWD]  (P_CWD = 0x258)
8B 4D 30                                  ; 0x158  mov ecx, [rbp + P_CWDLEN]  (P_CWDLEN = 0x30)
F3 A4                                     ; 0x15B  rep movsb
5E                                        ; 0x15D  pop rsi
81 FF 00 00 00 30                         ; 0x15E  cmp edi, PB  (PB = 0x30000000)
74 0C                                     ; 0x164  je .dots  (rel8 = 0x172 - 0x166)
B0 2F                                     ; 0x166  mov al, '/'
AA                                        ; 0x168  stosb
EB 07                                     ; 0x169  jmp .dots  (rel8 = 0x172 - 0x16B)
;;   .abs @ 0x16B
FF C6                                     ; 0x16B  inc esi  ; ROOT "/" + "/x" gives "//x"
80 3E 2F                                  ; 0x16D  cmp byte [rsi], '/'
74 F9                                     ; 0x170  je .abs  (rel8 = 0x16B - 0x172)
;;   .dots @ 0x172
66 81 3E 2E 2F                            ; 0x172  cmp word [rsi], './'
75 04                                     ; 0x177  jne .copy  (rel8 = 0x17D - 0x179)
66 AD                                     ; 0x179  lodsw
EB F5                                     ; 0x17B  jmp .dots  (rel8 = 0x172 - 0x17D)
;;   .copy @ 0x17D
AC                                        ; 0x17D  lodsb
AA                                        ; 0x17E  stosb
84 C0                                     ; 0x17F  test al, al
75 FA                                     ; 0x181  jnz .copy  (rel8 = 0x17D - 0x183)
81 EF 01 00 00 30                         ; 0x183  sub edi, PB + 1  (PB = 0x30000000)
89 7D A8                                  ; 0x189  mov [rbp + G_PBLEN], edi  (G_PBLEN = -0x58)
C3                                        ; 0x18C  ret

;; rdi = path -> rax = entry, or 0 with ZF set

;; ----- resolve @ 0x18D -----

89 FE                                     ; 0x18D  mov esi, edi
E8 B3 FF FF FF                            ; 0x18F  call canon  (rel32 = 0x147 - 0x194; canon = 0x100147)
8B 55 90                                  ; 0x194  mov edx, [rbp + G_END]  (G_END = -0x70)
;;   .l @ 0x197
83 EA 18                                  ; 0x197  sub edx, 24
81 FA 00 40 00 50                         ; 0x19A  cmp edx, ENTS  (ENTS = 0x50004000)
72 1D                                     ; 0x1A0  jb .no  (rel8 = 0x1BF - 0x1A2)
80 7A 14 00                               ; 0x1A2  cmp byte [rdx + E_TYPE], 0  (E_TYPE = 0x14)
74 EF                                     ; 0x1A6  je .l  (rel8 = 0x197 - 0x1A8)
8B 4D A8                                  ; 0x1A8  mov ecx, [rbp + G_PBLEN]  (G_PBLEN = -0x58)
3B 4A 04                                  ; 0x1AB  cmp ecx, [rdx + E_NLEN]  (E_NLEN = 0x4)
75 E7                                     ; 0x1AE  jne .l  (rel8 = 0x197 - 0x1B0)
8B 32                                     ; 0x1B0  mov esi, [rdx + E_NAME]  (E_NAME = 0x0)
BF 00 00 00 30                            ; 0x1B2  mov edi, PB  (PB = 0x30000000)
F3 A6                                     ; 0x1B7  repe cmpsb
75 DC                                     ; 0x1B9  jne .l  (rel8 = 0x197 - 0x1BB)
92                                        ; 0x1BB  xchg eax, edx
85 C0                                     ; 0x1BC  test eax, eax
C3                                        ; 0x1BE  ret
;;   .no @ 0x1BF
31 C0                                     ; 0x1BF  xor eax, eax
C3                                        ; 0x1C1  ret

;; bl = type -> rax = new entry named PB

;; ----- newent @ 0x1C2 -----

8B 45 90                                  ; 0x1C2  mov eax, [rbp + G_END]  (G_END = -0x70)
83 45 90 18                               ; 0x1C5  add dword [rbp + G_END], 24  (G_END = -0x70)
88 58 14                                  ; 0x1C9  mov [rax + E_TYPE], bl  (E_TYPE = 0x14)
;; rax = entry; its name becomes a copy of PB

;; ----- setname @ 0x1CC -----

8B 7D 98                                  ; 0x1CC  mov edi, [rbp + G_HEAP]  (G_HEAP = -0x68)
89 38                                     ; 0x1CF  mov [rax + E_NAME], edi  (E_NAME = 0x0)
8B 4D A8                                  ; 0x1D1  mov ecx, [rbp + G_PBLEN]  (G_PBLEN = -0x58)
89 48 04                                  ; 0x1D4  mov [rax + E_NLEN], ecx  (E_NLEN = 0x4)
BE 00 00 00 30                            ; 0x1D7  mov esi, PB  (PB = 0x30000000)
F3 A4                                     ; 0x1DC  rep movsb
89 7D 98                                  ; 0x1DE  mov [rbp + G_HEAP], edi  (G_HEAP = -0x68)
C3                                        ; 0x1E1  ret

;; rdi = fd -> rbx = slot, rax = entry; CF if closed

;; ----- fdp @ 0x1E2 -----

8D 5C FD 58                               ; 0x1E2  lea ebx, [rbp + P_FDS + rdi*8]  (P_FDS = 0x58)
8B 03                                     ; 0x1E6  mov eax, [rbx]
83 F8 01                                  ; 0x1E8  cmp eax, 1
C3                                        ; 0x1EB  ret

;; ---- files ---------------------------------------------------------------

;; ----- sys_open @ 0x1EC -----
;; rdi path, rsi flags
56                                        ; 0x1EC  push rsi
E8 9B FF FF FF                            ; 0x1ED  call resolve  (rel32 = 0x18D - 0x1F2; resolve = 0x10018D)
5E                                        ; 0x1F2  pop rsi
75 13                                     ; 0x1F3  jnz .have  (rel8 = 0x208 - 0x1F5)
0F BA E6 06                               ; 0x1F5  bt esi, 6  ; O_CREAT
0F 83 07 02 00 00                         ; 0x1F9  jnc enoent  (rel32 = 0x406 - 0x1FF; enoent = 0x100406)
B3 01                                     ; 0x1FF  mov bl, 1
E8 BC FF FF FF                            ; 0x201  call newent  (rel32 = 0x1C2 - 0x206; newent = 0x1001C2)
EB 18                                     ; 0x206  jmp .fd  (rel8 = 0x220 - 0x208)
;;   .have @ 0x208
0F BA E6 07                               ; 0x208  bt esi, 7  ; O_EXCL
0F 82 FC 01 00 00                         ; 0x20C  jc eexist  (rel32 = 0x40E - 0x212; eexist = 0x10040E)
0F BA E6 09                               ; 0x212  bt esi, 9  ; O_TRUNC: past size stays zero
73 08                                     ; 0x216  jnc .fd  (rel8 = 0x220 - 0x218)
83 60 0C 00                               ; 0x218  and dword [rax + E_SIZE], 0  (E_SIZE = 0xC)
83 60 10 00                               ; 0x21C  and dword [rax + E_CAP], 0  (E_CAP = 0x10)
;;   .fd @ 0x220
8D 5D 50                                  ; 0x220  lea ebx, [rbp + P_FDS - 8]  (P_FDS = 0x58)
;;   .f @ 0x223
83 C3 08                                  ; 0x223  add ebx, 8
83 3B 00                                  ; 0x226  cmp dword [rbx], 0
75 F8                                     ; 0x229  jne .f  (rel8 = 0x223 - 0x22B)
89 03                                     ; 0x22B  mov [rbx], eax
83 63 04 00                               ; 0x22D  and dword [rbx + 4], 0
8D 43 A8                                  ; 0x231  lea eax, [rbx - P_FDS]  (P_FDS = 0x58)
29 E8                                     ; 0x234  sub eax, ebp
C1 E8 03                                  ; 0x236  shr eax, 3
C3                                        ; 0x239  ret

;; ----- sys_close @ 0x23A -----

E8 A3 FF FF FF                            ; 0x23A  call fdp  (rel32 = 0x1E2 - 0x23F; fdp = 0x1001E2)
0F 82 C5 01 00 00                         ; 0x23F  jc ebadf  (rel32 = 0x40A - 0x245; ebadf = 0x10040A)
83 23 00                                  ; 0x245  and dword [rbx], 0
E9 B6 01 00 00                            ; 0x248  jmp ok  (rel32 = 0x403 - 0x24D; ok = 0x100403)

;; ----- sys_read @ 0x24D -----
;; rdi fd, rsi buf, rdx count
E8 90 FF FF FF                            ; 0x24D  call fdp  (rel32 = 0x1E2 - 0x252; fdp = 0x1001E2)
0F 82 B2 01 00 00                         ; 0x252  jc ebadf  (rel32 = 0x40A - 0x258; ebadf = 0x10040A)
8B 48 0C                                  ; 0x258  mov ecx, [rax + E_SIZE]  (E_SIZE = 0xC)
2B 4B 04                                  ; 0x25B  sub ecx, [rbx + 4]
0F 86 9F 01 00 00                         ; 0x25E  jbe ok  (rel32 = 0x403 - 0x264; ok = 0x100403)
48 39 D1                                  ; 0x264  cmp rcx, rdx
76 02                                     ; 0x267  jbe .n  (rel8 = 0x26B - 0x269)
89 D1                                     ; 0x269  mov ecx, edx
;;   .n @ 0x26B
89 F7                                     ; 0x26B  mov edi, esi
8B 70 08                                  ; 0x26D  mov esi, [rax + E_DATA]  (E_DATA = 0x8)
03 73 04                                  ; 0x270  add esi, [rbx + 4]
01 4B 04                                  ; 0x273  add [rbx + 4], ecx
91                                        ; 0x276  xchg eax, ecx
89 C1                                     ; 0x277  mov ecx, eax
F3 A4                                     ; 0x279  rep movsb
C3                                        ; 0x27B  ret

;; ----- sys_write @ 0x27C -----
;; rdi fd, rsi buf, rdx count
E8 61 FF FF FF                            ; 0x27C  call fdp  (rel32 = 0x1E2 - 0x281; fdp = 0x1001E2)
0F 82 83 01 00 00                         ; 0x281  jc ebadf  (rel32 = 0x40A - 0x287; ebadf = 0x10040A)
89 D1                                     ; 0x287  mov ecx, edx
51                                        ; 0x289  push rcx
FF C8                                     ; 0x28A  dec eax
75 0C                                     ; 0x28C  jnz .file  (rel8 = 0x29A - 0x28E)
66 BA F8 03                               ; 0x28E  mov dx, 0x3F8
E3 04                                     ; 0x292  jrcxz .wdone  (rel8 = 0x298 - 0x294)  ; a byte loop, not rep outsb: QEMU 8.2's
;;   .wout @ 0x294
AC                                        ; 0x294  lodsb  ; TCG aborts on K0's rep outsb
EE                                        ; 0x295  out dx, al
E2 FC                                     ; 0x296  loop .wout  (rel8 = 0x294 - 0x298)
;;   .wdone @ 0x298

58                                        ; 0x298  pop rax
C3                                        ; 0x299  ret
;;   .file @ 0x29A
FF C0                                     ; 0x29A  inc eax
8B 53 04                                  ; 0x29C  mov edx, [rbx + 4]  ; pos
01 CA                                     ; 0x29F  add edx, ecx  ; end
3B 50 10                                  ; 0x2A1  cmp edx, [rax + E_CAP]  (E_CAP = 0x10)
