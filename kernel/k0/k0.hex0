;; k0.hex0 — K0, the single-task bootstrap kernel
;;
;; Written directly in this form, as commented hex0, by AI models under
;; the owner's direction; HISTORY.md records how.  No generator: this file
;; is the source.  kernel/k0/asm-check.py assembles every comment with GNU
;; as (and with llvm-mc, when installed) and requires the same bytes, and
;; checks every branch note, label address and (label) operand.
;;
;; License: MIT (see /LICENSE)
;;
;; K0 boots under QEMU as a multiboot kernel and gives one program at a
;; time 19 Linux syscalls, and one of its own, over a RAM file system:
;; enough for seed-forth and the programs it builds.  The K1 route uses it to build K1
;; (kernel/tools/k1-direct-start.fth), which K0 then hands the machine to;
;; the TinyCC route uses it for boot 1 of the hex0 hand-off.
;;
;; How to read this file: every line is one instruction or one data
;; field; the text after ';' is a comment (hex0 ignores it), and its first
;; part is the instruction in the Intel syntax GNU as reads.  The image
;; loads at 0x100000, so a heading's offset 0xNNN is address 0x100NNN, and
;; an operand that is a label's address carries the label's name, as in
;; "mov eax, 0x100098 (syscall_entry)".  Relative branches show their
;; arithmetic, (rel8 = target - end of this instruction).  The constants
;; below are the names instructions use; their stated values are what the
;; check assembles with.  ";; ===== bits 32" and ";; ===== bits 64" lines
;; say which mode the code after them runs in.  The file is 1461 bytes,
;; loaded at 0x100000 to 0x1005B5.
;;
;; Build:  hex0-seed kernel/k0/k0.hex0 k0.bin  (stage0-posix's 229-byte hex0)
;; Check:  kernel/k0/check.sh  (asm-check.py, then the pinned sha256)
;;
;; Fixed addresses (identity-mapped):
;;   0x00100000  K0 (this file)
;;   0x00400000  user images (0x400000.. and 0x40000000..)
;;   0x30000000  PB, the canonical-path buffer; 0x30010000 KB, argv block
;;   0x3FFF0000  SP0, a new program's initial rsp; argv strings above it
;;   0x50000000  FSIMG, the boot image from mkfs.py; rbp = 0x50000080
;;   0x80000000  anonymous mmap and fork snapshots, growing up

;; K0: the single-task bootstrap kernel that starts the K1 run.
;;
;; Multiboot (a.out kludge) -> long mode, the first 4 GiB identity-mapped
;; with 1 GiB pages, everything in ring 0, interrupts off.  Programs enter
;; through SYSCALL and return through JMP, so there is no TSS, no IDT and
;; no user segment.
;;
;; K0 boots from a memory image that mkfs.py writes and QEMU's loader
;; places at FSIMG: kernel state, page tables, init's argv, and the file
;; table with every file's contents.  Names are canonical: no leading '/'.
;;
;; fork runs the child to completion: the parent's registers, process
;; state, image and stack are saved, then restored when the child exits.
;; Every fork in the chain is fork -> redirect -> execve with the parent
;; waiting at once, so nothing else is needed.
;;
;; Every address K0 handles is below 4 GiB, so it works in 32-bit
;; registers wherever a value is its own.
;;
;; Output is the serial port, and one call of K0's own (248, sys_disk)
;; writes a file to the IDE disk: the TinyCC route's hex0 hand-off
;; (tests/tinycc/hex0-handoff-check.sh) writes builder-hex0's disk with it.

;;   SP0 = 0x3FFF0000  initial rsp; the argv block sits above it
;;   STOP = 0x40000000  top of the region saved as "stack"
;;   PB = 0x30000000  canonical path buffer
;;   KB = 0x30010000  argv block under construction
;;   FSIMG = 0x50000000  the boot image (see mkfs.py)
;;   BASE = 0x50000080  FSIMG + 0x80  rbp: kernel state
;;   PML4 = 0x50001000  FSIMG + 0x1000
;;   INIT = 0x50003000  FSIMG + 0x3000  init's argv; the path follows it
;;   ENTS = 0x50004000  FSIMG + 0x4000  file table, 24-byte entries
;;   STAR_CS = 0x00100008  STAR's selector half: SYSCALL CS 8 (SS 16); SYSRET's unused

;; file entry, 6 dwords
;;   E_NAME = 0
;;   E_NLEN = 4
;;   E_DATA = 8
;;   E_SIZE = 12
;;   E_CAP = 16
;;   E_TYPE = 20  byte: 0 deleted, 1 file, 2 directory
;;   CONSOLE = 1  fd entry value meaning the serial port

;; rbp-relative kernel state.  [U, P_END) is what fork saves.
;;   G_FP = -128  innermost fork snapshot, 0 at top level
;;   G_PID = -120
;;   G_END = -112  end of the file table
;;   G_HEAP = -104
;;   G_BUMP = -96
;;   G_PBLEN = -88
;;   U = -80  user registers, in push order
;;   U_RFL = -48  (r11)
;;   U_RIP = 24  (rcx)
;;   U_RAX = 32
;;   U_RSP = 40
;;   P_CWDLEN = 48
;;   P_LO = 56  loaded image [lo, hi)
;;   P_HI = 64
;;   P_LPID = 72  last child: pid and wait status
;;   P_LST = 80
;;   P_FDS = 88  64 x {entry, pos}
;;   P_CWD = 600
;;   P_END = 1112

;; ===== bits 32: the multiboot header and the switch to long mode =====

;; ----- hdr @ 0x000 -----
02 B0 AD 1B                               ; dd 0x1BADB002
00 00 01 00                               ; dd 0x00010000
FE 4F 51 E4                               ; dd 0xE4514FFE  ; checksum: magic + flags + this = 0 (mod 2^32)
00 00 10 00                               ; dd 0x100000 (hdr)
00 00 10 00                               ; dd 0x100000 (hdr)
B5 05 10 00                               ; dd 0x1005B5 (file_end)
B5 05 10 00                               ; dd 0x1005B5 (file_end)
20 00 10 00                               ; dd 0x100020 (start32)

;; ----- start32 @ 0x020 -----

B8 00 10 00 50                            ; mov eax, PML4
0F 22 D8                                  ; mov cr3, eax
B8 20 06 00 00                            ; mov eax, 0x620  ; PAE | OSFXSR | OSXMMEXCPT
0F 22 E0                                  ; mov cr4, eax
B9 80 00 00 C0                            ; mov ecx, 0xC0000080  ; EFER: LME | SCE
0F 32                                     ; rdmsr
0D 01 01 00 00                            ; or eax, 0x101
0F 30                                     ; wrmsr
0F 20 C0                                  ; mov eax, cr0
0D 02 00 00 80                            ; or eax, 0x80000002  ; PG | MP
0F 22 C0                                  ; mov cr0, eax
0F 01 15 57 00 10 00                      ; lgdt [0x100057] (gdt)
EA 67 00 10 00 08 00                      ; ljmp 0x8, 0x100067 (start64)

;; ----- gdt @ 0x057 -----
0F 00                                     ; dw 15  ; the null descriptor holds the GDTR
57 00 10 00                               ; dd 0x100057 (gdt)
00 00                                     ; dw 0
00 00 00 00 00 9A 20 00                   ; dq 0x00209A0000000000  ; 64-bit code

;; ===== bits 64: everything after the switch =====

;; ----- start64 @ 0x067 -----

BD 80 00 00 50                            ; mov ebp, BASE
8D 65 80                                  ; lea esp, [rbp + G_FP]  ; kernel stack: below the image
B9 81 00 00 C0                            ; mov ecx, 0xC0000081  ; STAR: syscall CS 8, SS 16
31 C0                                     ; xor eax, eax
BA 08 00 10 00                            ; mov edx, STAR_CS  ; STAR[47:32]: SYSCALL loads CS 8 and SS 16
0F 30                                     ; wrmsr
FF C1                                     ; inc ecx  ; LSTAR
B8 98 00 10 00                            ; mov eax, 0x100098 (syscall_entry)
99                                        ; cdq
0F 30                                     ; wrmsr
BF 10 30 00 50                            ; mov edi, INIT + 16
BE 00 30 00 50                            ; mov esi, INIT
E8 50 04 00 00                            ; call sys_execve (rel32 = 0x4E6 - 0x096)
EB 4E                                     ; jmp ret_user (rel8 = 0x0E6 - 0x098)

;; ---- entry and exit -------------------------------------------------------

;; ----- syscall_entry @ 0x098 -----

48 89 24 25 A8 00 00 50                   ; mov [BASE + U_RSP], rsp
BC A8 00 00 50                            ; mov esp, BASE + U_RSP
50                                        ; push rax
51                                        ; push rcx
52                                        ; push rdx
53                                        ; push rbx
55                                        ; push rbp
56                                        ; push rsi
57                                        ; push rdi
41 50                                     ; push r8
41 51                                     ; push r9
41 52                                     ; push r10
41 53                                     ; push r11
41 54                                     ; push r12
41 55                                     ; push r13
41 56                                     ; push r14
41 57                                     ; push r15
BD 80 00 00 50                            ; mov ebp, BASE
8D 65 80                                  ; lea esp, [rbp + G_FP]
BB 0A 01 10 00                            ; mov ebx, 0x10010A (sctab)
;; .find @ 0x0C9
38 03                                     ; cmp [rbx], al
74 0D                                     ; je .hit (rel8 = 0x0DA - 0x0CD)
83 C3 03                                  ; add ebx, 3
80 3B FF                                  ; cmp byte [rbx], 0xFF
75 F4                                     ; jne .find (rel8 = 0x0C9 - 0x0D5)
6A DA                                     ; push -38  ; ENOSYS
58                                        ; pop rax
EB 0C                                     ; jmp ret_user (rel8 = 0x0E6 - 0x0DA)
;; .hit @ 0x0DA
0F B7 5B 01                               ; movzx ebx, word [rbx + 1]
81 C3 47 01 10 00                         ; add ebx, 0x100147 (handlers)
FF D3                                     ; call rbx

;; ----- ret_user @ 0x0E6 -----

48 89 45 20                               ; mov [rbp + U_RAX], rax
8D 65 B0                                  ; lea esp, [rbp + U]
41 5F                                     ; pop r15
41 5E                                     ; pop r14
41 5D                                     ; pop r13
41 5C                                     ; pop r12
41 5B                                     ; pop r11
41 5A                                     ; pop r10
41 59                                     ; pop r9
41 58                                     ; pop r8
5F                                        ; pop rdi
5E                                        ; pop rsi
5D                                        ; pop rbp
5B                                        ; pop rbx
5A                                        ; pop rdx
59                                        ; pop rcx
58                                        ; pop rax
41 53                                     ; push r11
9D                                        ; popfq
5C                                        ; pop rsp
FF E1                                     ; jmp rcx

;; ----- sctab @ 0x10A -----
00                                        ; db 0
06 01                                     ; dw sys_read - handlers
01                                        ; db 1
35 01                                     ; dw sys_write - handlers
02                                        ; db 2
A5 00                                     ; dw sys_open - handlers
03                                        ; db 3
F3 00                                     ; dw sys_close - handlers
06                                        ; db 6
C4 01                                     ; dw sys_lstat - handlers
08                                        ; db 8
8F 01                                     ; dw sys_lseek - handlers
09                                        ; db 9
CB 02                                     ; dw sys_mmap - handlers
0C                                        ; db 12
E4 02                                     ; dw sys_brk - handlers
21                                        ; db 33
AF 01                                     ; dw sys_dup2 - handlers
39                                        ; db 57
FB 02                                     ; dw sys_fork - handlers
3B                                        ; db 59
9F 03                                     ; dw sys_execve - handlers
3C                                        ; db 60
2A 03                                     ; dw sys_exit - handlers
3D                                        ; db 61
96 03                                     ; dw sys_wait4 - handlers
4F                                        ; db 79
E7 01                                     ; dw sys_getcwd - handlers
50                                        ; db 80
FB 01                                     ; dw sys_chdir - handlers
52                                        ; db 82
1E 02                                     ; dw sys_rename - handlers
53                                        ; db 83
44 02                                     ; dw sys_mkdir - handlers
57                                        ; db 87
AF 02                                     ; dw sys_unlink - handlers
5A                                        ; db 90
BC 02                                     ; dw ok - handlers
F8                                        ; db 248
54 02                                     ; dw sys_disk - handlers
FF                                        ; db 0xFF

;; ---- paths and the file table --------------------------------------------

;; ----- handlers @ 0x147 -----

;; rsi = path -> PB holds its canonical form, [G_PBLEN] its length.
;; The chain's paths never contain "..", an inner "//" or "/./", or a
;; trailing '/'; "./" and repeated '/' occur only as prefixes.

;; ----- canon @ 0x147 -----

BF 00 00 00 30                            ; mov edi, PB
80 3E 2F                                  ; cmp byte [rsi], 0x2F
74 1A                                     ; je .abs (rel8 = 0x16B - 0x151)
56                                        ; push rsi
8D B5 58 02 00 00                         ; lea esi, [rbp + P_CWD]
8B 4D 30                                  ; mov ecx, [rbp + P_CWDLEN]
F3 A4                                     ; rep movsb
5E                                        ; pop rsi
81 FF 00 00 00 30                         ; cmp edi, PB
74 0C                                     ; je .dots (rel8 = 0x172 - 0x166)
B0 2F                                     ; mov al, 0x2F
AA                                        ; stosb
EB 07                                     ; jmp .dots (rel8 = 0x172 - 0x16B)
;; .abs @ 0x16B
FF C6                                     ; inc esi  ; ROOT "/" + "/x" gives "//x"
80 3E 2F                                  ; cmp byte [rsi], 0x2F
74 F9                                     ; je .abs (rel8 = 0x16B - 0x172)
;; .dots @ 0x172
66 81 3E 2E 2F                            ; cmp word [rsi], 0x2F2E
75 04                                     ; jne .copy (rel8 = 0x17D - 0x179)
66 AD                                     ; lodsw
EB F5                                     ; jmp .dots (rel8 = 0x172 - 0x17D)
;; .copy @ 0x17D
AC                                        ; lodsb
AA                                        ; stosb
84 C0                                     ; test al, al
75 FA                                     ; jnz .copy (rel8 = 0x17D - 0x183)
81 EF 01 00 00 30                         ; sub edi, PB + 1
89 7D A8                                  ; mov [rbp + G_PBLEN], edi
C3                                        ; ret

;; rdi = path -> rax = entry, or 0 with ZF set

;; ----- resolve @ 0x18D -----

89 FE                                     ; mov esi, edi
E8 B3 FF FF FF                            ; call canon (rel32 = 0x147 - 0x194)
8B 55 90                                  ; mov edx, [rbp + G_END]
;; .l @ 0x197
83 EA 18                                  ; sub edx, 24
81 FA 00 40 00 50                         ; cmp edx, ENTS
72 1D                                     ; jb .no (rel8 = 0x1BF - 0x1A2)
80 7A 14 00                               ; cmp byte [rdx + E_TYPE], 0
74 EF                                     ; je .l (rel8 = 0x197 - 0x1A8)
8B 4D A8                                  ; mov ecx, [rbp + G_PBLEN]
3B 4A 04                                  ; cmp ecx, [rdx + E_NLEN]
75 E7                                     ; jne .l (rel8 = 0x197 - 0x1B0)
8B 32                                     ; mov esi, [rdx + E_NAME]
BF 00 00 00 30                            ; mov edi, PB
F3 A6                                     ; repe cmpsb
75 DC                                     ; jne .l (rel8 = 0x197 - 0x1BB)
92                                        ; xchg eax, edx
85 C0                                     ; test eax, eax
C3                                        ; ret
;; .no @ 0x1BF
31 C0                                     ; xor eax, eax
C3                                        ; ret

;; bl = type -> rax = new entry named PB

;; ----- newent @ 0x1C2 -----

8B 45 90                                  ; mov eax, [rbp + G_END]
83 45 90 18                               ; add dword [rbp + G_END], 24
88 58 14                                  ; mov [rax + E_TYPE], bl
;; rax = entry; its name becomes a copy of PB

;; ----- setname @ 0x1CC -----

8B 7D 98                                  ; mov edi, [rbp + G_HEAP]
89 38                                     ; mov [rax + E_NAME], edi
8B 4D A8                                  ; mov ecx, [rbp + G_PBLEN]
89 48 04                                  ; mov [rax + E_NLEN], ecx
BE 00 00 00 30                            ; mov esi, PB
F3 A4                                     ; rep movsb
89 7D 98                                  ; mov [rbp + G_HEAP], edi
C3                                        ; ret

;; rdi = fd -> rbx = slot, rax = entry; CF if closed

;; ----- fdp @ 0x1E2 -----

8D 5C FD 58                               ; lea ebx, [rbp + P_FDS + rdi*8]
8B 03                                     ; mov eax, [rbx]
83 F8 01                                  ; cmp eax, 1
C3                                        ; ret

;; ---- files ---------------------------------------------------------------

;; ----- sys_open @ 0x1EC -----
;; rdi path, rsi flags
56                                        ; push rsi
E8 9B FF FF FF                            ; call resolve (rel32 = 0x18D - 0x1F2)
5E                                        ; pop rsi
75 13                                     ; jnz .have (rel8 = 0x208 - 0x1F5)
0F BA E6 06                               ; bt esi, 6  ; O_CREAT
0F 83 07 02 00 00                         ; jnc enoent (rel32 = 0x406 - 0x1FF)
B3 01                                     ; mov bl, 1
E8 BC FF FF FF                            ; call newent (rel32 = 0x1C2 - 0x206)
EB 18                                     ; jmp .fd (rel8 = 0x220 - 0x208)
;; .have @ 0x208
0F BA E6 07                               ; bt esi, 7  ; O_EXCL
0F 82 FC 01 00 00                         ; jc eexist (rel32 = 0x40E - 0x212)
0F BA E6 09                               ; bt esi, 9  ; O_TRUNC: past size stays zero
73 08                                     ; jnc .fd (rel8 = 0x220 - 0x218)
83 60 0C 00                               ; and dword [rax + E_SIZE], 0
83 60 10 00                               ; and dword [rax + E_CAP], 0
;; .fd @ 0x220
8D 5D 50                                  ; lea ebx, [rbp + P_FDS - 8]
;; .f @ 0x223
83 C3 08                                  ; add ebx, 8
83 3B 00                                  ; cmp dword [rbx], 0
75 F8                                     ; jne .f (rel8 = 0x223 - 0x22B)
89 03                                     ; mov [rbx], eax
83 63 04 00                               ; and dword [rbx + 4], 0
8D 43 A8                                  ; lea eax, [rbx - P_FDS]
29 E8                                     ; sub eax, ebp
C1 E8 03                                  ; shr eax, 3
C3                                        ; ret

;; ----- sys_close @ 0x23A -----

E8 A3 FF FF FF                            ; call fdp (rel32 = 0x1E2 - 0x23F)
0F 82 C5 01 00 00                         ; jc ebadf (rel32 = 0x40A - 0x245)
83 23 00                                  ; and dword [rbx], 0
E9 B6 01 00 00                            ; jmp ok (rel32 = 0x403 - 0x24D)

;; ----- sys_read @ 0x24D -----
;; rdi fd, rsi buf, rdx count
E8 90 FF FF FF                            ; call fdp (rel32 = 0x1E2 - 0x252)
0F 82 B2 01 00 00                         ; jc ebadf (rel32 = 0x40A - 0x258)
8B 48 0C                                  ; mov ecx, [rax + E_SIZE]
2B 4B 04                                  ; sub ecx, [rbx + 4]
0F 86 9F 01 00 00                         ; jbe ok (rel32 = 0x403 - 0x264)
48 39 D1                                  ; cmp rcx, rdx
76 02                                     ; jbe .n (rel8 = 0x26B - 0x269)
89 D1                                     ; mov ecx, edx
;; .n @ 0x26B
89 F7                                     ; mov edi, esi
8B 70 08                                  ; mov esi, [rax + E_DATA]
03 73 04                                  ; add esi, [rbx + 4]
01 4B 04                                  ; add [rbx + 4], ecx
91                                        ; xchg eax, ecx
89 C1                                     ; mov ecx, eax
F3 A4                                     ; rep movsb
C3                                        ; ret

;; ----- sys_write @ 0x27C -----
;; rdi fd, rsi buf, rdx count
E8 61 FF FF FF                            ; call fdp (rel32 = 0x1E2 - 0x281)
0F 82 83 01 00 00                         ; jc ebadf (rel32 = 0x40A - 0x287)
89 D1                                     ; mov ecx, edx
51                                        ; push rcx
FF C8                                     ; dec eax
75 0C                                     ; jnz .file (rel8 = 0x29A - 0x28E)
66 BA F8 03                               ; mov dx, 0x3F8
E3 04                                     ; jrcxz .wdone (rel8 = 0x298 - 0x294)  ; a byte loop, not rep outsb: QEMU 8.2's
;; .wout @ 0x294
AC                                        ; lodsb  ; TCG aborts on K0's rep outsb
EE                                        ; out dx, al
E2 FC                                     ; loop .wout (rel8 = 0x294 - 0x298)
;; .wdone @ 0x298

58                                        ; pop rax
C3                                        ; ret
;; .file @ 0x29A
FF C0                                     ; inc eax
8B 53 04                                  ; mov edx, [rbx + 4]  ; pos
01 CA                                     ; add edx, ecx  ; end
3B 50 10                                  ; cmp edx, [rax + E_CAP]
76 19                                     ; jbe .fits (rel8 = 0x2BF - 0x2A6)
56                                        ; push rsi  ; grow to twice the new end;
8D 0C 12                                  ; lea ecx, [rdx + rdx]  ; fresh heap is zero, so bytes
89 48 10                                  ; mov [rax + E_CAP], ecx  ; past size always read as zero
8B 7D 98                                  ; mov edi, [rbp + G_HEAP]
01 4D 98                                  ; add [rbp + G_HEAP], ecx
8B 70 08                                  ; mov esi, [rax + E_DATA]
89 78 08                                  ; mov [rax + E_DATA], edi
8B 48 0C                                  ; mov ecx, [rax + E_SIZE]
F3 A4                                     ; rep movsb
5E                                        ; pop rsi
;; .fits @ 0x2BF
8B 78 08                                  ; mov edi, [rax + E_DATA]
03 7B 04                                  ; add edi, [rbx + 4]
89 53 04                                  ; mov [rbx + 4], edx
3B 50 0C                                  ; cmp edx, [rax + E_SIZE]
76 03                                     ; jbe .cp (rel8 = 0x2D0 - 0x2CD)
89 50 0C                                  ; mov [rax + E_SIZE], edx
;; .cp @ 0x2D0
59                                        ; pop rcx
89 C8                                     ; mov eax, ecx
F3 A4                                     ; rep movsb
C3                                        ; ret

;; ----- sys_lseek @ 0x2D6 -----
;; rdi fd, rsi offset, rdx whence
E8 07 FF FF FF                            ; call fdp (rel32 = 0x1E2 - 0x2DB)
0F 82 29 01 00 00                         ; jc ebadf (rel32 = 0x40A - 0x2E1)
31 C9                                     ; xor ecx, ecx
FF CA                                     ; dec edx
78 08                                     ; js .set (rel8 = 0x2EF - 0x2E7)
8B 4B 04                                  ; mov ecx, [rbx + 4]
74 03                                     ; jz .set (rel8 = 0x2EF - 0x2EC)
8B 48 0C                                  ; mov ecx, [rax + E_SIZE]
;; .set @ 0x2EF
01 F1                                     ; add ecx, esi
89 4B 04                                  ; mov [rbx + 4], ecx
91                                        ; xchg eax, ecx
C3                                        ; ret

;; ----- sys_dup2 @ 0x2F6 -----
;; rdi old, rsi new
E8 E7 FE FF FF                            ; call fdp (rel32 = 0x1E2 - 0x2FB)
0F 82 09 01 00 00                         ; jc ebadf (rel32 = 0x40A - 0x301)
48 8B 03                                  ; mov rax, [rbx]
48 89 44 F5 58                            ; mov [rbp + P_FDS + rsi*8], rax
96                                        ; xchg eax, esi
C3                                        ; ret

;; ----- sys_lstat @ 0x30B -----
;; rdi path, rsi buf: only st_mode
56                                        ; push rsi
E8 7C FE FF FF                            ; call resolve (rel32 = 0x18D - 0x311)
5F                                        ; pop rdi
0F 84 EE 00 00 00                         ; jz enoent (rel32 = 0x406 - 0x318)
B6 81                                     ; mov dh, 0x81  ; S_IFREG
80 78 14 02                               ; cmp byte [rax + E_TYPE], 2
75 02                                     ; jne .m (rel8 = 0x322 - 0x320)
B6 41                                     ; mov dh, 0x41  ; S_IFDIR
;; .m @ 0x322
88 77 19                                  ; mov [rdi + 25], dh
C6 47 18 ED                               ; mov byte [rdi + 24], 0xED
E9 D5 00 00 00                            ; jmp ok (rel32 = 0x403 - 0x32E)

;; ----- sys_getcwd @ 0x32E -----
;; rdi buf
B0 2F                                     ; mov al, 0x2F
AA                                        ; stosb
8D B5 58 02 00 00                         ; lea esi, [rbp + P_CWD]
8B 4D 30                                  ; mov ecx, [rbp + P_CWDLEN]
8D 41 02                                  ; lea eax, [rcx + 2]
F3 A4                                     ; rep movsb
88 0F                                     ; mov [rdi], cl
C3                                        ; ret

;; ----- sys_chdir @ 0x342 -----

E8 46 FE FF FF                            ; call resolve (rel32 = 0x18D - 0x347)
0F 84 B9 00 00 00                         ; jz enoent (rel32 = 0x406 - 0x34D)
BE 00 00 00 30                            ; mov esi, PB
8D BD 58 02 00 00                         ; lea edi, [rbp + P_CWD]
8B 4D A8                                  ; mov ecx, [rbp + G_PBLEN]
89 4D 30                                  ; mov [rbp + P_CWDLEN], ecx
F3 A4                                     ; rep movsb
E9 9E 00 00 00                            ; jmp ok (rel32 = 0x403 - 0x365)

;; ----- sys_rename @ 0x365 -----
;; rdi old, rsi new
56                                        ; push rsi
E8 22 FE FF FF                            ; call resolve (rel32 = 0x18D - 0x36B)
5F                                        ; pop rdi
0F 84 94 00 00 00                         ; jz enoent (rel32 = 0x406 - 0x372)
50                                        ; push rax
E8 15 FE FF FF                            ; call resolve (rel32 = 0x18D - 0x378)
5A                                        ; pop rdx
74 08                                     ; jz .set (rel8 = 0x383 - 0x37B)
39 D0                                     ; cmp eax, edx
74 04                                     ; je .set (rel8 = 0x383 - 0x37F)
C6 40 14 00                               ; mov byte [rax + E_TYPE], 0
;; .set @ 0x383
92                                        ; xchg eax, edx
E8 43 FE FF FF                            ; call setname (rel32 = 0x1CC - 0x389)
EB 78                                     ; jmp ok (rel8 = 0x403 - 0x38B)

;; ----- sys_mkdir @ 0x38B -----

E8 FD FD FF FF                            ; call resolve (rel32 = 0x18D - 0x390)
75 7C                                     ; jnz eexist (rel8 = 0x40E - 0x392)
B3 02                                     ; mov bl, 2
E8 29 FE FF FF                            ; call newent (rel32 = 0x1C2 - 0x399)
EB 68                                     ; jmp ok (rel8 = 0x403 - 0x39B)

;; The file open on fd rdi becomes the IDE primary master's first
;; size/512 sectors (the caller pads it to whole sectors), by LBA28 PIO
;; one sector at a time.  Boot 1 of the hex0 hand-off writes
;; builder-hex0's disk with it (tinycc/hex0-disk.c).

;; ----- sys_disk @ 0x39B -----

E8 42 FE FF FF                            ; call fdp (rel32 = 0x1E2 - 0x3A0)
72 68                                     ; jc ebadf (rel8 = 0x40A - 0x3A2)
8B 70 08                                  ; mov esi, [rax + E_DATA]
8B 58 0C                                  ; mov ebx, [rax + E_SIZE]
C1 EB 09                                  ; shr ebx, 9  ; sectors
74 56                                     ; jz ok (rel8 = 0x403 - 0x3AD)
31 FF                                     ; xor edi, edi  ; LBA
;; .sec @ 0x3AF
89 F8                                     ; mov eax, edi
BA F3 01 00 00                            ; mov edx, 0x1F3
EE                                        ; out dx, al  ; LBA 0-7
FF C2                                     ; inc edx
C1 E8 08                                  ; shr eax, 8
EE                                        ; out dx, al  ; 8-15
FF C2                                     ; inc edx
C1 E8 08                                  ; shr eax, 8
EE                                        ; out dx, al  ; 16-23
FF C2                                     ; inc edx
C1 E8 08                                  ; shr eax, 8
0C E0                                     ; or al, 0xE0
EE                                        ; out dx, al  ; 0x1F6: master, LBA, 24-27
B2 F2                                     ; mov dl, 0xF2
B0 01                                     ; mov al, 1
EE                                        ; out dx, al  ; one sector
B2 F7                                     ; mov dl, 0xF7
B0 30                                     ; mov al, 0x30
EE                                        ; out dx, al  ; WRITE SECTORS
;; .drq @ 0x3D5
EC                                        ; in al, dx
A8 08                                     ; test al, 8  ; DRQ: the drive takes the data
74 FB                                     ; jz .drq (rel8 = 0x3D5 - 0x3DA)
B2 F0                                     ; mov dl, 0xF0
B9 00 01 00 00                            ; mov ecx, 256
;; .w @ 0x3E1
66 AD                                     ; lodsw  ; a word loop, not rep outsw
66 EF                                     ; out dx, ax  ; (see sys_write)
E2 FA                                     ; loop .w (rel8 = 0x3E1 - 0x3E7)
B2 F7                                     ; mov dl, 0xF7
;; .bsy @ 0x3E9
EC                                        ; in al, dx
A8 80                                     ; test al, 0x80  ; BSY: the sector is written
75 FB                                     ; jnz .bsy (rel8 = 0x3E9 - 0x3EE)
FF C7                                     ; inc edi
FF CB                                     ; dec ebx
75 BB                                     ; jnz .sec (rel8 = 0x3AF - 0x3F4)
EB 0D                                     ; jmp ok (rel8 = 0x403 - 0x3F6)

;; ----- sys_unlink @ 0x3F6 -----

E8 92 FD FF FF                            ; call resolve (rel32 = 0x18D - 0x3FB)
74 09                                     ; jz enoent (rel8 = 0x406 - 0x3FD)
C6 40 14 00                               ; mov byte [rax + E_TYPE], 0
EB 00                                     ; jmp ok (rel8 = 0x403 - 0x403)

;; ----- ok @ 0x403 -----
31 C0                                     ; xor eax, eax
C3                                        ; ret

;; ----- enoent @ 0x406 -----
6A FE                                     ; push -2
58                                        ; pop rax
C3                                        ; ret

;; ----- ebadf @ 0x40A -----
6A F7                                     ; push -9
58                                        ; pop rax
C3                                        ; ret

;; ----- eexist @ 0x40E -----
6A EF                                     ; push -17
58                                        ; pop rax
C3                                        ; ret

;; ---- memory and processes ------------------------------------------------

;; ----- sys_mmap @ 0x412 -----
;; rsi length; anonymous only
8B 7D A0                                  ; mov edi, [rbp + G_BUMP]
57                                        ; push rdi
8D 8E FF 0F 00 00                         ; lea ecx, [rsi + 4095]
81 E1 00 F0 FF FF                         ; and ecx, -4096
01 4D A0                                  ; add [rbp + G_BUMP], ecx
31 C0                                     ; xor eax, eax
F3 AA                                     ; rep stosb
58                                        ; pop rax
C3                                        ; ret

;; The break is the end of the loaded image, so fork saves the heap with
;; the image.  Mes libc's malloc only grows it; a lower address returns
;; the break unchanged.

;; ----- sys_brk @ 0x42B -----
;; rdi addr
8B 45 40                                  ; mov eax, [rbp + P_HI]
48 39 C7                                  ; cmp rdi, rax
76 0E                                     ; jbe .d (rel8 = 0x441 - 0x433)  ; brk(0): the break
97                                        ; xchg eax, edi  ; eax new break, edi old
89 C1                                     ; mov ecx, eax
29 F9                                     ; sub ecx, edi
50                                        ; push rax
31 C0                                     ; xor eax, eax
F3 AA                                     ; rep stosb  ; fresh memory reads as zero
58                                        ; pop rax
89 45 40                                  ; mov [rbp + P_HI], eax
;; .d @ 0x441
C3                                        ; ret

;; ----- sys_fork @ 0x442 -----

8B 5D A0                                  ; mov ebx, [rbp + G_BUMP]
8B 45 80                                  ; mov eax, [rbp + G_FP]
89 03                                     ; mov [rbx], eax
89 5D 80                                  ; mov [rbp + G_FP], ebx
FF 45 88                                  ; inc dword [rbp + G_PID]
8B 45 88                                  ; mov eax, [rbp + G_PID]
89 43 04                                  ; mov [rbx + 4], eax
83 C3 08                                  ; add ebx, 8
31 D2                                     ; xor edx, edx
E8 45 00 00 00                            ; call xfer (rel32 = 0x4A5 - 0x460)
81 C3 FF 0F 00 00                         ; add ebx, 4095
81 E3 00 F0 FF FF                         ; and ebx, -4096
89 5D A0                                  ; mov [rbp + G_BUMP], ebx
EB 92                                     ; jmp ok (rel8 = 0x403 - 0x471)

;; ----- sys_exit @ 0x471 -----

8B 5D 80                                  ; mov ebx, [rbp + G_FP]
85 DB                                     ; test ebx, ebx
74 29                                     ; jz .halt (rel8 = 0x4A1 - 0x478)
89 5D A0                                  ; mov [rbp + G_BUMP], ebx
8B 03                                     ; mov eax, [rbx]
89 45 80                                  ; mov [rbp + G_FP], eax
44 8B 63 04                               ; mov r12d, [rbx + 4]
44 0F B6 EF                               ; movzx r13d, dil
41 C1 E5 08                               ; shl r13d, 8
83 C3 08                                  ; add ebx, 8
B2 01                                     ; mov dl, 1
E8 0F 00 00 00                            ; call xfer (rel32 = 0x4A5 - 0x496)
44 89 65 48                               ; mov [rbp + P_LPID], r12d
44 89 6D 50                               ; mov [rbp + P_LST], r13d
41 94                                     ; xchg eax, r12d
C3                                        ; ret
;; .halt @ 0x4A1
97                                        ; xchg eax, edi
E6 F4                                     ; out 0xF4, al  ; isa-debug-exit
F4                                        ; hlt

;; Copy process state to (dl=0) or from (dl=1) the snapshot at rbx:
;; registers and process state, the image, then the stack.  On restore
;; each range is computed from what the previous copy put back.

;; ----- xfer @ 0x4A5 -----

8D 45 B0                                  ; lea eax, [rbp + U]
B9 A8 04 00 00                            ; mov ecx, P_END - U
E8 1C 00 00 00                            ; call .r (rel32 = 0x4CE - 0x4B2)
8B 45 38                                  ; mov eax, [rbp + P_LO]
8B 4D 40                                  ; mov ecx, [rbp + P_HI]
29 C1                                     ; sub ecx, eax
E8 0F 00 00 00                            ; call .r (rel32 = 0x4CE - 0x4BF)
8B 45 28                                  ; mov eax, [rbp + U_RSP]
2D 80 00 00 00                            ; sub eax, 128  ; red zone
B9 00 00 00 40                            ; mov ecx, STOP
29 C1                                     ; sub ecx, eax
;; .r @ 0x4CE
89 C6                                     ; mov esi, eax
89 DF                                     ; mov edi, ebx
01 CB                                     ; add ebx, ecx
84 D2                                     ; test dl, dl
74 02                                     ; jz .c (rel8 = 0x4DA - 0x4D8)
87 F7                                     ; xchg edi, esi
;; .c @ 0x4DA
F3 A4                                     ; rep movsb
C3                                        ; ret

;; ----- sys_wait4 @ 0x4DD -----
;; rsi status*
8B 45 48                                  ; mov eax, [rbp + P_LPID]
8B 4D 50                                  ; mov ecx, [rbp + P_LST]
89 0E                                     ; mov [rsi], ecx
C3                                        ; ret

