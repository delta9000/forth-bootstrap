C1 EB 09                                  ; 0x3A5  shr ebx, 9  ; sectors
74 56                                     ; 0x3A8  jz ok  (rel8 = 0x400 - 0x3AA; ok = 0x100400)
31 FF                                     ; 0x3AA  xor edi, edi  ; LBA
;;   .sec @ 0x3AC
89 F8                                     ; 0x3AC  mov eax, edi
BA F3 01 00 00                            ; 0x3AE  mov edx, 0x1F3
EE                                        ; 0x3B3  out dx, al  ; LBA 0-7
FF C2                                     ; 0x3B4  inc edx
C1 E8 08                                  ; 0x3B6  shr eax, 8
EE                                        ; 0x3B9  out dx, al  ; 8-15
FF C2                                     ; 0x3BA  inc edx
C1 E8 08                                  ; 0x3BC  shr eax, 8
EE                                        ; 0x3BF  out dx, al  ; 16-23
FF C2                                     ; 0x3C0  inc edx
C1 E8 08                                  ; 0x3C2  shr eax, 8
0C E0                                     ; 0x3C5  or al, 0xE0
EE                                        ; 0x3C7  out dx, al  ; 0x1F6: master, LBA, 24-27
B2 F2                                     ; 0x3C8  mov dl, 0xF2
B0 01                                     ; 0x3CA  mov al, 1
EE                                        ; 0x3CC  out dx, al  ; one sector
B2 F7                                     ; 0x3CD  mov dl, 0xF7
B0 30                                     ; 0x3CF  mov al, 0x30
EE                                        ; 0x3D1  out dx, al  ; WRITE SECTORS
;;   .drq @ 0x3D2
EC                                        ; 0x3D2  in al, dx
A8 08                                     ; 0x3D3  test al, 8  ; DRQ: the drive takes the data
74 FB                                     ; 0x3D5  jz .drq  (rel8 = 0x3D2 - 0x3D7)
B2 F0                                     ; 0x3D7  mov dl, 0xF0
B9 00 01 00 00                            ; 0x3D9  mov ecx, 256
;;   .w @ 0x3DE
66 AD                                     ; 0x3DE  lodsw  ; a word loop, not rep outsw
66 EF                                     ; 0x3E0  out dx, ax  ; (see sys_write)
E2 FA                                     ; 0x3E2  loop .w  (rel8 = 0x3DE - 0x3E4)
B2 F7                                     ; 0x3E4  mov dl, 0xF7
;;   .bsy @ 0x3E6
EC                                        ; 0x3E6  in al, dx
A8 80                                     ; 0x3E7  test al, 0x80  ; BSY: the sector is written
75 FB                                     ; 0x3E9  jnz .bsy  (rel8 = 0x3E6 - 0x3EB)
FF C7                                     ; 0x3EB  inc edi
FF CB                                     ; 0x3ED  dec ebx
75 BB                                     ; 0x3EF  jnz .sec  (rel8 = 0x3AC - 0x3F1)
EB 0D                                     ; 0x3F1  jmp ok  (rel8 = 0x400 - 0x3F3; ok = 0x100400)

