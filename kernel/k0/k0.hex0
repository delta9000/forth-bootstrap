;; k0.hex0 — K0, the single-task bootstrap kernel that starts the K1 run
;;
;; License: MIT (see /LICENSE)
;;
;; K0 boots under QEMU as a multiboot kernel and provides 17 Linux
;; syscalls over a RAM file system: enough for seed-forth and the recipe
;; runner it builds to compile K1 (kernel/tools/k1-direct-start.fth), which K0
;; then hands the machine to.  kernel/k0/k0.asm is the same program as NASM
;; source, with the design notes.
;;
;; How to read this file: every line is one instruction or one data
;; field; the text after ';' is a comment (hex0 ignores it).  Each
;; comment starts with the file offset; the image loads at 0x100000, so
;; offset 0xNNN is address 0x100NNN.  Relative branches show their
;; arithmetic, (rel8 = target - next instruction); operands that name a
;; label or constant show its value.  The file is 1435 bytes, loaded
;; at 0x100000 to 0x10059B.
;;
;; Build:  hex0-seed kernel/k0/k0.hex0 k0.bin  (stage0-posix's 229-byte hex0)
;; kernel/k0/k0.asm is the same program as NASM source; kernel/k0/check.sh proves
;; nasm(k0.asm) and hex0(k0.hex0) are byte-identical.
;;
;; Fixed addresses (identity-mapped):
;;   0x00100000  K0 (this file)
;;   0x00400000  user images (0x400000.. and 0x40000000..)
;;   0x30000000  PB, the canonical-path buffer; 0x30010000 KB, argv block
;;   0x3FFF0000  SP0, a new program's initial rsp; argv strings above it
;;   0x50000000  FSIMG, the boot image from mkfs.py; rbp = 0x50000080
;;   0x80000000  anonymous mmap and fork snapshots, growing up

;; K0: the single-task bootstrap kernel that starts the K1 run.
;;
;; Multiboot (a.out kludge) -> long mode, the first 4 GiB identity-mapped
;; with 1 GiB pages, everything in ring 0, interrupts off.  Programs enter
;; through SYSCALL and return through JMP, so there is no TSS, no IDT and
;; no user segment.
;;
;; K0 boots from a memory image that mkfs.py writes and QEMU's loader
;; places at FSIMG: kernel state, page tables, init's argv, and the file
;; table with every file's contents.  Names are canonical: no leading '/'.
;;
;; fork runs the child to completion: the parent's registers, process
;; state, image and stack are saved, then restored when the child exits.
;; Every fork in the chain is fork -> redirect -> execve with the parent
;; waiting at once, so nothing else is needed.
;;
;; Every address K0 handles is below 4 GiB, so it works in 32-bit
;; registers wherever a value is its own.
;;
;; Output is the serial port, and one call of K0's own (248, sys_disk)
;; writes a file to the IDE disk: the TinyCC route's hex0 hand-off
;; (tests/tinycc/hex0-handoff-check.sh) writes builder-hex0's disk with it.

;;   SP0 = 0x3FFF0000                      ; initial rsp; the argv block sits above it
;;   STOP = 0x40000000                     ; top of the region saved as "stack"
;;   PB = 0x30000000                       ; canonical path buffer
;;   KB = 0x30010000                       ; argv block under construction
;;   FSIMG = 0x50000000                    ; the boot image (see mkfs.py)
;;   BASE = FSIMG + 0x80 = 0x50000080      ; rbp: kernel state
;;   PML4 = FSIMG + 0x1000 = 0x50001000
;;   INIT = FSIMG + 0x3000 = 0x50003000    ; init's argv; the path follows it
;;   ENTS = FSIMG + 0x4000 = 0x50004000    ; file table, 24-byte entries

;; file entry, 6 dwords
;;   E_NAME = 0 = 0x0
;;   E_NLEN = 4 = 0x4
;;   E_DATA = 8 = 0x8
;;   E_SIZE = 12 = 0xC
;;   E_CAP = 16 = 0x10
;;   E_TYPE = 20 = 0x14                    ; byte: 0 deleted, 1 file, 2 directory
;;   CONSOLE = 1 = 0x1                     ; fd entry value meaning the serial port

;; rbp-relative kernel state.  [U, P_END) is what fork saves.
;;   G_FP = -128 = -0x80                   ; innermost fork snapshot, 0 at top level
;;   G_PID = -120 = -0x78
;;   G_END = -112 = -0x70                  ; end of the file table
;;   G_HEAP = -104 = -0x68
;;   G_BUMP = -96 = -0x60
;;   G_PBLEN = -88 = -0x58
;;   U = -80 = -0x50                       ; user registers, in push order
;;   U_RFL = -48 = -0x30                   ; (r11)
;;   U_RIP = 24 = 0x18                     ; (rcx)
;;   U_RAX = 32 = 0x20
;;   U_RSP = 40 = 0x28
;;   P_CWDLEN = 48 = 0x30
;;   P_LO = 56 = 0x38                      ; loaded image [lo, hi)
;;   P_HI = 64 = 0x40
;;   P_LPID = 72 = 0x48                    ; last child: pid and wait status
;;   P_LST = 80 = 0x50
;;   P_FDS = 88 = 0x58                     ; 64 x {entry, pos}
;;   P_CWD = 600 = 0x258
;;   P_END = 1112 = 0x458

;; ----- hdr @ 0x000 -----
02 B0 AD 1B                               ; 0x000  dd 0x1BADB002
00 00 01 00                               ; 0x004  dd 0x00010000
FE 4F 51 E4                               ; 0x008  dd -(0x1BADB002 + 0x00010000)
00 00 10 00                               ; 0x00C  dd hdr
00 00 10 00                               ; 0x010  dd hdr
9B 05 10 00                               ; 0x014  dd file_end
9B 05 10 00                               ; 0x018  dd file_end
20 00 10 00                               ; 0x01C  dd start32

;; ----- start32 @ 0x020 -----

B8 00 10 00 50                            ; 0x020  mov eax, PML4  (PML4 = 0x50001000)
0F 22 D8                                  ; 0x025  mov cr3, eax
B8 20 06 00 00                            ; 0x028  mov eax, 0x620  ; PAE | OSFXSR | OSXMMEXCPT
0F 22 E0                                  ; 0x02D  mov cr4, eax
B9 80 00 00 C0                            ; 0x030  mov ecx, 0xC0000080  ; EFER: LME | SCE
0F 32                                     ; 0x035  rdmsr
0D 01 01 00 00                            ; 0x037  or eax, 0x101
0F 30                                     ; 0x03C  wrmsr
0F 20 C0                                  ; 0x03E  mov eax, cr0
0D 02 00 00 80                            ; 0x041  or eax, 0x80000002  ; PG | MP
0F 22 C0                                  ; 0x046  mov cr0, eax
0F 01 15 57 00 10 00                      ; 0x049  lgdt [gdt]  (gdt = 0x100057)
EA 67 00 10 00 08 00                      ; 0x050  jmp 8:start64  (start64 = 0x100067)

;; ----- gdt @ 0x057 -----
0F 00                                     ; 0x057  dw 15  ; the null descriptor holds the GDTR
57 00 10 00                               ; 0x059  dd gdt  (gdt = 0x100057)
00 00                                     ; 0x05D  dw 0
00 00 00 00 00 9A 20 00                   ; 0x05F  dq 0x00209A0000000000  ; 64-bit code

;; ----- start64 @ 0x067 -----

BD 80 00 00 50                            ; 0x067  mov ebp, BASE  (BASE = 0x50000080)
8D 65 80                                  ; 0x06C  lea esp, [rbp + G_FP]  (G_FP = -0x80)  ; kernel stack: below the image
B9 81 00 00 C0                            ; 0x06F  mov ecx, 0xC0000081  ; STAR: syscall CS 8, SS 16
31 C0                                     ; 0x074  xor eax, eax
BA 08 00 10 00                            ; 0x076  mov edx, 0x00100008
0F 30                                     ; 0x07B  wrmsr
FF C1                                     ; 0x07D  inc ecx  ; LSTAR
B8 98 00 10 00                            ; 0x07F  mov eax, syscall_entry  (syscall_entry = 0x100098)
99                                        ; 0x084  cdq
0F 30                                     ; 0x085  wrmsr
BF 10 30 00 50                            ; 0x087  mov edi, INIT + 16  (INIT = 0x50003000)
BE 00 30 00 50                            ; 0x08C  mov esi, INIT  (INIT = 0x50003000)
E8 36 04 00 00                            ; 0x091  call sys_execve  (rel32 = 0x4CC - 0x096; sys_execve = 0x1004CC)
EB 4E                                     ; 0x096  jmp ret_user  (rel8 = 0x0E6 - 0x098; ret_user = 0x1000E6)

;; ---- entry and exit -------------------------------------------------------

;; ----- syscall_entry @ 0x098 -----

48 89 24 25 A8 00 00 50                   ; 0x098  mov [abs BASE + U_RSP], rsp  (BASE = 0x50000080; U_RSP = 0x28)
BC A8 00 00 50                            ; 0x0A0  mov esp, BASE + U_RSP  (BASE = 0x50000080; U_RSP = 0x28)
50                                        ; 0x0A5  push rax
51                                        ; 0x0A6  push rcx
52                                        ; 0x0A7  push rdx
53                                        ; 0x0A8  push rbx
55                                        ; 0x0A9  push rbp
56                                        ; 0x0AA  push rsi
57                                        ; 0x0AB  push rdi
41 50                                     ; 0x0AC  push r8
41 51                                     ; 0x0AE  push r9
41 52                                     ; 0x0B0  push r10
41 53                                     ; 0x0B2  push r11
41 54                                     ; 0x0B4  push r12
41 55                                     ; 0x0B6  push r13
41 56                                     ; 0x0B8  push r14
41 57                                     ; 0x0BA  push r15
BD 80 00 00 50                            ; 0x0BC  mov ebp, BASE  (BASE = 0x50000080)
8D 65 80                                  ; 0x0C1  lea esp, [rbp + G_FP]  (G_FP = -0x80)
BB 0A 01 10 00                            ; 0x0C4  mov ebx, sctab  (sctab = 0x10010A)
;;   .find @ 0x0C9
38 03                                     ; 0x0C9  cmp [rbx], al
74 0D                                     ; 0x0CB  je .hit  (rel8 = 0x0DA - 0x0CD)
83 C3 03                                  ; 0x0CD  add ebx, 3
80 3B FF                                  ; 0x0D0  cmp byte [rbx], 0xFF
75 F4                                     ; 0x0D3  jne .find  (rel8 = 0x0C9 - 0x0D5)
6A DA                                     ; 0x0D5  push -38  ; ENOSYS
58                                        ; 0x0D7  pop rax
EB 0C                                     ; 0x0D8  jmp ret_user  (rel8 = 0x0E6 - 0x0DA; ret_user = 0x1000E6)
;;   .hit @ 0x0DA
0F B7 5B 01                               ; 0x0DA  movzx ebx, word [rbx + 1]
81 C3 44 01 10 00                         ; 0x0DE  add ebx, handlers  (handlers = 0x100144)
FF D3                                     ; 0x0E4  call rbx

;; ----- ret_user @ 0x0E6 -----

48 89 45 20                               ; 0x0E6  mov [rbp + U_RAX], rax  (U_RAX = 0x20)
8D 65 B0                                  ; 0x0EA  lea esp, [rbp + U]  (U = -0x50)
41 5F                                     ; 0x0ED  pop r15
41 5E                                     ; 0x0EF  pop r14
41 5D                                     ; 0x0F1  pop r13
41 5C                                     ; 0x0F3  pop r12
41 5B                                     ; 0x0F5  pop r11
41 5A                                     ; 0x0F7  pop r10
41 59                                     ; 0x0F9  pop r9
41 58                                     ; 0x0FB  pop r8
5F                                        ; 0x0FD  pop rdi
5E                                        ; 0x0FE  pop rsi
5D                                        ; 0x0FF  pop rbp
5B                                        ; 0x100  pop rbx
5A                                        ; 0x101  pop rdx
59                                        ; 0x102  pop rcx
58                                        ; 0x103  pop rax
41 53                                     ; 0x104  push r11
9D                                        ; 0x106  popfq
5C                                        ; 0x107  pop rsp
FF E1                                     ; 0x108  jmp rcx

;; ----- sctab @ 0x10A -----
00 06 01                                  ; 0x10A  syscall 0 -> sys_read (handlers + 0x106)
01 35 01                                  ; 0x10D  syscall 1 -> sys_write (handlers + 0x135)
02 A5 00                                  ; 0x110  syscall 2 -> sys_open (handlers + 0xA5)
03 F3 00                                  ; 0x113  syscall 3 -> sys_close (handlers + 0xF3)
06 C4 01                                  ; 0x116  syscall 6 -> sys_lstat (handlers + 0x1C4)
08 8F 01                                  ; 0x119  syscall 8 -> sys_lseek (handlers + 0x18F)
09 CB 02                                  ; 0x11C  syscall 9 -> sys_mmap (handlers + 0x2CB)
21 AF 01                                  ; 0x11F  syscall 33 -> sys_dup2 (handlers + 0x1AF)
39 E4 02                                  ; 0x122  syscall 57 -> sys_fork (handlers + 0x2E4)
3B 88 03                                  ; 0x125  syscall 59 -> sys_execve (handlers + 0x388)
3C 13 03                                  ; 0x128  syscall 60 -> sys_exit (handlers + 0x313)
3D 7F 03                                  ; 0x12B  syscall 61 -> sys_wait4 (handlers + 0x37F)
4F E7 01                                  ; 0x12E  syscall 79 -> sys_getcwd (handlers + 0x1E7)
50 FB 01                                  ; 0x131  syscall 80 -> sys_chdir (handlers + 0x1FB)
52 1E 02                                  ; 0x134  syscall 82 -> sys_rename (handlers + 0x21E)
53 44 02                                  ; 0x137  syscall 83 -> sys_mkdir (handlers + 0x244)
57 AF 02                                  ; 0x13A  syscall 87 -> sys_unlink (handlers + 0x2AF)
5A BC 02                                  ; 0x13D  syscall 90 -> ok (handlers + 0x2BC)
F8 54 02                                  ; 0x140  syscall 248 -> sys_disk (handlers + 0x254)
FF                                        ; 0x143  db 0xFF

;; ---- paths and the file table --------------------------------------------

;; ----- handlers @ 0x144 -----

;; rsi = path -> PB holds its canonical form, [G_PBLEN] its length.
;; The chain's paths never contain "..", an inner "//" or "/./", or a
;; trailing '/'; "./" and repeated '/' occur only as prefixes.

;; ----- canon @ 0x144 -----

BF 00 00 00 30                            ; 0x144  mov edi, PB  (PB = 0x30000000)
80 3E 2F                                  ; 0x149  cmp byte [rsi], '/'
74 1A                                     ; 0x14C  je .abs  (rel8 = 0x168 - 0x14E)
56                                        ; 0x14E  push rsi
8D B5 58 02 00 00                         ; 0x14F  lea esi, [rbp + P_CWD]  (P_CWD = 0x258)
8B 4D 30                                  ; 0x155  mov ecx, [rbp + P_CWDLEN]  (P_CWDLEN = 0x30)
F3 A4                                     ; 0x158  rep movsb
5E                                        ; 0x15A  pop rsi
81 FF 00 00 00 30                         ; 0x15B  cmp edi, PB  (PB = 0x30000000)
74 0C                                     ; 0x161  je .dots  (rel8 = 0x16F - 0x163)
B0 2F                                     ; 0x163  mov al, '/'
AA                                        ; 0x165  stosb
EB 07                                     ; 0x166  jmp .dots  (rel8 = 0x16F - 0x168)
;;   .abs @ 0x168
FF C6                                     ; 0x168  inc esi  ; ROOT "/" + "/x" gives "//x"
80 3E 2F                                  ; 0x16A  cmp byte [rsi], '/'
74 F9                                     ; 0x16D  je .abs  (rel8 = 0x168 - 0x16F)
;;   .dots @ 0x16F
66 81 3E 2E 2F                            ; 0x16F  cmp word [rsi], './'
75 04                                     ; 0x174  jne .copy  (rel8 = 0x17A - 0x176)
66 AD                                     ; 0x176  lodsw
EB F5                                     ; 0x178  jmp .dots  (rel8 = 0x16F - 0x17A)
;;   .copy @ 0x17A
AC                                        ; 0x17A  lodsb
AA                                        ; 0x17B  stosb
84 C0                                     ; 0x17C  test al, al
75 FA                                     ; 0x17E  jnz .copy  (rel8 = 0x17A - 0x180)
81 EF 01 00 00 30                         ; 0x180  sub edi, PB + 1  (PB = 0x30000000)
89 7D A8                                  ; 0x186  mov [rbp + G_PBLEN], edi  (G_PBLEN = -0x58)
C3                                        ; 0x189  ret

;; rdi = path -> rax = entry, or 0 with ZF set

;; ----- resolve @ 0x18A -----

89 FE                                     ; 0x18A  mov esi, edi
E8 B3 FF FF FF                            ; 0x18C  call canon  (rel32 = 0x144 - 0x191; canon = 0x100144)
8B 55 90                                  ; 0x191  mov edx, [rbp + G_END]  (G_END = -0x70)
;;   .l @ 0x194
83 EA 18                                  ; 0x194  sub edx, 24
81 FA 00 40 00 50                         ; 0x197  cmp edx, ENTS  (ENTS = 0x50004000)
72 1D                                     ; 0x19D  jb .no  (rel8 = 0x1BC - 0x19F)
80 7A 14 00                               ; 0x19F  cmp byte [rdx + E_TYPE], 0  (E_TYPE = 0x14)
74 EF                                     ; 0x1A3  je .l  (rel8 = 0x194 - 0x1A5)
8B 4D A8                                  ; 0x1A5  mov ecx, [rbp + G_PBLEN]  (G_PBLEN = -0x58)
3B 4A 04                                  ; 0x1A8  cmp ecx, [rdx + E_NLEN]  (E_NLEN = 0x4)
75 E7                                     ; 0x1AB  jne .l  (rel8 = 0x194 - 0x1AD)
8B 32                                     ; 0x1AD  mov esi, [rdx + E_NAME]  (E_NAME = 0x0)
BF 00 00 00 30                            ; 0x1AF  mov edi, PB  (PB = 0x30000000)
F3 A6                                     ; 0x1B4  repe cmpsb
75 DC                                     ; 0x1B6  jne .l  (rel8 = 0x194 - 0x1B8)
92                                        ; 0x1B8  xchg eax, edx
85 C0                                     ; 0x1B9  test eax, eax
C3                                        ; 0x1BB  ret
;;   .no @ 0x1BC
31 C0                                     ; 0x1BC  xor eax, eax
C3                                        ; 0x1BE  ret

;; bl = type -> rax = new entry named PB

;; ----- newent @ 0x1BF -----

8B 45 90                                  ; 0x1BF  mov eax, [rbp + G_END]  (G_END = -0x70)
83 45 90 18                               ; 0x1C2  add dword [rbp + G_END], 24  (G_END = -0x70)
88 58 14                                  ; 0x1C6  mov [rax + E_TYPE], bl  (E_TYPE = 0x14)
;; rax = entry; its name becomes a copy of PB

;; ----- setname @ 0x1C9 -----

8B 7D 98                                  ; 0x1C9  mov edi, [rbp + G_HEAP]  (G_HEAP = -0x68)
89 38                                     ; 0x1CC  mov [rax + E_NAME], edi  (E_NAME = 0x0)
8B 4D A8                                  ; 0x1CE  mov ecx, [rbp + G_PBLEN]  (G_PBLEN = -0x58)
89 48 04                                  ; 0x1D1  mov [rax + E_NLEN], ecx  (E_NLEN = 0x4)
BE 00 00 00 30                            ; 0x1D4  mov esi, PB  (PB = 0x30000000)
F3 A4                                     ; 0x1D9  rep movsb
89 7D 98                                  ; 0x1DB  mov [rbp + G_HEAP], edi  (G_HEAP = -0x68)
C3                                        ; 0x1DE  ret

;; rdi = fd -> rbx = slot, rax = entry; CF if closed

;; ----- fdp @ 0x1DF -----

8D 5C FD 58                               ; 0x1DF  lea ebx, [rbp + P_FDS + rdi*8]  (P_FDS = 0x58)
8B 03                                     ; 0x1E3  mov eax, [rbx]
83 F8 01                                  ; 0x1E5  cmp eax, 1
C3                                        ; 0x1E8  ret

;; ---- files ---------------------------------------------------------------

;; ----- sys_open @ 0x1E9 -----
;; rdi path, rsi flags
56                                        ; 0x1E9  push rsi
E8 9B FF FF FF                            ; 0x1EA  call resolve  (rel32 = 0x18A - 0x1EF; resolve = 0x10018A)
5E                                        ; 0x1EF  pop rsi
75 13                                     ; 0x1F0  jnz .have  (rel8 = 0x205 - 0x1F2)
0F BA E6 06                               ; 0x1F2  bt esi, 6  ; O_CREAT
0F 83 07 02 00 00                         ; 0x1F6  jnc enoent  (rel32 = 0x403 - 0x1FC; enoent = 0x100403)
B3 01                                     ; 0x1FC  mov bl, 1
E8 BC FF FF FF                            ; 0x1FE  call newent  (rel32 = 0x1BF - 0x203; newent = 0x1001BF)
EB 18                                     ; 0x203  jmp .fd  (rel8 = 0x21D - 0x205)
;;   .have @ 0x205
0F BA E6 07                               ; 0x205  bt esi, 7  ; O_EXCL
0F 82 FC 01 00 00                         ; 0x209  jc eexist  (rel32 = 0x40B - 0x20F; eexist = 0x10040B)
0F BA E6 09                               ; 0x20F  bt esi, 9  ; O_TRUNC: past size stays zero
73 08                                     ; 0x213  jnc .fd  (rel8 = 0x21D - 0x215)
83 60 0C 00                               ; 0x215  and dword [rax + E_SIZE], 0  (E_SIZE = 0xC)
83 60 10 00                               ; 0x219  and dword [rax + E_CAP], 0  (E_CAP = 0x10)
;;   .fd @ 0x21D
8D 5D 50                                  ; 0x21D  lea ebx, [rbp + P_FDS - 8]  (P_FDS = 0x58)
;;   .f @ 0x220
83 C3 08                                  ; 0x220  add ebx, 8
83 3B 00                                  ; 0x223  cmp dword [rbx], 0
75 F8                                     ; 0x226  jne .f  (rel8 = 0x220 - 0x228)
89 03                                     ; 0x228  mov [rbx], eax
83 63 04 00                               ; 0x22A  and dword [rbx + 4], 0
8D 43 A8                                  ; 0x22E  lea eax, [rbx - P_FDS]  (P_FDS = 0x58)
29 E8                                     ; 0x231  sub eax, ebp
C1 E8 03                                  ; 0x233  shr eax, 3
C3                                        ; 0x236  ret

;; ----- sys_close @ 0x237 -----

E8 A3 FF FF FF                            ; 0x237  call fdp  (rel32 = 0x1DF - 0x23C; fdp = 0x1001DF)
0F 82 C5 01 00 00                         ; 0x23C  jc ebadf  (rel32 = 0x407 - 0x242; ebadf = 0x100407)
83 23 00                                  ; 0x242  and dword [rbx], 0
E9 B6 01 00 00                            ; 0x245  jmp ok  (rel32 = 0x400 - 0x24A; ok = 0x100400)

;; ----- sys_read @ 0x24A -----
;; rdi fd, rsi buf, rdx count
E8 90 FF FF FF                            ; 0x24A  call fdp  (rel32 = 0x1DF - 0x24F; fdp = 0x1001DF)
0F 82 B2 01 00 00                         ; 0x24F  jc ebadf  (rel32 = 0x407 - 0x255; ebadf = 0x100407)
8B 48 0C                                  ; 0x255  mov ecx, [rax + E_SIZE]  (E_SIZE = 0xC)
2B 4B 04                                  ; 0x258  sub ecx, [rbx + 4]
0F 86 9F 01 00 00                         ; 0x25B  jbe ok  (rel32 = 0x400 - 0x261; ok = 0x100400)
48 39 D1                                  ; 0x261  cmp rcx, rdx
76 02                                     ; 0x264  jbe .n  (rel8 = 0x268 - 0x266)
89 D1                                     ; 0x266  mov ecx, edx
;;   .n @ 0x268
89 F7                                     ; 0x268  mov edi, esi
8B 70 08                                  ; 0x26A  mov esi, [rax + E_DATA]  (E_DATA = 0x8)
03 73 04                                  ; 0x26D  add esi, [rbx + 4]
01 4B 04                                  ; 0x270  add [rbx + 4], ecx
91                                        ; 0x273  xchg eax, ecx
89 C1                                     ; 0x274  mov ecx, eax
F3 A4                                     ; 0x276  rep movsb
C3                                        ; 0x278  ret

;; ----- sys_write @ 0x279 -----
;; rdi fd, rsi buf, rdx count
E8 61 FF FF FF                            ; 0x279  call fdp  (rel32 = 0x1DF - 0x27E; fdp = 0x1001DF)
0F 82 83 01 00 00                         ; 0x27E  jc ebadf  (rel32 = 0x407 - 0x284; ebadf = 0x100407)
89 D1                                     ; 0x284  mov ecx, edx
51                                        ; 0x286  push rcx
FF C8                                     ; 0x287  dec eax
75 0C                                     ; 0x289  jnz .file  (rel8 = 0x297 - 0x28B)
66 BA F8 03                               ; 0x28B  mov dx, 0x3F8
E3 04                                     ; 0x28F  jrcxz .wdone  (rel8 = 0x295 - 0x291)  ; a byte loop, not rep outsb: QEMU 8.2's
;;   .wout @ 0x291
AC                                        ; 0x291  lodsb  ; TCG aborts on K0's rep outsb
EE                                        ; 0x292  out dx, al
E2 FC                                     ; 0x293  loop .wout  (rel8 = 0x291 - 0x295)
;;   .wdone @ 0x295

58                                        ; 0x295  pop rax
C3                                        ; 0x296  ret
;;   .file @ 0x297
FF C0                                     ; 0x297  inc eax
8B 53 04                                  ; 0x299  mov edx, [rbx + 4]  ; pos
01 CA                                     ; 0x29C  add edx, ecx  ; end
3B 50 10                                  ; 0x29E  cmp edx, [rax + E_CAP]  (E_CAP = 0x10)
76 19                                     ; 0x2A1  jbe .fits  (rel8 = 0x2BC - 0x2A3)
