;; k0.hex0 -- K0, the bootstrap kernel: a Multiboot image for QEMU.
;;
;; A hex0 file is pairs of hex digits; everything from ';' or '#' to the end
;; of a line is a comment.  stage0-posix's hex0-seed turns this file into
;; k0.bin, which QEMU loads at 0x100000 (-kernel).
;;
;; How to read it.  Every line with bytes holds exactly one thing: a data
;; field or one machine instruction.  The first comment on the line is that
;; field or instruction in Intel syntax (NASM spelling: "byte [", "qword [");
;; a second ';' starts free prose.  kernel/k0/asm-check.py hands the first
;; comments to GNU as and to llvm-mc and requires both to write the bytes on
;; the left, so the comments cannot drift from the hex.  The notes in
;; parentheses are checked as well:
;;   (rel8 = 0xA - 0xB)   a branch: A is the target's file offset, B the
;;                        offset just past the instruction, A - B the
;;                        displacement in its last byte (rel32: last four)
;;   (name)               the number before it is the address of the
;;                        routine of that name: 0x100000 plus its offset
;; Headings give file offsets.  Lines of the form NAME = VALUE below define
;; the constants the instructions use.
;;
;; What it does.  K0 switches the CPU to 64-bit long mode and then runs
;; static Linux x86-64 programs, one at a time, in ring 0, over a file
;; system held in RAM.  It answers 19 Linux system calls and one of its own
;; (248: write a file to the IDE disk); every other number gets -38.  It has
;; no interrupts, no user mode, no memory protection and no messages.
;; kernel/k0/SPEC.md is the specification this file was written from.
;;
;; The boot image.  kernel/k0/mkfs.py writes an image that QEMU places at
;; 0x50000000 before K0 starts.  It is K0's initial state, used in place:
;;   +0x0000  the state page (below)
;;   +0x1000  page tables: 0 to 4 GiB mapped onto themselves
;;   +0x3000  the first program's argument vector, +0x3010 its path
;;   +0x4000  the file table: 24-byte entries, room for 16,384
;;   +0x64000 names and file contents; the file heap follows them
;;
;; Memory map:
;;   0x00100000  this file
;;   0x00200000  the running program's image; its break grows upward
;;   0x4F000000  the program's stack, 16 MiB, ending in the argument block
;;   0x50000000  the boot image, then the file heap, which grows upward
;;   0x80000000  the mmap area, which grows upward; fork snapshots are here
;;
;;   STATE = 0x50000000     the state page; rbx holds this in every handler
;;   TABLE = 0x50004000     the first file-table entry
;;   IMAGE = 0x200000       the lowest address a program is loaded at
;;   STACK = 0x4F000000     the lowest byte execve zeroes for the stack
;;   ARGS = 0x4FFF0000      the argument block: a new program's rsp
;;   STACKTOP = 0x50000000  the end of the stack area
;;
;; The state page, as offsets from STATE.  mkfs.py fills TABEND, HEAP, MMAP
;; and three descriptors; the rest starts as zero.
;;   STATUS = 0x00      wait status of the last child that exited
;;   PIDS = 0x08        the number of forks so far: the newest pid
;;   TABEND = 0x10      address just past the last file-table entry
;;   HEAP = 0x18        first free address of the file heap
;;   MMAP = 0x20        first free address of the mmap area
;;   LINK = 0x28        the snapshot of the suspended parent, 0 if none
;;   BRK = 0x30         the program break
;;   CHILD = 0x38       the pid fork gave its child
;;   ENTRY = 0x40       the entry address execve jumps through
;;   CWDLEN = 0x48      length of the working directory's name
;;   CWD = 0x50         the working directory's name and a 0 byte, 136 bytes
;;   FDS = 0xD8         16 descriptors of 8 bytes: target, then position
;;   REGS = 0xF88       the caller's saved registers, 15 quadwords
;;   USERRSP = 0xFF8    the last of them: the caller's rsp
;;   BLOCK = 0xFE0      bytes from MMAP to the end of the page
;; STATUS to HEAP belong to the whole run.  MMAP to the end of the page is
;; the state of one process: fork copies those BLOCK bytes into a snapshot
;; and exit copies them back.  K0's own stack is in the same page, growing
;; down from REGS, so it has about 3.5 KiB.
;;
;; A descriptor's target is 0 when it is not open, 1 for the console, and
;; otherwise the address of a file-table entry.
;;   POS = 4            a descriptor's position, after its target
;;
;; A file-table entry, six 32-bit fields:
;;   E_NAME = 0         address of the name, which has no terminator
;;   E_NLEN = 4         length of the name
;;   E_DATA = 8         address of the content
;;   E_SIZE = 12        size of the content
;;   E_CAP = 16         bytes allocated at E_DATA; those past E_SIZE are zero
;;   E_TYPE = 20        0 removed, 1 regular file, 2 directory
;; A name is a whole path without a leading '/', and the root's is empty.
;; Entries are only ever added at TABEND, and storage in the file heap is
;; never taken back.
;;
;; Every address K0 handles is below 4 GiB, so it keeps addresses in 32-bit
;; registers; writing one clears the upper half of the 64-bit register.

;; ===== bits 32: QEMU enters here in 32-bit protected mode =====

;; ----- multiboot @ 0x0 -----
;; The Multiboot 1 header.  Flag bit 16 says the five address fields are
;; present; QEMU needs them because this file is not an ELF.
;;   MAGIC = 0x1BADB002
;;   FLAGS = 0x00010000
02 B0 AD 1B                ; dd MAGIC
00 00 01 00                ; dd FLAGS
FE 4F 51 E4                ; dd 0 - MAGIC - FLAGS ; checksum: the three add up to 0
00 00 10 00                ; dd 0x100000 (multiboot) ; header_addr: where this header is loaded
00 00 10 00                ; dd 0x100000 (multiboot) ; load_addr: the file is loaded whole from here
FC 04 10 00                ; dd 0x100000 (multiboot) + end - multiboot ; load_end_addr
FC 04 10 00                ; dd 0x100000 (multiboot) + end - multiboot ; bss_end_addr: no bss
20 00 10 00                ; dd 0x100020 (start) ; entry_addr

;; ----- start @ 0x20 -----
;; Multiboot entry: 32-bit protected mode, paging off, interrupts off, no
;; stack.  Long mode needs page tables in CR3, CR4.PAE, EFER.LME and then
;; CR0.PG; the boot image brings the tables.  The syscall instruction needs
;; EFER.SCE, its target in LSTAR and its code selector in STAR.  The three
;; MSRs are numbered 0xC0000080 to 0xC0000082, so ecx steps between them.
B8 00 10 00 50             ; mov eax, STATE + 0x1000 ; the PML4 in the boot image
0F 22 D8                   ; mov cr3, eax
B8 20 06 00 00             ; mov eax, 0x620 ; PAE (bit 5); OSFXSR and OSXMMEXCPT (9, 10) let programs use SSE
0F 22 E0                   ; mov cr4, eax
B9 80 00 00 C0             ; mov ecx, 0xC0000080 ; EFER
0F 32                      ; rdmsr ; edx:eax = EFER; its upper half is zero
0D 01 01 00 00             ; or eax, 0x101 ; LME (bit 8): long mode; SCE (bit 0): syscall
0F 30                      ; wrmsr
41                         ; inc ecx
41                         ; inc ecx ; LSTAR
B8 90 00 10 00             ; mov eax, 0x100090 (syscall_entry) ; where syscall jumps; edx is still 0
0F 30                      ; wrmsr
49                         ; dec ecx ; STAR
31 C0                      ; xor eax, eax
B2 08                      ; mov dl, 8 ; bits 32 to 47: syscall loads cs = 8 and ss = 16
0F 30                      ; wrmsr
B8 13 00 00 80             ; mov eax, 0x80000013 ; PG, ET, MP and PE; EM clear, as SSE needs
0F 22 C0                   ; mov cr0, eax ; paging on: long mode is active, this code segment still 32-bit
0F 01 15 63 00 10 00       ; lgdt [0x100063 (gdt)]
FF 2D 7B 00 10 00          ; jmp fword ptr [0x10007B (far_pointer)] ; a far jump (as's spelling): cs = the 64-bit segment

;; ----- gdt @ 0x63 -----
;; Three descriptors.  The first is never used by the CPU, so it holds the
;; 6-byte operand of lgdt: the table's limit and its own address.
17 00                      ; dw 23 ; limit: 24 bytes
63 00 10 00                ; dd 0x100063 (gdt)
00 00                      ; dw 0
00 00 00 00 00 9A 20 00    ; dq 0x00209A0000000000 ; selector 8: ring 0 code, present, 64-bit
00 00 00 00 00 92 00 00    ; dq 0x0000920000000000 ; selector 16: ring 0 data, present, writable

;; ----- far_pointer @ 0x7B -----
81 00 10 00                ; dd 0x100081 (long_mode) ; offset
08 00                      ; dw 8 ; selector

;; ===== bits 64: long mode =====

;; ----- long_mode @ 0x81 -----
;; Start the first program as if a program had called execve with the path
;; and argument vector of the boot image: fall into the system call entry.
;; Nothing there depends on the junk in rsp, rcx and r11.
B8 3B 00 00 00             ; mov eax, 59 ; execve
BF 10 30 00 50             ; mov edi, STATE + 0x3010 ; the path
BE 00 30 00 50             ; mov esi, STATE + 0x3000 ; the argument vector

;; ----- syscall_entry @ 0x90 -----
;; The syscall instruction arrives here: rax = number, rdi, rsi, rdx =
;; arguments, rcx = return address, r11 = the caller's flags, rsp = the
;; caller's stack, which K0 must not write to.  Save rsp in its slot at the
;; top of the state page, then push the rest below it.  rax is the result
;; and is not saved.
48 89 24 25 F8 0F 00 50    ; mov qword [STATE + USERRSP], rsp
BC F8 0F 00 50             ; mov esp, STATE + USERRSP
51                         ; push rcx
41 53                      ; push r11
52                         ; push rdx
56                         ; push rsi
57                         ; push rdi
53                         ; push rbx
55                         ; push rbp
41 50                      ; push r8
41 51                      ; push r9
41 52                      ; push r10
41 54                      ; push r12
41 55                      ; push r13
41 56                      ; push r14
41 57                      ; push r15 ; rsp = STATE + REGS
FC                         ; cld ; string instructions go upward, whatever the caller left
;; Find the handler.  syscall_table has two bytes per call: the number, and
;; the distance from its handler to the next entry's, 0 in the last.
BD D4 04 10 00             ; mov ebp, 0x1004D4 (syscall_table)
B9 21 01 10 00             ; mov ecx, 0x100121 (sys_mkdir) ; the first entry's handler
;; .scan @ 0xBE
3A 45 00                   ; cmp al, [rbp] ; the low byte of the number decides
74 1E                      ; je call_handler (rel8 = 0xE1 - 0xC3)
0F B6 5D 01                ; movzx ebx, byte [rbp+1]
01 D9                      ; add ecx, ebx ; the next entry's handler
83 C5 02                   ; add ebp, 2
85 DB                      ; test ebx, ebx
75 EE                      ; jnz .scan (rel8 = 0xBE - 0xD0)

;; ----- enosys @ 0xD0 -----
;; The error results.  Each pushes its number for set_result.  Code at any
;; depth of calls may jump here: syscall_return resets the stack.
6A DA                      ; push -38 ; ENOSYS: no such call
EB 0A                      ; jmp set_result (rel8 = 0xDE - 0xD4)
;; ----- eexist @ 0xD4 -----
6A EF                      ; push -17 ; EEXIST: the name has an entry
EB 06                      ; jmp set_result (rel8 = 0xDE - 0xD8)
;; ----- ebadf @ 0xD8 -----
6A F7                      ; push -9 ; EBADF: the descriptor is not open
EB 02                      ; jmp set_result (rel8 = 0xDE - 0xDC)
;; ----- enoent @ 0xDC -----
6A FE                      ; push -2 ; ENOENT: no entry has the name
;; ----- set_result @ 0xDE -----
58                         ; pop rax
EB 07                      ; jmp syscall_return (rel8 = 0xE8 - 0xE1)

;; ----- call_handler @ 0xE1 -----
;; A handler gets rbx = STATE and the caller's rdi, rsi and rdx, and returns
;; the result in rax.  It may change any register.
BB 00 00 00 50             ; mov ebx, STATE
FF D1                      ; call rcx

;; ----- syscall_return @ 0xE8 -----
;; Back to the program with rax as the result: every other register as
;; saved, the flags from the saved r11, and a jump to the saved rcx.
BC 88 0F 00 50             ; mov esp, STATE + REGS ; drop whatever is left on K0's stack
41 5F                      ; pop r15
41 5E                      ; pop r14
41 5D                      ; pop r13
41 5C                      ; pop r12
41 5A                      ; pop r10
41 59                      ; pop r9
41 58                      ; pop r8
5D                         ; pop rbp
5B                         ; pop rbx
5F                         ; pop rdi
5E                         ; pop rsi
5A                         ; pop rdx
41 5B                      ; pop r11
41 53                      ; push r11 ; again, for the flags
9D                         ; popfq ; done here, on K0's stack; nothing below changes the flags
59                         ; pop rcx
5C                         ; pop rsp ; the caller's stack
FF E1                      ; jmp rcx

;; ----- getfd @ 0x109 -----
;; rdi = descriptor.  Returns rbp = its slot and eax = its target; if it is
;; not open the system call returns -9.
48 8D AC FB D8 00 00 00    ; lea rbp, [rbx+rdi*8+FDS]
8B 45 00                   ; mov eax, [rbp]
85 C0                      ; test eax, eax
74 C0                      ; jz ebadf (rel8 = 0xD8 - 0x118)
C3                         ; ret

;; ----- need @ 0x119 -----
;; find, for calls that fail without an entry: the system call returns -2.
E8 DF 00 00 00             ; call find (rel32 = 0x1FD - 0x11E)
75 BC                      ; jne enoent (rel8 = 0xDC - 0x120)
C3                         ; ret

;; ----- sys_mkdir @ 0x121 -----
;; 83 mkdir(path, mode): a directory is only an entry.
E8 D7 00 00 00             ; call find (rel32 = 0x1FD - 0x126)
74 AC                      ; je eexist (rel8 = 0xD4 - 0x128)
6A 02                      ; push 2
58                         ; pop rax ; type 2: directory
E8 31 01 00 00             ; call create (rel32 = 0x261 - 0x130)
31 C0                      ; xor eax, eax
C3                         ; ret

;; ----- sys_open @ 0x133 -----
;; 2 open(path, flags, mode).  Of the flags only O_CREAT (bit 6), O_EXCL
;; (bit 7) and O_TRUNC (bit 9) matter.  Every descriptor reads and writes.
56                         ; push rsi
E8 C4 00 00 00             ; call find (rel32 = 0x1FD - 0x139)
5E                         ; pop rsi ; the flags; pop leaves find's answer in ZF
75 13                      ; jne .absent (rel8 = 0x14F - 0x13C)
0F BA E6 07                ; bt esi, 7 ; O_EXCL, and the name exists
72 92                      ; jc eexist (rel8 = 0xD4 - 0x142)
0F BA E6 09                ; bt esi, 9 ; O_TRUNC
73 15                      ; jnc .descriptor (rel8 = 0x15D - 0x148)
48 83 65 0C 00             ; and qword [rbp+E_SIZE], 0 ; size and capacity 0: the old storage is left behind
EB 0E                      ; jmp .descriptor (rel8 = 0x15D - 0x14F)
;; .absent @ 0x14F
0F BA E6 06                ; bt esi, 6 ; O_CREAT
73 87                      ; jnc enoent (rel8 = 0xDC - 0x155)
6A 01                      ; push 1
58                         ; pop rax ; type 1: regular file
E8 04 01 00 00             ; call create (rel32 = 0x261 - 0x15D)
;; .descriptor @ 0x15D
31 C0                      ; xor eax, eax ; the lowest descriptor that is not open
;; .slot @ 0x15F
83 BC C3 D8 00 00 00 00    ; cmp dword [rbx+rax*8+FDS], 0
74 04                      ; je .free (rel8 = 0x16D - 0x169)
FF C0                      ; inc eax
EB F2                      ; jmp .slot (rel8 = 0x15F - 0x16D)
;; .free @ 0x16D
48 89 AC C3 D8 00 00 00    ; mov [rbx+rax*8+FDS], rbp ; target = the entry, and position = 0, in one store
C3                         ; ret

;; ----- sys_close @ 0x176 -----
;; 3 close(fd)
E8 8E FF FF FF             ; call getfd (rel32 = 0x109 - 0x17B)
83 65 00 00                ; and dword [rbp], 0 ; target 0: not open
EB 56                      ; jmp sys_chmod (rel8 = 0x1D7 - 0x181) ; return 0

;; ----- sys_unlink @ 0x181 -----
;; 87 unlink(path)
E8 93 FF FF FF             ; call need (rel32 = 0x119 - 0x186)
83 65 14 00                ; and dword [rbp+E_TYPE], 0 ; type 0: removed
EB 4B                      ; jmp sys_chmod (rel8 = 0x1D7 - 0x18C) ; return 0

;; ----- sys_lstat @ 0x18C -----
;; 6 lstat(path, buf): only st_mode, 16 bits at buf + 24, is stored: 0x81ED
;; for a file (type 1) and 0x41ED for a directory (type 2).
56                         ; push rsi
E8 87 FF FF FF             ; call need (rel32 = 0x119 - 0x192)
5E                         ; pop rsi
8B 45 14                   ; mov eax, [rbp+E_TYPE]
C1 E0 0E                   ; shl eax, 14 ; 0x4000 or 0x8000
66 35 ED C1                ; xor ax, 0xC1ED ; turns them into 0x81ED and 0x41ED
66 89 46 18                ; mov [rsi+24], ax
EB 34                      ; jmp sys_chmod (rel8 = 0x1D7 - 0x1A3) ; return 0

;; ----- sys_chdir @ 0x1A3 -----
;; 80 chdir(path): the name find built, with its 0, becomes the working
;; directory.
E8 71 FF FF FF             ; call need (rel32 = 0x119 - 0x1A8)
8B 73 18                   ; mov esi, [rbx+HEAP] ; the name
48 8D 7B 50                ; lea rdi, [rbx+CWD]
89 53 48                   ; mov [rbx+CWDLEN], edx
8D 4A 01                   ; lea ecx, [rdx+1]
F3 A4                      ; rep movsb
EB 1E                      ; jmp sys_chmod (rel8 = 0x1D7 - 0x1B9) ; return 0

;; ----- sys_rename @ 0x1B9 -----
;; 82 rename(old, new): an entry that already has the new name is removed,
;; unless it is the old entry itself; then the old entry takes the name.
56                         ; push rsi
E8 5A FF FF FF             ; call need (rel32 = 0x119 - 0x1BF)
5F                         ; pop rdi ; the new path
55                         ; push rbp
E8 37 00 00 00             ; call find (rel32 = 0x1FD - 0x1C6)
58                         ; pop rax ; the old entry
75 08                      ; jne .name (rel8 = 0x1D1 - 0x1C9)
39 C5                      ; cmp ebp, eax
74 0A                      ; je sys_chmod (rel8 = 0x1D7 - 0x1CD) ; renamed onto itself: return 0
83 65 14 00                ; and dword [rbp+E_TYPE], 0 ; remove the other entry
;; .name @ 0x1D1
95                         ; xchg eax, ebp ; rbp = the old entry
E8 91 00 00 00             ; call set_name (rel32 = 0x268 - 0x1D7)

;; ----- sys_chmod @ 0x1D7 -----
;; 90 chmod(path, mode) does nothing and returns 0.  The handlers above end
;; here to return 0.
31 C0                      ; xor eax, eax
C3                         ; ret

;; ----- sys_read @ 0x1DA -----
;; 0 read(fd, buf, count): up to count bytes from the position, 0 at or
;; past the end.
E8 2A FF FF FF             ; call getfd (rel32 = 0x109 - 0x1DF)
8B 48 0C                   ; mov ecx, [rax+E_SIZE]
8B 40 08                   ; mov eax, [rax+E_DATA]
89 F7                      ; mov edi, esi ; the buffer
8B 75 04                   ; mov esi, [rbp+POS]
29 F1                      ; sub ecx, esi ; bytes from the position to the end
76 E9                      ; jbe sys_chmod (rel8 = 0x1D7 - 0x1EE) ; none: return 0
01 C6                      ; add esi, eax ; the address to read from
39 D1                      ; cmp ecx, edx
0F 47 CA                   ; cmova ecx, edx ; no more than count
89 C8                      ; mov eax, ecx ; the result
01 4D 04                   ; add [rbp+POS], ecx
F3 A4                      ; rep movsb
C3                         ; ret

;; ----- find @ 0x1FD -----
;; rdi = path.  Builds the path's canonical name, with a 0 after it, at the
;; free end of the file heap, and looks for a live entry with that name.
;; Returns edx = the name's length, and either ZF set and rbp = the entry,
;; or ZF clear and rbp = TABEND, where a new entry would go.  A caller that
;; creates an entry keeps the name where it is by advancing HEAP (set_name).
;; The name: a path that starts with '/' loses all its leading '/'; any
;; other path gets the working directory's name and a '/' in front, unless
;; that name is empty.  Then any leading "./" of the path are dropped.
;; Nothing else is interpreted: ".." stays as it is.
89 FE                      ; mov esi, edi
8B 7B 18                   ; mov edi, [rbx+HEAP]
80 3E 2F                   ; cmp byte [rsi], 0x2F ; '/'
75 09                      ; jne .relative (rel8 = 0x210 - 0x207)
;; .slash @ 0x207
FF C6                      ; inc esi
80 3E 2F                   ; cmp byte [rsi], 0x2F
74 F9                      ; je .slash (rel8 = 0x207 - 0x20E)
EB 10                      ; jmp .dot (rel8 = 0x220 - 0x210)
;; .relative @ 0x210
56                         ; push rsi
48 8D 73 50                ; lea rsi, [rbx+CWD]
8B 4B 48                   ; mov ecx, [rbx+CWDLEN]
E3 05                      ; jrcxz .root (rel8 = 0x21F - 0x21A) ; at the root there is no prefix
F3 A4                      ; rep movsb
B0 2F                      ; mov al, 0x2F
AA                         ; stosb
;; .root @ 0x21F
5E                         ; pop rsi
;; .dot @ 0x220
66 81 3E 2E 2F             ; cmp word [rsi], 0x2F2E ; "./"
75 05                      ; jne .rest (rel8 = 0x22C - 0x227)
83 C6 02                   ; add esi, 2
EB F4                      ; jmp .dot (rel8 = 0x220 - 0x22C)
;; .rest @ 0x22C
AC                         ; lodsb
AA                         ; stosb
84 C0                      ; test al, al
75 FA                      ; jnz .rest (rel8 = 0x22C - 0x232) ; the 0 is copied too
8D 57 FF                   ; lea edx, [rdi-1]
2B 53 18                   ; sub edx, [rbx+HEAP] ; the length, without the 0
BD 00 40 00 50             ; mov ebp, TABLE
;; .entry @ 0x23D
3B 6B 10                   ; cmp ebp, [rbx+TABEND]
73 1C                      ; jae .none (rel8 = 0x25E - 0x242)
83 7D 14 00                ; cmp dword [rbp+E_TYPE], 0
74 11                      ; je .next (rel8 = 0x259 - 0x248) ; removed
39 55 04                   ; cmp [rbp+E_NLEN], edx
75 0C                      ; jne .next (rel8 = 0x259 - 0x24D)
8B 75 00                   ; mov esi, [rbp+E_NAME]
8B 7B 18                   ; mov edi, [rbx+HEAP]
89 D1                      ; mov ecx, edx
F3 A6                      ; repe cmpsb ; with length 0 this keeps the ZF of the length compare
74 07                      ; je .done (rel8 = 0x260 - 0x259)
;; .next @ 0x259
83 C5 18                   ; add ebp, 24
EB DF                      ; jmp .entry (rel8 = 0x23D - 0x25E)
;; .none @ 0x25E
85 ED                      ; test ebp, ebp ; rbp is not 0, so this clears ZF: not found
;; .done @ 0x260
C3                         ; ret

;; ----- create @ 0x261 -----
;; Add the entry find did not find: rbp = TABEND as find returned it, eax =
;; the type, edx = the length of the name find built.  The table's unused
;; part is zero, so the new entry has no content.  Falls into set_name.
83 43 10 18                ; add dword [rbx+TABEND], 24
89 45 14                   ; mov [rbp+E_TYPE], eax
;; ----- set_name @ 0x268 -----
;; The entry at rbp takes the name find built last, of length edx: the name
;; stays where it is, and HEAP moves past it.
8B 43 18                   ; mov eax, [rbx+HEAP]
89 45 00                   ; mov [rbp+E_NAME], eax
89 55 04                   ; mov [rbp+E_NLEN], edx
01 53 18                   ; add [rbx+HEAP], edx
C3                         ; ret

;; ----- sys_write @ 0x275 -----
;; 1 write(fd, buf, count).  A file keeps the bytes between its size and its
;; capacity zero, so a write past the end leaves a gap that reads as zero.
;; When the write ends past the capacity, the content moves to the free end
;; of the heap with a new capacity of the old one plus the write's end: at
;; least double what is needed, so a file written a byte at a time moves
;; only a few dozen times.
E8 8F FE FF FF             ; call getfd (rel32 = 0x109 - 0x27A)
52                         ; push rdx ; count, the result
89 D1                      ; mov ecx, edx
E3 44                      ; jrcxz .done (rel8 = 0x2C3 - 0x27F) ; nothing to write, nothing changes
83 F8 01                   ; cmp eax, 1
74 41                      ; je .console (rel8 = 0x2C5 - 0x284)
03 55 04                   ; add edx, [rbp+POS] ; edx = where the write ends
3B 50 10                   ; cmp edx, [rax+E_CAP]
76 22                      ; jbe .fits (rel8 = 0x2AE - 0x28C)
56                         ; push rsi
8B 70 08                   ; mov esi, [rax+E_DATA]
8B 48 0C                   ; mov ecx, [rax+E_SIZE]
8B 7B 18                   ; mov edi, [rbx+HEAP]
89 78 08                   ; mov [rax+E_DATA], edi ; the content's new place
F3 A4                      ; rep movsb ; move it
01 50 10                   ; add [rax+E_CAP], edx ; the new capacity
8B 48 10                   ; mov ecx, [rax+E_CAP]
2B 48 0C                   ; sub ecx, [rax+E_SIZE] ; the bytes from the size to the new capacity
50                         ; push rax
31 C0                      ; xor eax, eax
F3 AA                      ; rep stosb ; are zeroed, whatever the heap's free end held
58                         ; pop rax
89 7B 18                   ; mov [rbx+HEAP], edi ; the heap ends after them
5E                         ; pop rsi
;; .fits @ 0x2AE
8B 78 08                   ; mov edi, [rax+E_DATA]
03 7D 04                   ; add edi, [rbp+POS] ; the address to write to
59                         ; pop rcx
51                         ; push rcx ; count, still kept for the result
F3 A4                      ; rep movsb
89 55 04                   ; mov [rbp+POS], edx
3B 50 0C                   ; cmp edx, [rax+E_SIZE]
76 03                      ; jbe .done (rel8 = 0x2C3 - 0x2C0)
89 50 0C                   ; mov [rax+E_SIZE], edx ; the file grew
;; .done @ 0x2C3
58                         ; pop rax
C3                         ; ret
;; .console @ 0x2C5
;; Each byte goes to COM1's data port, one out per byte: QEMU's TCG does
;; not survive rep outsb here.
66 BA F8 03                ; mov dx, 0x3F8
;; .byte @ 0x2C9
AC                         ; lodsb
EE                         ; out dx, al
E2 FC                      ; loop .byte (rel8 = 0x2C9 - 0x2CD)
EB F4                      ; jmp .done (rel8 = 0x2C3 - 0x2CF)

;; ----- sys_lseek @ 0x2CF -----
;; 8 lseek(fd, offset, whence): offset is added to 0 (whence 0), to the
;; position (1) or to the size (2).
E8 35 FE FF FF             ; call getfd (rel32 = 0x109 - 0x2D4)
8B 48 0C                   ; mov ecx, [rax+E_SIZE]
FF CA                      ; dec edx
7F 07                      ; jg .move (rel8 = 0x2E2 - 0x2DB) ; whence 2
8B 4D 04                   ; mov ecx, [rbp+POS] ; mov keeps the flags of dec
74 02                      ; je .move (rel8 = 0x2E2 - 0x2E0) ; whence 1
31 C9                      ; xor ecx, ecx ; whence 0
;; .move @ 0x2E2
01 F1                      ; add ecx, esi
89 4D 04                   ; mov [rbp+POS], ecx
89 C8                      ; mov eax, ecx
C3                         ; ret

;; ----- sys_dup2 @ 0x2EA -----
;; 33 dup2(old, new): new gets a copy of old's target and position.
E8 1A FE FF FF             ; call getfd (rel32 = 0x109 - 0x2EF)
48 8B 45 00                ; mov rax, [rbp]
48 89 84 F3 D8 00 00 00    ; mov [rbx+rsi*8+FDS], rax
89 F0                      ; mov eax, esi
C3                         ; ret

;; ----- sys_getcwd @ 0x2FE -----
;; 79 getcwd(buf, size): '/', the name, a 0; returns the bytes stored.
B0 2F                      ; mov al, 0x2F
AA                         ; stosb
48 8D 73 50                ; lea rsi, [rbx+CWD]
8B 4B 48                   ; mov ecx, [rbx+CWDLEN]
8D 41 02                   ; lea eax, [rcx+2] ; the name, the '/' and the 0
FF C1                      ; inc ecx ; copy the 0 as well
F3 A4                      ; rep movsb
C3                         ; ret

;; ----- sys_mmap @ 0x310 -----
;; 9 mmap(addr, length, ...): length, rounded up to whole pages, from the
;; free end of the mmap area.  The area is given back when a forked child
;; exits and then used again, so the pages are zeroed here.
8B 7B 20                   ; mov edi, [rbx+MMAP]
57                         ; push rdi ; the result
8D 8E FF 0F 00 00          ; lea ecx, [rsi+4095]
81 E1 00 F0 FF FF          ; and ecx, -4096
31 C0                      ; xor eax, eax
F3 AA                      ; rep stosb
89 7B 20                   ; mov [rbx+MMAP], edi
58                         ; pop rax
C3                         ; ret

;; ----- sys_brk @ 0x329 -----
;; 12 brk(addr): an address above the break becomes the break, and the
;; memory between is zeroed.  Returns the break.
89 F9                      ; mov ecx, edi
8B 7B 30                   ; mov edi, [rbx+BRK]
29 F9                      ; sub ecx, edi ; how far above
76 07                      ; jbe .same (rel8 = 0x339 - 0x332) ; not above, or addr is 0
31 C0                      ; xor eax, eax
F3 AA                      ; rep stosb
89 7B 30                   ; mov [rbx+BRK], edi
;; .same @ 0x339
8B 43 30                   ; mov eax, [rbx+BRK]
C3                         ; ret

;; ----- sys_wait4 @ 0x33D -----
;; 61 wait4(pid, status, options, rusage): the child has already exited,
;; because fork runs it to its end before the parent continues.
8B 03                      ; mov eax, [rbx+STATUS]
89 06                      ; mov [rsi], eax
8B 43 38                   ; mov eax, [rbx+CHILD]
C3                         ; ret

;; ----- sys_fork @ 0x345 -----
;; 57 fork(): the caller goes on as the child, with result 0, and the
;; parent is put away until the child exits.  The parent is three areas,
;; copied one after another to the free end of the mmap area: its process
;; state with the saved registers (MMAP to the end of the state page), its
;; stack from 128 bytes below rsp (the red zone) to STACKTOP, and its image
;; from IMAGE to the break.  LINK then names the snapshot and MMAP moves
;; past it, so what the child maps lies above the parent's maps.  The
;; process state includes K0's own stack, in use while it is copied; that
;; is harmless, because exit uses nothing of the stack it copies back.
FF 43 08                   ; inc dword [rbx+PIDS]
8B 43 08                   ; mov eax, [rbx+PIDS]
89 43 38                   ; mov [rbx+CHILD], eax ; the child's pid: exit returns it from the snapshot
8B 7B 20                   ; mov edi, [rbx+MMAP]
57                         ; push rdi ; the snapshot's address
48 8D 73 20                ; lea rsi, [rbx+MMAP]
B9 E0 0F 00 00             ; mov ecx, BLOCK
F3 A4                      ; rep movsb ; the process state, with the parent's own LINK
48 8B B3 F8 0F 00 00       ; mov rsi, [rbx+USERRSP]
83 C6 80                   ; add esi, -128
B9 00 00 00 50             ; mov ecx, STACKTOP
29 F1                      ; sub ecx, esi
F3 A4                      ; rep movsb ; the stack
BE 00 00 20 00             ; mov esi, IMAGE
8B 4B 30                   ; mov ecx, [rbx+BRK]
29 F1                      ; sub ecx, esi
F3 A4                      ; rep movsb ; the image
8F 43 28                   ; pop qword [rbx+LINK] ; LINK = the snapshot's address, pushed above; its upper half is 0
81 C7 FF 0F 00 00          ; add edi, 4095
81 E7 00 F0 FF FF          ; and edi, -4096 ; the mmap area stays page-aligned
89 7B 20                   ; mov [rbx+MMAP], edi
31 C0                      ; xor eax, eax
C3                         ; ret

;; ----- sys_exit @ 0x391 -----
;; 60 exit(status).  With a parent put away: note the wait status, copy the
;; parent's three areas back in the order fork stored them, and return to
;; the parent from its fork with the child's pid.  The process state comes
;; first, because it holds the rsp and the break that say how long the
;; other two are.  It also holds MMAP as it was at the fork, which gives
;; back the snapshot and everything the child mapped, and the parent's own
;; LINK.  K0's own stack is overwritten with the first area; nothing on
;; it is needed, and syscall_return sets rsp itself.  Without a parent: the
;; status byte goes to the isa-debug-exit port, and QEMU ends.
8B 73 28                   ; mov esi, [rbx+LINK]
85 F6                      ; test esi, esi
74 3A                      ; jz .off (rel8 = 0x3D2 - 0x398)
C1 E7 18                   ; shl edi, 24
C1 EF 10                   ; shr edi, 16 ; the low byte of the status, in bits 8 to 15
89 3B                      ; mov [rbx+STATUS], edi
48 8D 7B 20                ; lea rdi, [rbx+MMAP]
B9 E0 0F 00 00             ; mov ecx, BLOCK
F3 A4                      ; rep movsb ; the process state
48 8B BB F8 0F 00 00       ; mov rdi, [rbx+USERRSP]
83 C7 80                   ; add edi, -128
B9 00 00 00 50             ; mov ecx, STACKTOP
29 F9                      ; sub ecx, edi
F3 A4                      ; rep movsb ; the stack
BF 00 00 20 00             ; mov edi, IMAGE
8B 4B 30                   ; mov ecx, [rbx+BRK]
29 F9                      ; sub ecx, edi
F3 A4                      ; rep movsb ; the image
8B 43 38                   ; mov eax, [rbx+CHILD]
E9 16 FD FF FF             ; jmp syscall_return (rel32 = 0xE8 - 0x3D2)
;; .off @ 0x3D2
97                         ; xchg eax, edi ; al = the low byte of the status
E6 F4                      ; out 0xF4, al ; QEMU exits with status * 2 + 1
;; .halt @ 0x3D5
F4                         ; hlt
EB FD                      ; jmp .halt (rel8 = 0x3D5 - 0x3D8)

;; ----- sys_execve @ 0x3D8 -----
;; 59 execve(path, argv, envp): replace the program.  envp is not read.
;; The argument strings may lie in the image or on the stack that are about
;; to be overwritten, so they are first copied to the free end of the file
;; heap, one after another; HEAP does not move, so they take no room.
56                         ; push rsi
E8 3B FD FF FF             ; call need (rel32 = 0x119 - 0x3DE) ; rbp = the program's entry, or the call returns -2
5E                         ; pop rsi ; argv
8B 7B 18                   ; mov edi, [rbx+HEAP]
31 D2                      ; xor edx, edx ; argc
;; .arg @ 0x3E4
48 AD                      ; lodsq ; the next pointer of argv
85 C0                      ; test eax, eax
74 0D                      ; jz .saved (rel8 = 0x3F7 - 0x3EA)
FF C2                      ; inc edx
56                         ; push rsi
96                         ; xchg esi, eax
;; .char @ 0x3EE
AC                         ; lodsb
AA                         ; stosb
84 C0                      ; test al, al
75 FA                      ; jnz .char (rel8 = 0x3EE - 0x3F4)
5E                         ; pop rsi
EB ED                      ; jmp .arg (rel8 = 0x3E4 - 0x3F7)
;; .saved @ 0x3F7
;; A fresh stack: all of it zero, as a program may read stack it never
;; wrote.  eax is 0 here.
52                         ; push rdx
BF 00 00 00 4F             ; mov edi, STACK
B9 00 00 00 01             ; mov ecx, STACKTOP - STACK
F3 AA                      ; rep stosb
;; Load the ELF file: e_phnum program headers of 56 bytes from offset 64,
;; each a segment: p_filesz bytes from p_offset go to p_vaddr, and zeros
;; follow up to p_memsz.  The last segment's end is the break.
8B 6D 08                   ; mov ebp, [rbp+E_DATA] ; the file
0F B7 4D 38                ; movzx ecx, word [rbp+56] ; e_phnum
51                         ; push rcx
48 8D 55 40                ; lea rdx, [rbp+64] ; the first program header
;; .segment @ 0x410
8B 72 08                   ; mov esi, [rdx+8] ; p_offset
01 EE                      ; add esi, ebp
8B 7A 10                   ; mov edi, [rdx+16] ; p_vaddr
8B 4A 20                   ; mov ecx, [rdx+32] ; p_filesz
F3 A4                      ; rep movsb
8B 4A 28                   ; mov ecx, [rdx+40] ; p_memsz
2B 4A 20                   ; sub ecx, [rdx+32]
F3 AA                      ; rep stosb ; eax is still 0
83 C2 38                   ; add edx, 56
FF 0C 24                   ; dec dword [rsp] ; the headers left
75 E3                      ; jnz .segment (rel8 = 0x410 - 0x42D)
59                         ; pop rcx
89 7B 30                   ; mov [rbx+BRK], edi
8B 45 18                   ; mov eax, [rbp+24] ; e_entry
48 89 43 40                ; mov [rbx+ENTRY], rax
;; The argument block at ARGS, as Linux lays it out: argc, the argc
;; pointers, a null pointer, the null pointer of an empty environment, two
;; zero quadwords for an empty auxiliary vector, and then the strings.  The
;; block is in the zeroed stack area, so only argc, the pointers and the
;; strings are written.
5A                         ; pop rdx ; argc
8B 73 18                   ; mov esi, [rbx+HEAP] ; the saved strings
BD 00 00 FF 4F             ; mov ebp, ARGS
8D 3C D5 28 00 FF 4F       ; lea edi, [rdx*8 + ARGS + 40] ; past argc, the pointers and four zero quadwords
48 89 55 00                ; mov [rbp], rdx
89 D1                      ; mov ecx, edx
E3 0F                      ; jrcxz .enter (rel8 = 0x45F - 0x450)
;; .pointer @ 0x450
83 C5 08                   ; add ebp, 8
48 89 7D 00                ; mov [rbp], rdi ; this argument's string starts here
;; .copy @ 0x457
AC                         ; lodsb
AA                         ; stosb
84 C0                      ; test al, al
75 FA                      ; jnz .copy (rel8 = 0x457 - 0x45D)
E2 F1                      ; loop .pointer (rel8 = 0x450 - 0x45F)
;; .enter @ 0x45F
;; The program starts with every register 0 and rsp = ARGS.  The stack
;; below ARGS is zero, so fifteen pops from 120 bytes below it clear the
;; registers and leave rsp at ARGS.  The jump goes through memory because
;; no register is left to hold the address.
BC 88 FF FE 4F             ; mov esp, ARGS - 120
58                         ; pop rax
59                         ; pop rcx
5A                         ; pop rdx
5B                         ; pop rbx
5D                         ; pop rbp
5E                         ; pop rsi
5F                         ; pop rdi
41 58                      ; pop r8
41 59                      ; pop r9
41 5A                      ; pop r10
41 5B                      ; pop r11
41 5C                      ; pop r12
41 5D                      ; pop r13
41 5E                      ; pop r14
41 5F                      ; pop r15
FF 24 25 40 00 00 50       ; jmp qword [STATE + ENTRY]

;; ----- sys_disk @ 0x482 -----
;; 248 (K0's own) disk(fd): write the file's whole 512-byte sectors to the
;; IDE primary master from sector 0 on, one WRITE SECTORS command (0x30,
;; PIO, 28-bit LBA) per sector.  Ports: 0x1F0 data, 0x1F2 sector count,
;; 0x1F3 to 0x1F5 the LBA's low three bytes, 0x1F6 drive and the LBA's top
;; bits, 0x1F7 command and status (bit 7 BSY, bit 3 DRQ).
E8 82 FC FF FF             ; call getfd (rel32 = 0x109 - 0x487)
8B 70 08                   ; mov esi, [rax+E_DATA]
8B 68 0C                   ; mov ebp, [rax+E_SIZE]
C1 ED 09                   ; shr ebp, 9 ; the number of whole sectors
31 FF                      ; xor edi, edi ; the sector to write next
;; .sector @ 0x492
39 EF                      ; cmp edi, ebp
73 3B                      ; jae .done (rel8 = 0x4D1 - 0x496)
BA F2 01 00 00             ; mov edx, 0x1F2
B0 01                      ; mov al, 1
EE                         ; out dx, al ; one sector
89 F8                      ; mov eax, edi
6A 03                      ; push 3
59                         ; pop rcx
;; .lba @ 0x4A3
FF C2                      ; inc edx
EE                         ; out dx, al ; 0x1F3, 0x1F4, 0x1F5: the sector number's low three bytes
C1 E8 08                   ; shr eax, 8
E2 F8                      ; loop .lba (rel8 = 0x4A3 - 0x4AB)
FF C2                      ; inc edx
0C E0                      ; or al, 0xE0
EE                         ; out dx, al ; 0x1F6: master, LBA mode, the number's top bits
FF C2                      ; inc edx
B0 30                      ; mov al, 0x30
EE                         ; out dx, al ; 0x1F7: WRITE SECTORS
;; .request @ 0x4B5
EC                         ; in al, dx
24 88                      ; and al, 0x88
3C 08                      ; cmp al, 8
75 F9                      ; jne .request (rel8 = 0x4B5 - 0x4BC) ; until not busy and asking for data
B2 F0                      ; mov dl, 0xF0 ; dx = 0x1F0
B5 01                      ; mov ch, 1 ; ecx was 0: now 256 words
;; .word @ 0x4C0
66 AD                      ; lodsw
66 EF                      ; out dx, ax ; one out per word, as for the console
E2 FA                      ; loop .word (rel8 = 0x4C0 - 0x4C6)
B2 F7                      ; mov dl, 0xF7 ; dx = 0x1F7
;; .busy @ 0x4C8
EC                         ; in al, dx
A8 80                      ; test al, 0x80
75 FB                      ; jnz .busy (rel8 = 0x4C8 - 0x4CD) ; until the drive has taken the sector
FF C7                      ; inc edi
EB C1                      ; jmp .sector (rel8 = 0x492 - 0x4D1)
;; .done @ 0x4D1
31 C0                      ; xor eax, eax
C3                         ; ret

;; ----- syscall_table @ 0x4D4 -----
;; For each call its number, and the distance from its handler to the
;; handler of the entry after it; the handlers are in this order above.
;; Read by the scan in syscall_entry, which starts at sys_mkdir.
53                         ; db 83
12                         ; db sys_open - sys_mkdir
02                         ; db 2
43                         ; db sys_close - sys_open
03                         ; db 3
0B                         ; db sys_unlink - sys_close
57                         ; db 87
0B                         ; db sys_lstat - sys_unlink
06                         ; db 6
17                         ; db sys_chdir - sys_lstat
50                         ; db 80
16                         ; db sys_rename - sys_chdir
52                         ; db 82
1E                         ; db sys_chmod - sys_rename
5A                         ; db 90
03                         ; db sys_read - sys_chmod
00                         ; db 0
9B                         ; db sys_write - sys_read
01                         ; db 1
5A                         ; db sys_lseek - sys_write
08                         ; db 8
1B                         ; db sys_dup2 - sys_lseek
21                         ; db 33
14                         ; db sys_getcwd - sys_dup2
4F                         ; db 79
12                         ; db sys_mmap - sys_getcwd
09                         ; db 9
19                         ; db sys_brk - sys_mmap
0C                         ; db 12
14                         ; db sys_wait4 - sys_brk
3D                         ; db 61
08                         ; db sys_fork - sys_wait4
39                         ; db 57
4C                         ; db sys_exit - sys_fork
3C                         ; db 60
47                         ; db sys_execve - sys_exit
3B                         ; db 59
AA                         ; db sys_disk - sys_execve
F8                         ; db 248
00                         ; db 0 ; the last entry
;; ----- end @ 0x4FC -----
