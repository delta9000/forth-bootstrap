;; The file open on fd rdi becomes the IDE primary master's first
;; size/512 sectors (the caller pads it to whole sectors), by LBA28 PIO
;; one sector at a time.  Boot 1 of the hex0 hand-off writes
;; builder-hex0's disk with it (tinycc/hex0-disk.c).

;; ----- sys_disk @ 0x39B -----

E8 42 FE FF FF                            ; 0x39B  call fdp  (rel32 = 0x1E2 - 0x3A0; fdp = 0x1001E2)
72 68                                     ; 0x3A0  jc ebadf  (rel8 = 0x40A - 0x3A2; ebadf = 0x10040A)
8B 70 08                                  ; 0x3A2  mov esi, [rax + E_DATA]  (E_DATA = 0x8)
8B 58 0C                                  ; 0x3A5  mov ebx, [rax + E_SIZE]  (E_SIZE = 0xC)
C1 EB 09                                  ; 0x3A8  shr ebx, 9  ; sectors
74 56                                     ; 0x3AB  jz ok  (rel8 = 0x403 - 0x3AD; ok = 0x100403)
31 FF                                     ; 0x3AD  xor edi, edi  ; LBA
;;   .sec @ 0x3AF
89 F8                                     ; 0x3AF  mov eax, edi
BA F3 01 00 00                            ; 0x3B1  mov edx, 0x1F3
EE                                        ; 0x3B6  out dx, al  ; LBA 0-7
FF C2                                     ; 0x3B7  inc edx
C1 E8 08                                  ; 0x3B9  shr eax, 8
EE                                        ; 0x3BC  out dx, al  ; 8-15
FF C2                                     ; 0x3BD  inc edx
C1 E8 08                                  ; 0x3BF  shr eax, 8
EE                                        ; 0x3C2  out dx, al  ; 16-23
FF C2                                     ; 0x3C3  inc edx
C1 E8 08                                  ; 0x3C5  shr eax, 8
0C E0                                     ; 0x3C8  or al, 0xE0
EE                                        ; 0x3CA  out dx, al  ; 0x1F6: master, LBA, 24-27
B2 F2                                     ; 0x3CB  mov dl, 0xF2
B0 01                                     ; 0x3CD  mov al, 1
EE                                        ; 0x3CF  out dx, al  ; one sector
B2 F7                                     ; 0x3D0  mov dl, 0xF7
B0 30                                     ; 0x3D2  mov al, 0x30
EE                                        ; 0x3D4  out dx, al  ; WRITE SECTORS
;;   .drq @ 0x3D5
EC                                        ; 0x3D5  in al, dx
A8 08                                     ; 0x3D6  test al, 8  ; DRQ: the drive takes the data
74 FB                                     ; 0x3D8  jz .drq  (rel8 = 0x3D5 - 0x3DA)
B2 F0                                     ; 0x3DA  mov dl, 0xF0
B9 00 01 00 00                            ; 0x3DC  mov ecx, 256
;;   .w @ 0x3E1
66 AD                                     ; 0x3E1  lodsw  ; a word loop, not rep outsw
66 EF                                     ; 0x3E3  out dx, ax  ; (see sys_write)
E2 FA                                     ; 0x3E5  loop .w  (rel8 = 0x3E1 - 0x3E7)
B2 F7                                     ; 0x3E7  mov dl, 0xF7
;;   .bsy @ 0x3E9
EC                                        ; 0x3E9  in al, dx
A8 80                                     ; 0x3EA  test al, 0x80  ; BSY: the sector is written
75 FB                                     ; 0x3EC  jnz .bsy  (rel8 = 0x3E9 - 0x3EE)
FF C7                                     ; 0x3EE  inc edi
FF CB                                     ; 0x3F0  dec ebx
75 BB                                     ; 0x3F2  jnz .sec  (rel8 = 0x3AF - 0x3F4)
EB 0D                                     ; 0x3F4  jmp ok  (rel8 = 0x403 - 0x3F6; ok = 0x100403)

