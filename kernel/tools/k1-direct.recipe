# K1 built from the seed by its own compiler, with no other compiler.
# kernel/tools/k1-direct-start.fth builds the runner and runs this recipe, on Linux
# or under K0.  Seed Forth compiles each K1 C file with the same layers,
# arena and driver words as seed-cc -nostdinc -c; kernel/tools/obj-asm.fth writes
# kernel/k1/k1-asm.fth (K1's assembly, as bytes) as an object; the Forth linker links them at
# 0x200000.  The seed is the only program that runs.  kernel/k1/boot/k0-syscalls.fth
# follows forth/010-lib.fth in every input: it stands in for the four calls K0 lacks.  Every layer is listed
# explicitly (sorted NNN-cc-*.fth without cc/120-cc-main.fth and
# cc/140-cc-link.fth, as cc/driver/seed-cc-start.fth selects them);
# kernel/k1/tests/direct-build-check.sh checks the list.
set K ${ROOT}/build-out/k1-direct
mkdir ${ROOT}/build-out
mkdir ${K}
text ${K}/empty ""
cat ${K}/compiler.fth ${ROOT}/forth/010-lib.fth ${ROOT}/kernel/k1/boot/k0-syscalls.fth ${ROOT}/cc/020-cc-arena.fth ${ROOT}/cc/030-cc-io.fth ${ROOT}/cc/040-cc-prep.fth ${ROOT}/cc/050-cc-lex.fth ${ROOT}/cc/060-cc-types.fth ${ROOT}/cc/070-cc-sym.fth ${ROOT}/cc/080-cc-elf.fth ${ROOT}/cc/081-cc-object.fth ${ROOT}/cc/090-cc-emit.fth ${ROOT}/cc/100-cc-expr.fth ${ROOT}/cc/110-cc-decl.fth ${ROOT}/cc/112-cc-stmt.fth ${ROOT}/cc/114-cc-func.fth ${ROOT}/cc/115-cc-native.fth ${ROOT}/cc/116-cc-prog.fth ${ROOT}/cc/117-cc-native-program.fth ${ROOT}/cc/118-cc-native-init.fth ${ROOT}/cc/119-cc-native-runtime.fth ${ROOT}/cc/121-cc-sysv.fth ${ROOT}/cc/122-cc-sysv-runtime.fth ${ROOT}/cc/123-cc-object-program.fth ${ROOT}/cc/124-cc-target.fth ${ROOT}/cc/125-cc-consteval.fth ${ROOT}/cc/126-cc-varargs.fth ${ROOT}/cc/127-cc-binary64.fth ${ROOT}/cc/128-cc-float-literal.fth ${ROOT}/cc/129-cc-bitfield.fth ${ROOT}/cc/131-cc-aggregate-abi.fth ${ROOT}/cc/132-cc-long-double.fth
cat ${K}/main.input ${K}/compiler.fth ${ROOT}/kernel/k1/boot/unit.fth ${ROOT}/kernel/k1/main.c
run 0 ${K}/main.input ${K}/main.out ${K}/main.err ${ROOT}/seed-forth
same ${K}/empty ${K}/main.out
rename ${K}/unit.o ${K}/main.o
cat ${K}/mm.input ${K}/compiler.fth ${ROOT}/kernel/k1/boot/unit.fth ${ROOT}/kernel/k1/mm.c
run 0 ${K}/mm.input ${K}/mm.out ${K}/mm.err ${ROOT}/seed-forth
same ${K}/empty ${K}/mm.out
rename ${K}/unit.o ${K}/mm.o
cat ${K}/fs.input ${K}/compiler.fth ${ROOT}/kernel/k1/boot/unit.fth ${ROOT}/kernel/k1/fs.c
run 0 ${K}/fs.input ${K}/fs.out ${K}/fs.err ${ROOT}/seed-forth
same ${K}/empty ${K}/fs.out
rename ${K}/unit.o ${K}/fs.o
cat ${K}/proc.input ${K}/compiler.fth ${ROOT}/kernel/k1/boot/unit.fth ${ROOT}/kernel/k1/proc.c
run 0 ${K}/proc.input ${K}/proc.out ${K}/proc.err ${ROOT}/seed-forth
same ${K}/empty ${K}/proc.out
rename ${K}/unit.o ${K}/proc.o
cat ${K}/sys.input ${K}/compiler.fth ${ROOT}/kernel/k1/boot/unit.fth ${ROOT}/kernel/k1/sys.c
run 0 ${K}/sys.input ${K}/sys.out ${K}/sys.err ${ROOT}/seed-forth
same ${K}/empty ${K}/sys.out
rename ${K}/unit.o ${K}/sys.o
cat ${K}/linux.input ${K}/compiler.fth ${ROOT}/kernel/k1/boot/unit.fth ${ROOT}/kernel/k1/linux.c
run 0 ${K}/linux.input ${K}/linux.out ${K}/linux.err ${ROOT}/seed-forth
same ${K}/empty ${K}/linux.out
rename ${K}/unit.o ${K}/linux.o
cat ${K}/ata.input ${K}/compiler.fth ${ROOT}/kernel/k1/boot/unit.fth ${ROOT}/kernel/k1/ata.c
run 0 ${K}/ata.input ${K}/ata.out ${K}/ata.err ${ROOT}/seed-forth
same ${K}/empty ${K}/ata.out
rename ${K}/unit.o ${K}/ata.o
cat ${K}/asm.input ${ROOT}/forth/010-lib.fth ${ROOT}/kernel/k1/boot/k0-syscalls.fth ${ROOT}/cc/020-cc-arena.fth ${ROOT}/cc/030-cc-io.fth ${ROOT}/cc/081-cc-object.fth ${ROOT}/kernel/tools/obj-asm.fth ${ROOT}/kernel/k1/k1-asm.fth ${ROOT}/kernel/k1/boot/asm.fth
run 0 ${K}/asm.input ${K}/asm.out ${K}/asm.err ${ROOT}/seed-forth
same ${K}/empty ${K}/asm.out
cat ${K}/link.input ${ROOT}/forth/010-lib.fth ${ROOT}/kernel/k1/boot/k0-syscalls.fth ${ROOT}/cc/020-cc-arena.fth ${ROOT}/cc/030-cc-io.fth ${ROOT}/cc/140-cc-link.fth ${ROOT}/kernel/k1/boot/link.fth
run 0 ${K}/link.input ${K}/link.out ${K}/link.err ${ROOT}/seed-forth
same ${K}/empty ${K}/link.out
chmod ${K}/k1
say "k1-direct: K1 built from the seed:"
hash ${K}/k1
