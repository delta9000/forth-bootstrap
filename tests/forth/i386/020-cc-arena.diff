< \ The seed's key reads stdin one byte per read syscall, and the compiler
< \ arrives through key: about 500 KB of Forth source on every run.  key-fill
< \ below is key with a 64 KiB buffer; native! sends the seed's key, which its
< \ reader calls directly, there too.  The C source that follows the Forth
< \ text on stdin is then partly in the buffer: key-drain hands it over to
< \ cc-read-all (030).
< 4096 constant key-buffer-size
< create key-buffer key-buffer-size allot
< variable key-pos
< variable key-len
< : movabs-rsi,  c{ 48 be } ,8 ;
< : movabs-rdx,  c{ 48 ba } ,8 ;
< ' key code: key-fill  here code-start !   \ ( -- c ), 0 at end of input
<   c{ 48 83 ed 08 }                                     \ sub rbp, 8
<   c{ 48 89 7d 00 }                                     \ mov [rbp], rdi
<   key-pos movabs-rsi,  c{ 48 8b 06 }                   \ mov rax, [rsi]
<   key-len movabs-rdx,  c{ 48 3b 02 }                   \ cmp rax, [rdx]
<   c{ 72 29 }                                           \ jb .have
<   c{ 31 c0 31 ff }                                     \ xor eax,eax  xor edi,edi
<   key-buffer movabs-rsi,                               \ read(0, buffer,
<   c{ ba } key-buffer-size ,4  c{ 0f 05 }               \ size): syscall
<   c{ 48 85 c0 }                                        \ test rax, rax
<   c{ 7e 2e }                                           \ jle .eof
<   key-len movabs-rdx,  c{ 48 89 02 }                   \ mov [rdx], rax
<   c{ 31 c0 }                                           \ xor eax, eax
<   key-buffer movabs-rsi,                               \ .have:
<   c{ 0f b6 3c 06 }                                     \ movzx edi, byte [rsi+rax]
<   c{ 48 ff c0 }                                        \ inc rax
<   key-pos movabs-rdx,  c{ 48 89 02 }                   \ mov [rdx], rax
<   ret,
<   c{ 31 ff } ret,                                      \ .eof: xor edi,edi
<   code-start @ native!
< \ key-drain ( buf cap -- n )  Move up to cap bytes that key-fill has read
< \ but not handed out to buf; answer how many.
< variable kd-buf
< variable kd-cap
< variable kd-n
< : key-drain
<   kd-cap ! kd-buf !  0 kd-n !
<   begin, kd-n @ kd-cap @ <  key-pos @ key-len @ <  and while,
<     key-buffer key-pos @ + c@  kd-buf @ kd-n @ + c!
<     1 key-pos +!  1 kd-n +!
<   repeat,
<   kd-n @ ;
---
> \ key-drain ( buf cap -- n )  Move the bytes a buffered key has read but
> \ not handed out to buf; answer how many.  The library's key keeps no
> \ buffer (file-key), so there are none.  cc-read-all (030) names this word
> \ in its branch for descriptor 0, which nothing reads on this host.
> : key-drain  2drop 0 ;
