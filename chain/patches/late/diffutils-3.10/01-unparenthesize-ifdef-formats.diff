# Drop the parentheses around a string-literal initializer, = ("..." "...");
# the string is the same.  tcc-0.9.27 rejects the parenthesized form; GCC
# accepts it, so this patch only keeps diffutils buildable by both.
--- a/src/diff.c
+++ b/src/diff.c
@@ -390,7 +390,7 @@
           specify_style (OUTPUT_IFDEF);
           {
 	    static char const C_ifdef_group_formats[]
-	      = (/* UNCHANGED */
+	      = /* UNCHANGED */
 		 "%="
 		 "\0"
 
@@ -411,7 +411,7 @@
 		 "%<"
 		 "#else /* @ */\n"
 		 "%>"
-		 "#endif /* @ */\n");
+		 "#endif /* @ */\n";
 
 	    size_t alloc = strlen (optarg);
 	    if (INT_MULTIPLY_WRAPV (alloc, 7, &alloc)
