# rejects the parenthesized form); GCC does not, but the late tools keep it so
# diffutils is built from the same source on both routes.
--- a/src/diff.c
+++ b/src/diff.c
@@ -390,7 +390,7 @@
           specify_style (OUTPUT_IFDEF);
           {
 	    static char const C_ifdef_group_formats[]
-	      = (/* UNCHANGED */
+	      = /* UNCHANGED */
 		 "%="
 		 "\0"
 
@@ -411,7 +411,7 @@
 		 "%<"
 		 "#else /* @ */\n"
 		 "%>"
-		 "#endif /* @ */\n");
+		 "#endif /* @ */\n";
 
