# libtcc.c reads its own version with sscanf(TCC_VERSION, ...) to define
# __TINYC__.  pnut's portable libc, which is compiled into the first tcc,
# has no sscanf: without this patch the Forth compiler stops with error 206
# (call to an undefined function).  The three numbers are written in.
#
# From pnut's kit/tcc-patches/0.9.26/sscanf_TCC_VERSION.before/.after
# (udem-dlteam/pnut abc34a5207b1373d0a4e3dcb3d3d6df6e22ae23d), with
# c = 27 changed to 26 so that __TINYC__ is 926, as TCC_VERSION "0.9.26"
# makes it in tcc-mes.  27 gives the same tcc-boot0 and every later file.
# The only patch this route makes to the fork; pnut's other six 0.9.26
# patches are not needed.  Only the first tcc's copy of the source has it:
# the boot stages compile live-bootstrap's tree as pass1.kaem leaves it.
--- a/libtcc.c
+++ b/libtcc.c
@@ -779,7 +779,8 @@
     {
         /* define __TINYC__ 92X  */
         char buffer[32]; int a,b,c;
-        sscanf(TCC_VERSION, "%d.%d.%d", &a, &b, &c);
+        // sscanf(TCC_VERSION, "%d.%d.%d", &a, &b, &c);
+        a = 0; b = 9; c = 26;
         sprintf(buffer, "%d", a*10000 + b*100 + c);
         tcc_define_symbol(s, "__TINYC__", buffer);
     }
