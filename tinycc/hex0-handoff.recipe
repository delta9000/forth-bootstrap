# Boot 1 of the hex0 hand-off: K0 runs seed Forth, seed Forth builds the
# recipe runner (kernel/tools/k1-direct-start.fth), and the runner runs this.
# tests/tinycc/hex0-handoff-check.sh puts it in K0's image under the name
# kernel/tools/k1-direct.recipe, the one the launcher runs.
#
# 1. seed Forth compiles the first tcc (tinycc/build-first-tcc.sh's inputs).
# 2. The first tcc, as /usr/bin/tcc-mes, runs the tcc-mes lines of
#    live-bootstrap's steps/tcc-0.9.26/pass1.kaem for ARCH=x86, translated
#    one for one into runner commands (catm is cat, mkdir is mkdir, and
#    "cd .." an absolute cd: K0 does not resolve ".."): mes
#    libc's crt1.o, crti.o, crtn.o, libc.a, libtcc1.a and libgetopt.a, and
#    tcc-boot0.  The tree is laid out at live-bootstrap's paths.
# 3. The first tcc builds the i386 kaem and the four mescc-tools-extra
#    programs boot 2's script runs (cp, chmod, match, rm), and the
#    exporter boot 2 ends with (tinycc/hex0-export.c), against that libc.
# 4. tinycc/hex0-disk.c writes builder-hex0's disk: its two stages, then
#    the stream of boot 2's files and commands, onto the drive.
# Every output is hashed onto the console.
text /tmp/empty ""

# ---- 1: the first tcc ----
cat /tmp/tcc.input /forth/010-lib.fth /cc/020-cc-arena.fth /cc/030-cc-io.fth /cc/040-cc-prep.fth /cc/050-cc-lex.fth /cc/060-cc-types.fth /cc/070-cc-sym.fth /cc/080-cc-elf.fth /cc/090-cc-emit.fth /cc/100-cc-expr.fth /cc/110-cc-decl.fth /cc/112-cc-stmt.fth /cc/115-cc-native.fth /cc/117-cc-native-program.fth /cc/118-cc-native-init.fth /cc/119-cc-native-runtime.fth /tinycc/tcc-compile.fth /build-out/tcc-sources/direct-input.c
run 0 /tmp/tcc.input /tmp/tcc.out - /seed-forth
same /tmp/empty /tmp/tcc.out
say "hex0-handoff: the first tcc, built by seed Forth under K0:"
hash /build-out/tinycc/tcc-first
copy /build-out/tinycc/tcc-first /usr/bin/tcc-mes
chmod /usr/bin/tcc-mes

# ---- 2: pass1.kaem's tcc-mes lines ----
cd /steps/tcc-0.9.26/build/tcc-0.9.26-1147-gee75a10c
run 0 - - - /usr/bin/tcc-mes -version
cd /steps/tcc-0.9.26/build/mes-0.28/lib
cat /tmp/unified-libc.0 ctype/isalnum.c ctype/isalpha.c ctype/isascii.c ctype/iscntrl.c ctype/isdigit.c ctype/isgraph.c ctype/islower.c ctype/isnumber.c ctype/isprint.c ctype/ispunct.c ctype/isspace.c ctype/isupper.c ctype/isxdigit.c ctype/tolower.c ctype/toupper.c dirent/closedir.c dirent/__getdirentries.c dirent/opendir.c linux/readdir.c linux/access.c linux/brk.c linux/chdir.c linux/chmod.c linux/clock_gettime.c linux/close.c linux/dup2.c linux/dup.c linux/execve.c linux/fcntl.c linux/fork.c linux/fsync.c linux/fstat.c linux/_getcwd.c linux/getdents.c linux/getegid.c linux/geteuid.c linux/getgid.c linux/getpid.c linux/getppid.c linux/getrusage.c linux/gettimeofday.c linux/getuid.c linux/ioctl.c linux/ioctl3.c linux/kill.c linux/link.c linux/lseek.c linux/lstat.c linux/malloc.c linux/mkdir.c linux/mknod.c linux/nanosleep.c linux/_open3.c linux/pipe.c linux/_read.c linux/readlink.c linux/rename.c linux/rmdir.c linux/setgid.c linux/settimer.c linux/setuid.c linux/signal.c linux/sigprogmask.c linux/symlink.c linux/stat.c linux/time.c linux/unlink.c linux/waitpid.c linux/wait4.c linux/x86-mes-gcc/_exit.c linux/x86-mes-gcc/syscall.c linux/x86-mes-gcc/_write.c math/ceil.c math/fabs.c math/floor.c mes/abtod.c mes/abtol.c mes/__assert_fail.c mes/assert_msg.c mes/__buffered_read.c mes/__init_io.c mes/cast.c mes/dtoab.c mes/eputc.c mes/eputs.c mes/fdgetc.c
cat /tmp/unified-libc.1 mes/fdgets.c mes/fdputc.c mes/fdputs.c mes/fdungetc.c mes/globals.c mes/itoa.c mes/ltoab.c mes/ltoa.c mes/__mes_debug.c mes/mes_open.c mes/ntoab.c mes/oputc.c mes/oputs.c mes/search-path.c mes/ultoa.c mes/utoa.c posix/alarm.c posix/buffered-read.c posix/execl.c posix/execlp.c posix/execv.c posix/execvp.c posix/getcwd.c posix/getenv.c posix/isatty.c posix/mktemp.c posix/open.c posix/pathconf.c posix/raise.c posix/sbrk.c posix/setenv.c posix/sleep.c posix/unsetenv.c posix/wait.c posix/write.c stdio/clearerr.c stdio/fclose.c stdio/fdopen.c stdio/feof.c stdio/ferror.c stdio/fflush.c stdio/fgetc.c stdio/fgets.c stdio/fileno.c stdio/fopen.c stdio/fprintf.c stdio/fputc.c stdio/fputs.c stdio/fread.c stdio/freopen.c stdio/fscanf.c stdio/fseek.c stdio/ftell.c stdio/fwrite.c stdio/getc.c stdio/getchar.c stdio/perror.c stdio/printf.c stdio/putc.c stdio/putchar.c stdio/remove.c stdio/snprintf.c stdio/sprintf.c stdio/sscanf.c stdio/ungetc.c stdio/vfprintf.c stdio/vfscanf.c stdio/vprintf.c stdio/vsnprintf.c stdio/vsprintf.c stdio/vsscanf.c stdlib/abort.c stdlib/abs.c stdlib/alloca.c stdlib/atexit.c stdlib/atof.c stdlib/atoi.c stdlib/atol.c stdlib/calloc.c stdlib/__exit.c stdlib/exit.c stdlib/free.c stdlib/mbstowcs.c stdlib/puts.c stdlib/qsort.c stdlib/realloc.c
cat /tmp/unified-libc.2 stdlib/strtod.c stdlib/strtof.c stdlib/strtol.c stdlib/strtold.c stdlib/strtoll.c stdlib/strtoul.c stdlib/strtoull.c string/bcmp.c string/bcopy.c string/bzero.c string/index.c string/memchr.c string/memcmp.c string/memcpy.c string/memmem.c string/memmove.c string/memset.c string/rindex.c string/strcat.c string/strchr.c string/strcmp.c string/strcpy.c string/strcspn.c string/strdup.c string/strerror.c string/strlen.c string/strlwr.c string/strncat.c string/strncmp.c string/strncpy.c string/strpbrk.c string/strrchr.c string/strspn.c string/strstr.c string/strupr.c stub/atan2.c stub/bsearch.c stub/chown.c stub/__cleanup.c stub/cos.c stub/ctime.c stub/exp.c stub/fpurge.c stub/freadahead.c stub/frexp.c stub/getgrgid.c stub/getgrnam.c stub/getlogin.c stub/getpgid.c stub/getpgrp.c stub/getpwnam.c stub/getpwuid.c stub/gmtime.c stub/ldexp.c stub/localtime.c stub/log.c stub/mktime.c stub/modf.c stub/mprotect.c stub/pclose.c stub/popen.c stub/pow.c stub/putenv.c stub/rand.c stub/realpath.c stub/rewind.c stub/setbuf.c stub/setgrent.c stub/setlocale.c stub/setvbuf.c stub/sigaction.c stub/sigaddset.c stub/sigblock.c stub/sigdelset.c stub/sigemptyset.c stub/sigsetmask.c stub/sin.c stub/sys_siglist.c stub/system.c stub/sqrt.c stub/strftime.c stub/times.c stub/ttyname.c stub/umask.c stub/utime.c x86-mes-gcc/setjmp.c
cat /steps/tcc-0.9.26/build/mes-0.28/unified-libc.c /tmp/unified-libc.0 /tmp/unified-libc.1 /tmp/unified-libc.2
cd /steps/tcc-0.9.26/build/mes-0.28
run 0 - - - /usr/bin/tcc-mes -c -D HAVE_CONFIG_H=1 -I include -I include/linux/x86 -o /usr/lib/mes/crt1.o lib/linux/x86-mes-gcc/crt1.c
text /usr/lib/mes/crtn.o ""
text /usr/lib/mes/crti.o ""
run 0 - - - /usr/bin/tcc-mes -c -D HAVE_CONFIG_H=1 -I include -I include/linux/x86 -o /usr/lib/mes/crtn.o lib/linux/x86-mes-gcc/crtn.c
run 0 - - - /usr/bin/tcc-mes -c -D HAVE_CONFIG_H=1 -I include -I include/linux/x86 -o /usr/lib/mes/crti.o lib/linux/x86-mes-gcc/crti.c
run 0 - - - /usr/bin/tcc-mes -c -D HAVE_CONFIG_H=1 -I include -I include/linux/x86 -o unified-libc.o unified-libc.c
run 0 - - - /usr/bin/tcc-mes -ar cr /usr/lib/mes/libc.a unified-libc.o
mkdir /usr/lib/mes/tcc
run 0 - - - /usr/bin/tcc-mes -c -D HAVE_CONFIG_H=1 -D HAVE_LONG_LONG=1 -D HAVE_FLOAT=1 -I include -I include/linux/x86 -o libtcc1.o lib/libtcc1.c
run 0 - - - /usr/bin/tcc-mes -ar cr /usr/lib/mes/tcc/libtcc1.a libtcc1.o
run 0 - - - /usr/bin/tcc-mes -c -D HAVE_CONFIG_H=1 -I include -I include/linux/x86 lib/posix/getopt.c
run 0 - - - /usr/bin/tcc-mes -ar cr /usr/lib/mes/libgetopt.a getopt.o
cd /steps/tcc-0.9.26/build/tcc-0.9.26-1147-gee75a10c
run 0 - - - /usr/bin/tcc-mes -g -v -static -o tcc-boot0 -D BOOTSTRAP=1 -D HAVE_FLOAT=1 -D HAVE_BITFIELD=1 -D HAVE_LONG_LONG=1 -D HAVE_SETJMP=1 -I . -I /usr/include/mes -D TCC_TARGET_I386=1 -D CONFIG_TCCDIR=\"/usr/lib/mes/tcc\" -D CONFIG_TCC_CRTPREFIX=\"/usr/lib/mes\" -D CONFIG_TCC_ELFINTERP=\"/mes/loader\" -D CONFIG_TCC_LIBPATHS=\"/usr/lib/mes:/usr/lib/mes/tcc\" -D CONFIG_TCC_SYSINCLUDEPATHS=\"/usr/include/mes\" -D TCC_LIBGCC=\"/usr/lib/mes/libc.a\" -D TCC_LIBTCC1=\"libtcc1.a\" -D CONFIG_TCCBOOT=1 -D CONFIG_TCC_STATIC=1 -D CONFIG_USE_LIBGCC=1 -D TCC_VERSION=\"0.9.26\" -D ONE_SOURCE=1 -L . -L /usr/lib/mes tcc.c
say "hex0-handoff: boot 1's hand-off files:"
hash /usr/bin/tcc-mes
hash /steps/tcc-0.9.26/build/tcc-0.9.26-1147-gee75a10c/tcc-boot0
hash /usr/lib/mes/crt1.o
hash /usr/lib/mes/crti.o
hash /usr/lib/mes/crtn.o
hash /usr/lib/mes/libc.a
hash /usr/lib/mes/tcc/libtcc1.a
hash /usr/lib/mes/libgetopt.a

# ---- 3: boot 2's i386 programs, by the first tcc against that libc ----
# kaem.h includes "../M2libc/bootstrappable.h" and K0 does not resolve
# "..": give the header the name tcc asks for.
copy /vendor/mescc-tools/M2libc/bootstrappable.h /vendor/mescc-tools/Kaem/../M2libc/bootstrappable.h
run 0 - - - /usr/bin/tcc-mes -static -L /usr/lib/mes -o /usr/bin/kaem /vendor/mescc-tools/Kaem/kaem.c /vendor/mescc-tools/Kaem/variable.c /vendor/mescc-tools/Kaem/kaem_globals.c /vendor/mescc-tools/M2libc/bootstrappable.c
run 0 - - - /usr/bin/tcc-mes -static -L /usr/lib/mes -o /usr/bin/cp /vendor/stage0-posix/mescc-tools-extra/cp.c /vendor/stage0-posix/mescc-tools-extra/M2libc/bootstrappable.c
run 0 - - - /usr/bin/tcc-mes -static -L /usr/lib/mes -o /usr/bin/chmod /vendor/stage0-posix/mescc-tools-extra/chmod.c /vendor/stage0-posix/mescc-tools-extra/M2libc/bootstrappable.c
run 0 - - - /usr/bin/tcc-mes -static -L /usr/lib/mes -o /usr/bin/match /vendor/stage0-posix/mescc-tools-extra/match.c /vendor/stage0-posix/mescc-tools-extra/M2libc/bootstrappable.c
run 0 - - - /usr/bin/tcc-mes -static -L /usr/lib/mes -o /usr/bin/rm /vendor/stage0-posix/mescc-tools-extra/rm.c /vendor/stage0-posix/mescc-tools-extra/M2libc/bootstrappable.c
run 0 - - - /usr/bin/tcc-mes -static -L /usr/lib/mes -o /usr/bin/hex0-export /tinycc/hex0-export.c
say "hex0-handoff: boot 2's programs:"
hash /usr/bin/kaem
hash /usr/bin/cp
hash /usr/bin/chmod
hash /usr/bin/match
hash /usr/bin/rm
hash /usr/bin/hex0-export

# ---- 4: builder-hex0's disk ----
# seed Forth compiles tinycc/hex0-disk.c as it compiles the runner
# (kernel/tools/k1-direct-start.fth); hex0-seed assembles builder-hex0's
# stage 1; hex0-disk writes the image and K0 copies it to the drive.
cat /tmp/disk.input /forth/010-lib.fth /cc/020-cc-arena.fth /cc/030-cc-io.fth /cc/040-cc-prep.fth /cc/050-cc-lex.fth /cc/060-cc-types.fth /cc/070-cc-sym.fth /cc/080-cc-elf.fth /cc/090-cc-emit.fth /cc/100-cc-expr.fth /cc/110-cc-decl.fth /cc/112-cc-stmt.fth /cc/114-cc-func.fth /cc/116-cc-prog.fth /kernel/tools/amd64-syscalls.fth /cc/120-cc-main.fth /tinycc/hex0-disk.c
run 0 /tmp/disk.input /tmp/disk.out - /seed-forth
same /tmp/empty /tmp/disk.out
copy /tmp/cc-out /build-out/hex0-disk
chmod /build-out/hex0-disk
run 0 - - - /vendor/stage0-posix/bootstrap-seeds/POSIX/AMD64/hex0-seed /build-out/tinycc-inputs/builder-hex0-a2781242d19e6be891b453d8fa827137ab5db31a/builder-hex0-x86-stage1.hex0 /tmp/stage1.bin
run 0 - - - /build-out/hex0-disk /tmp/hex0-disk.img /tmp/stage1.bin /build-out/tinycc-inputs/builder-hex0-a2781242d19e6be891b453d8fa827137ab5db31a/builder-hex0-x86-stage2.hex0 /build-out/tinycc/hex0-handoff/hex0-handoff.list
say "hex0-handoff: builder-hex0's disk written:"
hash /tmp/hex0-disk.img
